parameters:
  level: 8
  inferPrivatePropertyTypeFromConstructor: true
  stubFiles:
    - phpstan-stubs/laminas-feed-writer-feed.stub
  reportUnmatchedIgnoredErrors: false
  paths:
    - src
    - config
  excludePaths:
    analyse:
      - tests
    analyseAndScan:
      - tests
  ignoreErrors:
    - message: '#Trying to invoke#'
      path: config
    - message: '#Undefined variable: \$settings#'
      path: config
    - message: '#Offset .+ does not exist on array#'
      path: config
    # SettingsRepository's $schemaFetcher constructor parameter is kept
    # deliberately unused: the container autowires it and existing Feature
    # tests construct the repository positionally with it, even though
    # sectionKeys() now delegates to the static SettingsSections helper.
    - identifier: constructor.unusedParameter
      path: src/Domain/Settings/Repository/SettingsRepository.php
