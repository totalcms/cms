# Session Configuration
# Set session timeout to 24 hours (86400 seconds) for non-persistent logins
# Note: This matches config/defaults.php and can be overridden in tcms.php
# Users with "Keep me logged in" never timeout (handled separately by persistent tokens)
# php_value session.gc_maxlifetime 86400

# Redirect to front controller
RewriteEngine On

# Apache CGI/FastCGI strips the Authorization header before PHP sees it,
# which silently turns Bearer-authenticated API/MCP requests anonymous.
# Export it so PHP can restore it (AuthorizationHeaderMiddleware).
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Compute this directory's URL prefix dynamically (equivalent to RewriteBase,
# but with no hardcoded path). Some hosts cannot reverse-map relative rewrite
# substitutions in per-directory context (e.g. IONOS symlinked docroots), so
# rewrites there silently 404 without an explicit base.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=TCMS_BASE:%1]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ %{ENV:TCMS_BASE}index.php [QSA,L]

# Rules that can be added to .htaccess file in DOCUMENT_ROOT
# RewriteEngine On

