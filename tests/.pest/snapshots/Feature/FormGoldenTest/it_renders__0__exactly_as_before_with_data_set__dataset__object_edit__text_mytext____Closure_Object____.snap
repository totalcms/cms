<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'text';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'text';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  formgrid" data-schema="text" data-collection="text" data-method="POST" data-api="/api" data-route="/collections/text" data-id="mytext"><div class="form-field id-field " data-type="id" style="--grid-area: id;"><label for="field-UID">Text ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required readonly aria-describedby="help-UID" value="mytext" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">A unique ID for this text. No spaces or special characters.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: text;"><label for="field-UID">Text</label><div class="form-group"><textarea id="field-UID" name="text" rows="8" autocomplete="off" aria-describedby="help-UID" data-autosize style="--rows:8"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Edit the text here.</p></div><div class="form-inline-fields"></div></form></div>