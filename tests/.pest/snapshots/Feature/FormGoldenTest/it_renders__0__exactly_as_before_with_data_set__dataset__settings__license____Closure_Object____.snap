<form class="totalform help-on-hover help-box" data-method="POST" data-route="/admin/settings/license"><div class="form-field select-field " data-type="select" style="--grid-area: simulateEdition;"><label for="field-UID">Simulate Edition</label><div class="form-group"><select id="field-UID" name="simulateEdition" aria-describedby="help-UID"><option value="pro" selected>Pro</option><option value="standard">Standard</option><option value="lite">Lite</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Test how the CMS behaves with different license editions. Only available for development and trial licenses. Pro disables simulation and uses full features.</p></div><div class="form-inline-fields"><button type="submit" class="button btn cms-save cms-button">Save Settings</button></div></form>