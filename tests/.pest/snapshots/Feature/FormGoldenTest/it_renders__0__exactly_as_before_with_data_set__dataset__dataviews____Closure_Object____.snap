<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'name'
		'description'
		'dependencies'
		'viewDependencies'
		'definition'
		'section-header-1'
		'mcp'
		'section-divider-2'
		'lastBuilt'
		'lastError'
		'updated';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id .'
			'name name'
			'description description'
			'dependencies dependencies'
			'viewDependencies viewDependencies'
			'definition definition'
			'section-header-1  .'
			'mcp mcp'
			'section-divider-2  .'
			'lastBuilt .'
			'lastError lastError'
			'updated updated';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform dataview-form help-on-hover help-box no-unsaved-warning formgrid" data-schema="dataviews" data-collection="dataviews" data-method="POST" data-api="/api" data-route="/collections/dataviews"><h3 class="form-grid-section-header" style="grid-area: section-header-1;">MCP Server</h3><hr class="form-grid-section-divider" style="grid-area: section-divider-2;"/><div class="form-field id-field " data-type="id" style="--grid-area: id;" data-settings="{&quot;autogen&quot;:&quot;${name}&quot;}"><label for="field-UID">View ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div></div><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Name</label><div class="form-group"><input type="text" id="field-UID" name="name" required autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="description" rows="3" autocomplete="off"></textarea><div class="form-group-icon"></div></div></div><div class="form-field list-field " data-type="list" style="--grid-area: dependencies;" data-settings="{&quot;propertyOptions&quot;:&quot;collectionIds&quot;}"><label for="field-UID">Collection Dependencies</label><div class="form-group"><select id="field-UID" name="dependencies" multiple size="1" aria-describedby="help-UID"><option value="auth">Auth</option><option value="blog">Blog</option><option value="dataviews">Dataviews</option><option value="date">Date</option><option value="depot">Depot</option><option value="feed">Feed</option><option value="file">File</option><option value="gallery">Gallery</option><option value="image">Image</option><option value="mailer">Mailer</option><option value="text">Text</option><option value="toggle">Toggle</option><option value="video">Video</option><option value="widgets">Widgets</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Collections this view depends on. The view will rebuild when these change.</p></div><div class="form-field list-field " data-type="list" style="--grid-area: viewDependencies;" data-settings="{&quot;propertyOptions&quot;:&quot;viewIds&quot;}"><label for="field-UID">View Dependencies</label><div class="form-group"><select id="field-UID" name="viewDependencies" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Other Data Views this view reads via <code>cms.view.get()</code>. Listing them here guarantees this view rebuilds <em>after</em> those views, and inherits their collection dependencies — so you don't have to re-list the collections those views already depend on.</p></div><div class="form-field code-field " data-type="code" style="--grid-area: definition;" data-settings="{&quot;mode&quot;:&quot;twig&quot;,&quot;theme&quot;:&quot;elegant&quot;,&quot;rows&quot;:20,&quot;maxHeight&quot;:600,&quot;lineNumbers&quot;:true,&quot;lineWrapping&quot;:true,&quot;indentUnit&quot;:2,&quot;tabSize&quot;:2,&quot;foldGutter&quot;:true,&quot;matchBrackets&quot;:true,&quot;autoCloseTags&quot;:true}"><label for="field-UID">Twig Definition</label><div class="form-group"><textarea id="field-UID" name="definition" required rows="20" autocomplete="off" aria-describedby="help-UID" data-field-type="code" data-mode="twig" data-theme="elegant" data-max-height="600" data-editor-options="{&quot;autofocus&quot;:false,&quot;lineNumbers&quot;:true,&quot;lineWrapping&quot;:true,&quot;indentUnit&quot;:2,&quot;tabSize&quot;:2,&quot;foldGutter&quot;:true,&quot;matchBrackets&quot;:true,&quot;autoCloseTags&quot;:true,&quot;fullscreen&quot;:true}" class="code-editor-field"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Populate a <code>data</code> variable with the result you want stored.</p></div><div class="form-field card-field " data-type="card" style="--grid-area: mcp;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/mcp-collection.json&quot;}"><input id="field-UID" type="hidden" name="mcp" value="mcp" data-proxy="true"/><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'access'
		'searchProvider'
		'titleProperty'
		'description'
		'resource'
		'tools'
		'id';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'access'
			'searchProvider'
			'titleProperty'
			'description'
			'resource'
			'tools'
			'id';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid card-fields"><div class="form-field select-field " data-type="select" style="--grid-area: searchProvider;"><label for="field-UID">Search Provider Override</label><div class="form-group"><select id="field-UID" name="searchProvider" aria-describedby="help-UID"><option value="default" selected>Use site-wide default</option><option value="text">Text Search (built-in)</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Optional override of the site-wide search provider for this collection. <strong>Default</strong>: use the active provider from Settings → Search Providers. <strong>Text</strong>: force text search for this collection (good for SKU-heavy content where exact matches matter).</p></div><div class="form-field select-field " data-type="select" style="--grid-area: access;"><label for="field-UID">MCP Access</label><div class="form-group"><select id="field-UID" name="access" aria-describedby="help-UID"><option value class="placeholder" disabled>Admin only</option><option value="admin" selected>Admin only (API key required)</option><option value="authenticated">Authenticated (OAuth Bearer token with mcp:* scope)</option><option value="public">Public (anonymous AI agents can read)</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Controls who can call MCP content tools (query_collection, get_object, search_collection, describe_collection) against this collection. <strong>Admin</strong>: only callers with a valid API key. <strong>Authenticated</strong>: callers presenting an OAuth Bearer token with an <code>mcp:*</code> scope (Pro edition). <strong>Public</strong>: anonymous AI agents can read this collection.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">AI Description</label><div class="form-group"><textarea id="field-UID" name="description" rows="3" placeholder="e.g. Blog posts published on the site. Includes featured posts, drafts, and archived content." autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Description shown to AI agents in list_collections and tool descriptions. Falls back to the collection's general description if blank. Write for AI consumption — what is this collection, what kind of objects does it contain, what makes it distinct.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: titleProperty;" data-settings="{&quot;propertyOptions&quot;:&quot;schemaProperties&quot;,&quot;sortOptions&quot;:true}"><label for="field-UID">Title Property</label><div class="form-group"><select id="field-UID" name="titleProperty" aria-describedby="help-UID"><option value class="placeholder" disabled selected>Auto-detect (title, name, label…)</option><option value="definition">definition</option><option value="dependencies">dependencies</option><option value="description">description</option><option value="id">id</option><option value="lastBuilt">lastBuilt</option><option value="lastError">lastError</option><option value="mcp">mcp</option><option value="name">name</option><option value="updated">updated</option><option value="viewDependencies">viewDependencies</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Which property holds each object's human-readable title, shown to AI agents (e.g. in ChatGPT search results and citations). Leave blank to auto-detect: title, name, label, heading, headline, then the object id.</p></div><div class="form-field toggle-field " data-type="toggle" style="--grid-area: resource;"><label for="field-UID">Expose as MCP Resource</label><div class="form-group"><div class="switch"><input id="field-UID" name="resource" type="checkbox" aria-describedby="help-UID"/><label for="field-UID" aria-hidden="true">Expose as MCP Resource</label></div></div><p class="help" id="help-UID">When enabled, objects in this collection are addressable via <code>tcms://{collection}/{id}</code> URIs that AI clients can subscribe to.</p></div><div class="form-field deck-field " data-type="deck" style="--grid-area: tools;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/mcp-tool.json&quot;}"><label for="field-UID">Custom MCP Tools</label><div class="form-group"><input id="field-UID" type="text" name="tools" value="tools" data-proxy="true"/><template class="deck-template"><div class="deck-item deck-item-" data-deck-label-pattern="${id}"><button type="button" class="button btn deck-item-label sort-handle"></button><button type="button" class="button btn edit" title="Edit  item"></button><button type="button" class="button btn duplicate" title="Duplicate  item"></button><button type="button" class="button btn trash" title="Delete  item"></button><dialog class="cms-modal small"><section class="scroller"><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'id'
		'description'
		'section-header-1'
		'params'
		'filters'
		'section-header-2'
		'limit'
		'offset'
		'format'
		'sort'
		'include'
		'exclude';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'id id'
			'description description'
			'section-header-1  .'
			'params params'
			'filters filters'
			'section-header-2  .'
			'limit offset'
			'format format'
			'sort sort'
			'include include'
			'exclude exclude';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid"><h3 class="form-grid-section-header" style="grid-area: section-header-1;">Query</h3><h3 class="form-grid-section-header" style="grid-area: section-header-2;">Result Shape</h3><div class="form-field id-field " data-type="id" style="--grid-area: id;" data-settings="{&quot;snakeCase&quot;:true}"><label for="field-UID">Tool ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required aria-describedby="help-UID" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Snake_case identifier AI clients use to call this tool. Becomes the wire-level tool name when registered.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:2}"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="description" required rows="2" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">What this tool returns. Shown to AI agents in tools/list — write for AI consumption, not LLM instructions.</p></div><div class="form-field json-field " data-type="json" style="--grid-area: params;" data-settings="{&quot;rows&quot;:6}"><label for="field-UID">Params</label><div class="form-group"><textarea id="field-UID" name="params" rows="6" placeholder="{
	&quot;city&quot;: {
		&quot;type&quot;: &quot;string&quot;,
		&quot;description&quot;: &quot;City name.&quot;,
		&quot;required&quot;: true
	},
	&quot;max_price&quot;: {
		&quot;type&quot;: &quot;number&quot;,
		&quot;minimum&quot;: 0
	}
}" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Typed caller parameters as JSON. See <a href="docs/mcp/saved-query-tools">the docs</a> for the param shape.</p></div><div class="form-field json-field " data-type="json" style="--grid-area: filters;" data-settings="{&quot;rows&quot;:6}"><label for="field-UID">Filters</label><div class="form-group"><textarea id="field-UID" name="filters" rows="6" placeholder="{
	&quot;status&quot;: { &quot;value&quot;: &quot;active&quot; },
	&quot;city&quot;:   { &quot;operator&quot;: &quot;contains&quot;, &quot;value&quot;: &quot;{{params.city}}&quot; },
	&quot;price&quot;:  { &quot;operator&quot;: &quot;lte&quot;,      &quot;value&quot;: &quot;{{params.max_price}}&quot; }
}" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Field-name → {value, operator} map as JSON. Filter values may reference <code>{{params.X}}</code> placeholders.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: sort;"><label for="field-UID">Sort</label><div class="form-group"><input type="text" id="field-UID" name="sort" placeholder="date:desc" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">REST-style sort spec, e.g. <code>date:desc</code> or <code>priority:asc,date:desc</code>.</p></div><div class="form-field number-field " data-type="number" style="--grid-area: limit;"><label for="field-UID">Limit</label><div class="form-group"><input type="number" id="field-UID" name="limit" inputmode="numeric" aria-describedby="help-UID" value="20" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Max results per call. Capped at 50.</p></div><div class="form-field number-field " data-type="number" style="--grid-area: offset;"><label for="field-UID">Offset</label><div class="form-group"><input type="number" id="field-UID" name="offset" inputmode="numeric" aria-describedby="help-UID" value="0" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Skip the first N matching results.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: include;"><label for="field-UID">Include</label><div class="form-group"><input type="text" id="field-UID" name="include" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">REST-style include filter — escape hatch for shapes the structured filters object can't express.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: exclude;"><label for="field-UID">Exclude</label><div class="form-group"><input type="text" id="field-UID" name="exclude" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">REST-style exclude filter — escape hatch.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: format;"><label for="field-UID">Format</label><div class="form-group"><select id="field-UID" name="format" aria-describedby="help-UID"><option value="markdown" selected>Markdown</option><option value="html">HTML</option><option value="text">Plain text</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Output format for rich-text fields.</p></div></div></div></section><section><button type="button" class="button btn close">Close</button></section></dialog></div></template><button type="button" title="Add Item" class="button btn cms-add"></button></div><p class="help" id="help-UID">Saved-query tools exposed to AI agents. Add one per row; each is keyed by its id.</p></div></div></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: lastBuilt;" data-settings="{&quot;readonly&quot;:true}"><label for="field-UID">Last Built</label><div class="form-group"><input type="datetime-local" id="field-UID" name="lastBuilt" readonly autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field cms-hide" data-type="text" style="--grid-area: lastError;" data-settings="{&quot;hide&quot;:true}"><label for="field-UID">Last Error</label><div class="form-group"><input type="text" id="field-UID" name="lastError" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: updated;" data-settings="{&quot;onUpdate&quot;:true,&quot;readonly&quot;:true}"><label for="field-UID">Updated Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="updated" readonly aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Last modified date</p></div><div class="form-inline-fields"><button type="submit" class="button btn cms-save cms-button">Save</button><button type="button" class="button btn cms-delete cms-button">Delete</button></div></form></div>