yle="--grid-area: exif-copyright;"><label for="field-UID">Copyright</label><div class="form-group"><input type="text" id="field-UID" name="exif-copyright" placeholder="No Copyright Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: exif-description;"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="exif-description" rows="3" placeholder="No Description Found" autocomplete="off"></textarea><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>EXIF - Camera</summary><div class="content"><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-make;"><label for="field-UID">Make</label><div class="form-group"><input type="text" id="field-UID" name="exif-make" placeholder="Camera Make Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-camera;"><label for="field-UID">Model</label><div class="form-group"><input type="text" id="field-UID" name="exif-camera" placeholder="Camera Model Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-lens;"><label for="field-UID">Lens</label><div class="form-group"><input type="text" id="field-UID" name="exif-lens" placeholder="Lens Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-focalLength;"><label for="field-UID">Focal Length</label><div class="form-group"><input type="number" id="field-UID" name="exif-focalLength" inputmode="decimal" placeholder="Focal Length Not Found" step="0.1" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-aperture;"><label for="field-UID">Aperture</label><div class="form-group"><input type="number" id="field-UID" name="exif-aperture" inputmode="decimal" placeholder="Aperture Not Found" step="0.1" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-iso;"><label for="field-UID">ISO</label><div class="form-group"><input type="number" id="field-UID" name="exif-iso" inputmode="decimal" placeholder="ISO Not Found" step="0.1" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-shutter" data-type="text" style="--grid-area: exif-shutterSpeed;"><label for="field-UID">Shutter Speed</label><div class="form-group"><input type="text" id="field-UID" name="exif-shutterSpeed" placeholder="Shutter Speed Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>EXIF - Location</summary><div class="content"><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-country;"><label for="field-UID">Country</label><div class="form-group"><input type="text" id="field-UID" name="exif-country" placeholder="Country Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-state;"><label for="field-UID">State/Province</label><div class="form-group"><input type="text" id="field-UID" name="exif-state" placeholder="State or Province Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-city;"><label for="field-UID">City</label><div class="form-group"><input type="text" id="field-UID" name="exif-city" placeholder="City Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-sublocation;"><label for="field-UID">Sub-Location</label><div class="form-group"><input type="text" id="field-UID" name="exif-sublocation" placeholder="Sub-Location Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><hr/><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-longitude;"><label for="field-UID">Longitude</label><div class="form-group"><input type="text" id="field-UID" name="exif-longitude" placeholder="Longitude Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-latitude;"><label for="field-UID">Latitude</label><div class="form-group"><input type="text" id="field-UID" name="exif-latitude" placeholder="Latitude Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-altitude;"><label for="field-UID">Altitude</label><div class="form-group"><input type="text" id="field-UID" name="exif-altitude" placeholder="Altitude Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>Color Palette</summary><div class="content"><div class="palette"><div class="form-field color-field " data-type="color" style="--grid-area: palette-0;"><div class="form-group"><input id="field-UID" name="palette-0" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-1;"><div class="form-group"><input id="field-UID" name="palette-1" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-2;"><div class="form-group"><input id="field-UID" name="palette-2" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-3;"><div class="form-group"><input id="field-UID" name="palette-3" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-4;"><div class="form-group"><input id="field-UID" name="palette-4" type="color"/></div></div></div></div></details><details class="cms-accordion "><summary>Meta (Readonly)</summary><div class="content"><div class="form-field number-field " data-type="number" style="--grid-area: height;"><label for="field-UID">Height</label><div class="form-group"><input type="number" id="field-UID" name="height" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: width;"><label for="field-UID">Width</label><div class="form-group"><input type="number" id="field-UID" name="width" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: size;"><label for="field-UID">Size</label><div class="form-group"><input type="number" id="field-UID" name="size" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Filename</label><div class="form-group"><input type="text" id="field-UID" name="name" readonly autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: mime;"><label for="field-UID">MIME Type</label><div class="form-group"><input type="text" id="field-UID" name="mime" readonly autocomplete="nofill"/></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: uploadDate;"><label for="field-UID">Upload Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="uploadDate" readonly autocomplete="nofill"/></div></div></div></details></section><section><button type="button" class="button btn close">Close</button></section></dialog><dialog class="cms-modal image-link-dialog"><iframe style="width:100%;height:100%" data-src="/admin/imageworks?collection=feed&amp;property=image" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" class="cms-iframe "></iframe></dialog></div></template></div><p class="help" id="help-UID">Image for this post</p></div><div class="form-field styledtext-field " data-type="styledtext" style="--grid-area: content;"><label for="field-UID">Content</label><div class="form-group"><div class="styledtext-wrapper"><textarea id="field-UID" name="content" required rows="8" autocomplete="off" aria-describedby="help-UID"></textarea></div><div class="form-group-icon"></div></div><p class="help" id="help-UID">Post content</p></div><div class="form-inline-fields"></div></form></div>