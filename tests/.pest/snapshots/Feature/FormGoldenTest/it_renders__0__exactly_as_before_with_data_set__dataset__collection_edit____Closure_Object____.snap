<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'name'
		'id'
		'schema'
		'format'
		'description'
		'singleton'
		'queueRebuildOnSave'
		'section-header-1'
		'url'
		'prettyUrl'
		'section-header-2'
		'category'
		'labelPlural'
		'sortBy'
		'labelSingular'
		'reverseSort'
		'section-header-3'
		'publicOperations'
		'groups'
		'requireEmailVerification'
		'section-header-4'
		'seo'
		'section-header-5'
		'sitemap'
		'section-header-6'
		'mcp'
		'section-header-7'
		'formSettings'
		'manualSort'
		'properties'
		'customProperties'
		'section-divider-8'
		'totalObjects'
		'count'
		'lastUpdated'
		'updated';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'name name'
			'id id'
			'schema schema'
			'format format'
			'description description'
			'singleton .'
			'queueRebuildOnSave .'
			'section-header-1  .'
			'url url'
			'prettyUrl prettyUrl'
			'section-header-2  .'
			'category labelPlural'
			'sortBy labelSingular'
			'reverseSort reverseSort'
			'section-header-3  .'
			'publicOperations publicOperations'
			'groups groups'
			'requireEmailVerification requireEmailVerification'
			'section-header-4  .'
			'seo seo'
			'section-header-5  .'
			'sitemap sitemap'
			'section-header-6  .'
			'mcp mcp'
			'section-header-7  .'
			'formSettings formSettings'
			'manualSort manualSort'
			'properties properties'
			'customProperties customProperties'
			'section-divider-8  .'
			'totalObjects count'
			'lastUpdated lastUpdated'
			'updated updated';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  edit-mode formgrid" data-form="collection" data-schema="collection" data-method="PUT" data-api="/api" data-route="/collections/blog" data-id="blog" data-new-actions="[{&quot;action&quot;:&quot;redirect-object&quot;,&quot;link&quot;:&quot;?id=&quot;}]"><h3 class="form-grid-section-header" style="grid-area: section-header-1;">URL Setup</h3><h3 class="form-grid-section-header" style="grid-area: section-header-2;">Dashboard Setup</h3><h3 class="form-grid-section-header" style="grid-area: section-header-3;">Public Access</h3><h3 class="form-grid-section-header" style="grid-area: section-header-4;">SEO</h3><h3 class="form-grid-section-header" style="grid-area: section-header-5;">Sitemap</h3><h3 class="form-grid-section-header" style="grid-area: section-header-6;">MCP Server</h3><h3 class="form-grid-section-header" style="grid-area: section-header-7;">Overrides</h3><hr class="form-grid-section-divider" style="grid-area: section-divider-8;"/><div class="form-field id-field " data-type="id" style="--grid-area: id;" data-settings="{&quot;autogen&quot;:&quot;${name}&quot;}"><label for="field-UID">ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required readonly placeholder="myobjects" aria-describedby="help-UID" value="blog" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The unique identifier for this collection.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Name</label><div class="form-group"><input type="text" id="field-UID" name="name" placeholder="My Objects" aria-describedby="help-UID" value="Blog" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name of the collection.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: schema;" data-settings="{&quot;clearValue&quot;:false}"><label for="field-UID">Schema</label><div class="form-group"><select id="field-UID" name="schema" disabled readonly aria-describedby="help-UID"><option value class="placeholder" disabled>Select a Schema</option><optgroup label="Custom Schemas"><option value="widget-card">widget-card</option><option value="widgets">widgets</option></optgroup><optgroup label="Reserved Schemas"><option value="auth">auth</option><option value="automation-trigger">automation-trigger</option><option value="automations">automations</option><option value="blog-legacy">blog-legacy</option><option value="blog" selected>blog</option><option value="code">code</option><option value="color">color</option><option value="date">date</option><option value="dataviews">dataviews</option><option value="depot">depot</option><option value="email">email</option><option value="feed">feed</option><option value="file">file</option><option value="gallery">gallery</option><option value="image">image</option><option value="mailer">mailer</option><option value="mcp-collection">mcp-collection</option><option value="mcp-prompt">mcp-prompt</option><option value="mcp-prompt-arg">mcp-prompt-arg</option><option value="mcp-property">mcp-property</option><option value="mcp-tool">mcp-tool</option><option value="number">number</option><option value="builder-page">builder-page</option><option value="playground">playground</option><option value="preset-item">preset-item</option><option value="seo">seo</option><option value="seo-collection">seo-collection</option><option value="seo-site">seo-site</option><option value="sitemap-meta">sitemap-meta</option><option value="styledtext">styledtext</option><option value="svg">svg</option><option value="text">text</option><option value="toggle">toggle</option><option value="totalcms">totalcms</option><option value="totalcms-item">totalcms-item</option><option value="url">url</option><option value="video">video</option></optgroup></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name of the schema that the collection objects conform to</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="description" rows="3" placeholder="About your collection." autocomplete="off" aria-describedby="help-UID">A collection of blog objects that conform to the blog schema.</textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">A decription of the collection.</p></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: singleton;"><div class="form-group"><input id="field-UID" name="singleton" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Single Object Collection</label></div><p class="help" id="help-UID">This collection holds exactly one object. Clicking it opens that object directly for editing.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: format;" data-settings="{&quot;clearValue&quot;:false}"><label for="field-UID">Storage Format</label><div class="form-group"><select id="field-UID" name="format" disabled readonly aria-describedby="help-UID"><option value="json" selected>JSON</option><option value="markdown">Markdown</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Fixed after creation. Change it with `tcms collection:convert blog --to=markdown`.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: url;"><label for="field-UID">Object Path</label><div class="form-group"><input type="text" id="field-UID" name="url" placeholder="/objects/object.php" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The url path to objects stored in this collection.</p></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: prettyUrl;"><div class="form-group"><input id="field-UID" name="prettyUrl" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Pretty URLs</label></div><p class="help" id="help-UID">Use pretty URLs for linking building to objects in this collection.</p></div><div class="form-field list-field " data-type="list" style="--grid-area: groups;" data-settings="{&quot;accessGroupOptions&quot;:true,&quot;duplicateItemsAllowed&quot;:false,&quot;addChoices&quot;:false}"><label for="field-UID">File Access Groups</label><div class="form-group"><select id="field-UID" name="groups" multiple size="1" aria-describedby="help-UID"><option value="admin">admin</option><option value="blogger">blogger</option><option value="default">default</option><option value="editor">editor</option><option value="limited-blogger">limited-blogger</option><option value="viewer">viewer</option><option value="schema-editor">schema-editor</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Control who can download/stream this collection's protected files. Leave empty for public access. Add the 'default' group to allow any logged-in user, or pick specific groups to limit access to their members.</p></div><div class="form-field checklist-field styled-checkbox choice-field" data-type="checklist" style="--grid-area: publicOperations;--fieldset-grid-size:100px;" data-settings="{&quot;fieldGrid&quot;:&quot;100px&quot;,&quot;class&quot;:&quot;styled-checkbox&quot;,&quot;toggleAll&quot;:false}"><fieldset><legend>Allow unauthenticated users to perform these operations on this collection</legend><div class="checkbox"><input id="field-UID-1" name="publicOperations" type="checkbox" value="create" class="checkbox"/><label for="field-UID-1" class="checkbox-label">Create</label></div><div class="checkbox"><input id="field-UID-2" name="publicOperations" type="checkbox" value="read" class="checkbox"/><label for="field-UID-2" class="checkbox-label">Read</label></div><div class="checkbox"><input id="field-UID-3" name="publicOperations" type="checkbox" value="update" class="checkbox"/><label for="field-UID-3" class="checkbox-label">Update</label></div><div class="checkbox"><input id="field-UID-4" name="publicOperations" type="checkbox" value="delete" class="checkbox"/><label for="field-UID-4" class="checkbox-label">Delete</label></div></fieldset></div><div class="form-field text-field " data-type="text" style="--grid-area: category;" data-settings="{&quot;propertyOptions&quot;:&quot;collections&quot;}"><label for="field-UID">Category</label><div class="form-group"><input type="text" id="field-UID" name="category" aria-describedby="help-UID" list="datalist-UID" autocomplete="nofill"/><datalist id="datalist-UID"></datalist><div class="form-group-icon"></div></div><p class="help" id="help-UID">Add a category to organize the collections in the side panel</p></div><div class="form-field text-field " data-type="text" style="--grid-area: labelPlural;"><label for="field-UID">Plural Label</label><div class="form-group"><input type="text" id="field-UID" name="labelPlural" placeholder="Objects" aria-describedby="help-UID" value="Posts" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Custom plural term for collection items (e.g. 'Posts', 'Articles'). Defaults to 'Objects' if not set.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: labelSingular;"><label for="field-UID">Singular Label</label><div class="form-group"><input type="text" id="field-UID" name="labelSingular" placeholder="Object" aria-describedby="help-UID" value="Post" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Custom singular term for collection items (e.g. 'Post', 'Article'). Defaults to 'Object' if not set.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: sortBy;"><label for="field-UID">Sort By</label><div class="form-group"><select id="field-UID" name="sortBy" aria-describedby="help-UID"><option value class="placeholder" disabled>Select a Property</option><option value="draft">draft</option><option value="featured">featured</option><option value="id" selected>id</option><option value="title">title</option><option value="date">date</option><option value="author">author</option><option value="summary">summary</option><option value="media">media</option><option value="content">content</option><option value="extra">extra</option><option value="categories">categories</option><option value="tags">tags</option><option value="image">image</option><option value="gallery">gallery</option><option value="updated">updated</option><option value="created">created</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The default property to sort the collection by in the collection view.</p></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: reverseSort;"><div class="form-group"><input id="field-UID" name="reverseSort" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Reverse Sort</label></div><p class="help" id="help-UID">Sort in reverse order</p></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: queueRebuildOnSave;"><div class="form-group"><input id="field-UID" name="queueRebuildOnSave" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Queue Rebuild Index on Save</label></div><p class="help" id="help-UID">When enabled, saving objects will no longer trigger a rebuild of the index. This is useful for large collections.</p></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: requireEmailVerification;"><div class="form-group"><input id="field-UID" name="requireEmailVerification" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Require Email Verification</label></div><p class="help" id="help-UID">When a user registers via the public registration endpoint, create their account inactive and send a verification email. Only takes effect for collections listed in $config->auth['publicRegistration'].</p></div><div class="form-field number-field " data-type="number" style="--grid-area: count;" data-settings="{&quot;readonly&quot;:true}"><label for="field-UID">Total Objects Created</label><div class="form-group"><input type="number" id="field-UID" name="count" readonly inputmode="numeric" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Total number of objects that have been created in this collection.</p></div><div class="form-field number-field " data-type="number" style="--grid-area: totalObjects;" data-settings="{&quot;readonly&quot;:true}"><label for="field-UID">Current Object Count</label><div class="form-group"><input type="number" id="field-UID" name="totalObjects" readonly inputmode="numeric" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Current number of objects that have been created in this collection.</p></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: lastUpdated;" data-settings="{&quot;readonly&quot;:true}"><label for="field-UID">Content Updated</label><div class="form-group"><input type="datetime-local" id="field-UID" name="lastUpdated" readonly aria-describedby="help-UID" value="NOW" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">When content in this collection last changed — bumped by every object create, update, and delete. Says nothing about the collection's settings; see Settings Updated for that.</p></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: updated;" data-settings="{&quot;readonly&quot;:true}"><label for="field-UID">Settings Updated</label><div class="form-group"><input type="datetime-local" id="field-UID" name="updated" readonly aria-describedby="help-UID" value="NOW" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">When this collection's settings last changed (URL, MCP card, sitemap, access, schema overrides). Content changes never move it — sync uses it to tell which side has the newer configuration, and preserves it verbatim when settings arrive via sync.</p></div><div class="form-field json-field " data-type="json" style="--grid-area: formSettings;" data-settings="{&quot;rows&quot;:6}"><label for="field-UID">Object Form Settings</label><div class="form-group"><textarea id="field-UID" name="formSettings" rows="6" placeholder="{
	&quot;helpStyle&quot;: &quot;tooltip&quot;,
	&quot;newActions&quot;: [
		{&quot;action&quot;: &quot;mailer&quot;, &quot;mailerId&quot;: &quot;newobject-1234&quot;}
	]
}" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Custom settings for the object creation/edit forms. Available options: helpStyle, helpOnHover, helpOnFocus, newActions, editActions, deleteActions</p></div><div class="form-field json-field " data-type="json" style="--grid-area: manualSort;" data-settings="{&quot;rows&quot;:4}"><label for="field-UID">Manual Sort Orders</label><div class="form-group"><textarea id="field-UID" name="manualSort" rows="4" placeholder="{
	&quot;position&quot;: [&quot;ceo&quot;, &quot;cfo&quot;, &quot;cmo&quot;]
}" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Define custom sort orders by property name.</p></div><div class="form-field card-field " data-type="card" style="--grid-area: sitemap;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/sitemap-meta.json&quot;}"><input id="field-UID" type="hidden" name="sitemap" value="sitemap" data-proxy="true"/><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'enabled'
		'priority'
		'frequency'
		'date'
		'exclude'
		'include'
		'id';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'enabled .'
			'priority priority'
			'frequency date'
			'exclude include'
			'id id';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid card-fields"><div class="form-field toggle-field " data-type="toggle" style="--grid-area: enabled;"><label for="field-UID">Include in Sitemap</label><div class="form-group"><div class="switch"><input id="field-UID" name="enabled" type="checkbox" aria-describedby="help-UID"/><label for="field-UID" aria-hidden="true">Include in Sitemap</label></div></div><p class="help" id="help-UID">Generate a sitemap for this collection and list it in the sitemap index. When disabled, /sitemap/{collection} returns 404.</p></div><div class="form-field select-field  field-hidden" data-type="select" style="--grid-area: date; display: none;" data-settings="{&quot;propertyOptions&quot;:&quot;schemaProperties&quot;,&quot;sortOptions&quot;:true,&quot;visibility&quot;:{&quot;watch&quot;:&quot;enabled&quot;,&quot;value&quot;:&quot;1&quot;,&quot;operator&quot;:&quot;==&quot;}}"><label for="field-UID">Date Property</label><div class="form-group"><select id="field-UID" name="date" aria-describedby="help-UID"><option value class="placeholder" disabled>updated</option><option value="author">author</option><option value="categories">categories</option><option value="content">content</option><option value="created">created</option><option value="date">date</option><option value="draft">draft</option><option value="extra">extra</option><option value="featured">featured</option><option value="gallery">gallery</option><option value="id">id</option><option value="image">image</option><option value="media">media</option><option value="summary">summary</option><option value="tags">tags</option><option value="title">title</option><option value="updated" selected>updated</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Object property used for the lastmod timestamp. Choose any property from the collection's schema.</p></div><div class="form-field select-field  field-hidden" data-type="select" style="--grid-area: frequency; display: none;" data-settings="{&quot;visibility&quot;:{&quot;watch&quot;:&quot;enabled&quot;,&quot;value&quot;:&quot;1&quot;,&quot;operator&quot;:&quot;==&quot;}}"><label for="field-UID">Change Frequency</label><div class="form-group"><select id="field-UID" name="frequency" aria-describedby="help-UID"><option value class="placeholder" disabled selected>Not set</option><option value="always">always</option><option value="hourly">hourly</option><option value="daily">daily</option><option value="weekly">weekly</option><option value="monthly">monthly</option><option value="yearly">yearly</option><option value="never">never</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Hint to crawlers about how often objects change. Most search engines treat this as advisory.</p></div><div class="form-field range-field  field-hidden" data-type="range" style="--grid-area: priority; display: none;" data-settings="{&quot;min&quot;:0,&quot;max&quot;:1,&quot;step&quot;:0.1,&quot;visibility&quot;:{&quot;watch&quot;:&quot;enabled&quot;,&quot;value&quot;:&quot;1&quot;,&quot;operator&quot;:&quot;==&quot;}}"><label for="field-UID">Priority</label><div class="form-group"><input type="range" id="field-UID" name="priority" placeholder="0.5" aria-describedby="help-UID" value="0" min="0" max="1" step="0.1" autocomplete="nofill"/><div class="range-value" id="value-UID">0</div></div><p class="help" id="help-UID">Default crawl priority for objects in this collection (0.0 to 1.0). Leave at 0 to omit.</p></div><div class="form-field text-field  field-hidden" data-type="text" style="--grid-area: include; display: none;" data-settings="{&quot;visibility&quot;:{&quot;watch&quot;:&quot;enabled&quot;,&quot;value&quot;:&quot;1&quot;,&quot;operator&quot;:&quot;==&quot;}}"><label for="field-UID">Include Filter</label><div class="form-group"><input type="text" id="field-UID" name="include" placeholder="published:true" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Only include objects matching this filter expression. Example: published:true</p></div><div class="form-field text-field  field-hidden" data-type="text" style="--grid-area: exclude; display: none;" data-settings="{&quot;visibility&quot;:{&quot;watch&quot;:&quot;enabled&quot;,&quot;value&quot;:&quot;1&quot;,&quot;operator&quot;:&quot;==&quot;}}"><label for="field-UID">Exclude Filter</label><div class="form-group"><input type="text" id="field-UID" name="exclude" placeholder="draft:true" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Skip objects matching this filter expression. Example: draft:true</p></div></div></div></div><div class="form-field card-field " data-type="card" style="--grid-area: seo;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/seo-collection.json&quot;}"><input id="field-UID" type="hidden" name="seo" value="seo" data-proxy="true"/><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'title'
		'socialTitle'
		'description'
		'image'
		'type'
		'id';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'title socialTitle'
			'description image'
			'type .'
			'id id';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid card-fields"><div class="form-field select-field " data-type="select" style="--grid-area: type;"><label for="field-UID">Structured Data Type</label><div class="form-group"><select id="field-UID" name="type" aria-describedby="help-UID"><option value>Automatic</option><option value="website">Webpage</option><option value="article">Article</option><option value="blogposting">Blog post</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">What objects in this collection are, for og:type and the JSON-LD. Automatic uses the schema default: Blog post for blog and feed schemas, Web page otherwise.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: title;"><label for="field-UID">Title Template</label><div class="form-group"><input type="text" id="field-UID" name="title" placeholder="${title}" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Composes the title from the object's properties: ${title} | Reviews, ${name} — ${city}. ${site} is the site name. Leave empty to use the object's title. The object's own SEO Title wins.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: socialTitle;"><label for="field-UID">Social Title Template</label><div class="form-group"><input type="text" id="field-UID" name="socialTitle" placeholder="${title}" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Composes og:title and twitter:title from the object's properties, independent of the Title Template. Leave empty to use the title. The object's own Social Title wins.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: description;" data-settings="{&quot;propertyOptions&quot;:&quot;schemaProperties&quot;,&quot;sortOptions&quot;:true}"><label for="field-UID">Description Property</label><div class="form-group"><select id="field-UID" name="description" aria-describedby="help-UID"><option value class="placeholder" disabled selected>Select a Property</option><option value="author">author</option><option value="categories">categories</option><option value="content">content</option><option value="created">created</option><option value="date">date</option><option value="draft">draft</option><option value="extra">extra</option><option value="featured">featured</option><option value="gallery">gallery</option><option value="id">id</option><option value="image">image</option><option value="media">media</option><option value="summary">summary</option><option value="tags">tags</option><option value="title">title</option><option value="updated">updated</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Which property supplies the meta description when the object has no SEO description</p></div><div class="form-field select-field " data-type="select" style="--grid-area: image;" data-settings="{&quot;propertyOptions&quot;:&quot;schemaProperties&quot;,&quot;sortOptions&quot;:true}"><label for="field-UID">Image Property</label><div class="form-group"><select id="field-UID" name="image" aria-describedby="help-UID"><option value class="placeholder" disabled selected>Select a Property</option><option value="author">author</option><option value="categories">categories</option><option value="content">content</option><option value="created">created</option><option value="date">date</option><option value="draft">draft</option><option value="extra">extra</option><option value="featured">featured</option><option value="gallery">gallery</option><option value="id">id</option><option value="image">image</option><option value="media">media</option><option value="summary">summary</option><option value="tags">tags</option><option value="title">title</option><option value="updated">updated</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Which image property supplies the social image</p></div></div></div></div><div class="form-field card-field " data-type="card" style="--grid-area: mcp;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/mcp-collection.json&quot;}"><input id="field-UID" type="hidden" name="mcp" value="mcp" data-proxy="true"/><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'access'
		'searchProvider'
		'titleProperty'
		'description'
		'resource'
		'tools'
		'id';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'access'
			'searchProvider'
			'titleProperty'
			'description'
			'resource'
			'tools'
			'id';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid card-fields"><div class="form-field select-field " data-type="select" style="--grid-area: searchProvider;"><label for="field-UID">Search Provider Override</label><div class="form-group"><select id="field-UID" name="searchProvider" aria-describedby="help-UID"><option value="default" selected>Use site-wide default</option><option value="text">Text Search (built-in)</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Optional override of the site-wide search provider for this collection. <strong>Default</strong>: use the active provider from Settings → Search Providers. <strong>Text</strong>: force text search for this collection (good for SKU-heavy content where exact matches matter).</p></div><div class="form-field select-field " data-type="select" style="--grid-area: access;"><label for="field-UID">MCP Access</label><div class="form-group"><select id="field-UID" name="access" aria-describedby="help-UID"><option value class="placeholder" disabled>Admin only</option><option value="admin" selected>Admin only (API key required)</option><option value="authenticated">Authenticated (OAuth Bearer token with mcp:* scope)</option><option value="public">Public (anonymous AI agents can read)</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Controls who can call MCP content tools (query_collection, get_object, search_collection, describe_collection) against this collection. <strong>Admin</strong>: only callers with a valid API key. <strong>Authenticated</strong>: callers presenting an OAuth Bearer token with an <code>mcp:*</code> scope (Pro edition). <strong>Public</strong>: anonymous AI agents can read this collection.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">AI Description</label><div class="form-group"><textarea id="field-UID" name="description" rows="3" placeholder="e.g. Blog posts published on the site. Includes featured posts, drafts, and archived content." autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Description shown to AI agents in list_collections and tool descriptions. Falls back to the collection's general description if blank. Write for AI consumption — what is this collection, what kind of objects does it contain, what makes it distinct.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: titleProperty;" data-settings="{&quot;propertyOptions&quot;:&quot;schemaProperties&quot;,&quot;sortOptions&quot;:true}"><label for="field-UID">Title Property</label><div class="form-group"><select id="field-UID" name="titleProperty" aria-describedby="help-UID"><option value class="placeholder" disabled selected>Auto-detect (title, name, label…)</option><option value="author">author</option><option value="categories">categories</option><option value="content">content</option><option value="created">created</option><option value="date">date</option><option value="draft">draft</option><option value="extra">extra</option><option value="featured">featured</option><option value="gallery">gallery</option><option value="id">id</option><option value="image">image</option><option value="media">media</option><option value="summary">summary</option><option value="tags">tags</option><option value="title">title</option><option value="updated">updated</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Which property holds each object's human-readable title, shown to AI agents (e.g. in ChatGPT search results and citations). Leave blank to auto-detect: title, name, label, heading, headline, then the object id.</p></div><div class="form-field toggle-field " data-type="toggle" style="--grid-area: resource;"><label for="field-UID">Expose as MCP Resource</label><div class="form-group"><div class="switch"><input id="field-UID" name="resource" type="checkbox" aria-describedby="help-UID"/><label for="field-UID" aria-hidden="true">Expose as MCP Resource</label></div></div><p class="help" id="help-UID">When enabled, objects in this collection are addressable via <code>tcms://{collection}/{id}</code> URIs that AI clients can subscribe to.</p></div><div class="form-field deck-field " data-type="deck" style="--grid-area: tools;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/mcp-tool.json&quot;}"><label for="field-UID">Custom MCP Tools</label><div class="form-group"><input id="field-UID" type="text" name="tools" value="tools" data-proxy="true"/><template class="deck-template"><div class="deck-item deck-item-" data-deck-label-pattern="${id}"><button type="button" class="button btn deck-item-label sort-handle"></button><button type="button" class="button btn edit" title="Edit  item"></button><button type="button" class="button btn duplicate" title="Duplicate  item"></button><button type="button" class="button btn trash" title="Delete  item"></button><dialog class="cms-modal small"><section class="scroller"><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'id'
		'description'
		'section-header-1'
		'params'
		'filters'
		'section-header-2'
		'limit'
		'offset'
		'format'
		'sort'
		'include'
		'exclude';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'id id'
			'description description'
			'section-header-1  .'
			'params params'
			'filters filters'
			'section-header-2  .'
			'limit offset'
			'format format'
			'sort sort'
			'include include'
			'exclude exclude';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid"><h3 class="form-grid-section-header" style="grid-area: section-header-1;">Query</h3><h3 class="form-grid-section-header" style="grid-area: section-header-2;">Result Shape</h3><div class="form-field id-field " data-type="id" style="--grid-area: id;" data-settings="{&quot;snakeCase&quot;:true}"><label for="field-UID">Tool ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required aria-describedby="help-UID" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Snake_case identifier AI clients use to call this tool. Becomes the wire-level tool name when registered.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:2}"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="description" required rows="2" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">What this tool returns. Shown to AI agents in tools/list — write for AI consumption, not LLM instructions.</p></div><div class="form-field json-field " data-type="json" style="--grid-area: params;" data-settings="{&quot;rows&quot;:6}"><label for="field-UID">Params</label><div class="form-group"><textarea id="field-UID" name="params" rows="6" placeholder="{
	&quot;city&quot;: {
		&quot;type&quot;: &quot;string&quot;,
		&quot;description&quot;: &quot;City name.&quot;,
		&quot;required&quot;: true
	},
	&quot;max_price&quot;: {
		&quot;type&quot;: &quot;number&quot;,
		&quot;minimum&quot;: 0
	}
}" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Typed caller parameters as JSON. See <a href="docs/mcp/saved-query-tools">the docs</a> for the param shape.</p></div><div class="form-field json-field " data-type="json" style="--grid-area: filters;" data-settings="{&quot;rows&quot;:6}"><label for="field-UID">Filters</label><div class="form-group"><textarea id="field-UID" name="filters" rows="6" placeholder="{
	&quot;status&quot;: { &quot;value&quot;: &quot;active&quot; },
	&quot;city&quot;:   { &quot;operator&quot;: &quot;contains&quot;, &quot;value&quot;: &quot;{{params.city}}&quot; },
	&quot;price&quot;:  { &quot;operator&quot;: &quot;lte&quot;,      &quot;value&quot;: &quot;{{params.max_price}}&quot; }
}" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Field-name → {value, operator} map as JSON. Filter values may reference <code>{{params.X}}</code> placeholders.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: sort;"><label for="field-UID">Sort</label><div class="form-group"><input type="text" id="field-UID" name="sort" placeholder="date:desc" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">REST-style sort spec, e.g. <code>date:desc</code> or <code>priority:asc,date:desc</code>.</p></div><div class="form-field number-field " data-type="number" style="--grid-area: limit;"><label for="field-UID">Limit</label><div class="form-group"><input type="number" id="field-UID" name="limit" inputmode="numeric" aria-describedby="help-UID" value="20" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Max results per call. Capped at 50.</p></div><div class="form-field number-field " data-type="number" style="--grid-area: offset;"><label for="field-UID">Offset</label><div class="form-group"><input type="number" id="field-UID" name="offset" inputmode="numeric" aria-describedby="help-UID" value="0" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Skip the first N matching results.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: include;"><label for="field-UID">Include</label><div class="form-group"><input type="text" id="field-UID" name="include" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">REST-style include filter — escape hatch for shapes the structured filters object can't express.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: exclude;"><label for="field-UID">Exclude</label><div class="form-group"><input type="text" id="field-UID" name="exclude" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">REST-style exclude filter — escape hatch.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: format;"><label for="field-UID">Format</label><div class="form-group"><select id="field-UID" name="format" aria-describedby="help-UID"><option value="markdown" selected>Markdown</option><option value="html">HTML</option><option value="text">Plain text</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Output format for rich-text fields.</p></div></div></div></section><section><button type="button" class="button btn close">Close</button></section></dialog></div></template><button type="button" title="Add Item" class="button btn cms-add"></button></div><p class="help" id="help-UID">Saved-query tools exposed to AI agents. Add one per row; each is keyed by its id.</p></div></div></div><p class="help" id="help-UID">Configure how this collection is exposed via the MCP server. Pro+ only.</p></div><div class="form-field properties-field " data-type="properties" style="--grid-area: properties;"><label for="field-UID">Schema Overrides</label><div class="form-group"><input type="hidden" name="properties"/><select name="addProperty"><option value="Override Property" class="placeholder" disabled="disabled" selected="selected">Override Property</option><option value="{&quot;label&quot;:&quot;Draft&quot;,&quot;help&quot;:&quot;Mark this post as a draft&quot;,&quot;field&quot;:&quot;checkbox&quot;,&quot;default&quot;:false}">draft</option><option value="{&quot;label&quot;:&quot;Featured&quot;,&quot;help&quot;:&quot;Mark this post as featured&quot;,&quot;field&quot;:&quot;checkbox&quot;}">featured</option><option value="{&quot;label&quot;:&quot;Blog Post ID&quot;,&quot;help&quot;:&quot;A unique ID for this post. No spaces or special characters.&quot;,&quot;field&quot;:&quot;id&quot;,&quot;settings&quot;:{&quot;autogen&quot;:&quot;${title}&quot;}}">id</option><option value="{&quot;label&quot;:&quot;Title&quot;,&quot;help&quot;:&quot;Blog Post title&quot;,&quot;field&quot;:&quot;text&quot;}">title</option><option value="{&quot;label&quot;:&quot;Date&quot;,&quot;help&quot;:&quot;Blog Post date&quot;,&quot;field&quot;:&quot;date&quot;,&quot;default&quot;:&quot;now&quot;}">date</option><option value="{&quot;label&quot;:&quot;Author&quot;,&quot;help&quot;:&quot;Author for this post&quot;,&quot;field&quot;:&quot;text&quot;,&quot;settings&quot;:{&quot;propertyOptions&quot;:true}}">author</option><option value="{&quot;label&quot;:&quot;Summary&quot;,&quot;help&quot;:&quot;Blog Post summary&quot;,&quot;field&quot;:&quot;styledtext&quot;}">summary</option><option value="{&quot;label&quot;:&quot;Media&quot;,&quot;help&quot;:&quot;Media URL for this post&quot;,&quot;field&quot;:&quot;url&quot;}">media</option><option value="{&quot;label&quot;:&quot;Content&quot;,&quot;help&quot;:&quot;Main blog post content&quot;,&quot;field&quot;:&quot;styledtext&quot;}">content</option><option value="{&quot;label&quot;:&quot;Extra Content&quot;,&quot;help&quot;:&quot;Extra content area for this post&quot;,&quot;field&quot;:&quot;styledtext&quot;}">extra</option><option value="{&quot;label&quot;:&quot;Categories&quot;,&quot;help&quot;:&quot;A list of categories for this post&quot;,&quot;field&quot;:&quot;list&quot;,&quot;settings&quot;:{&quot;propertyOptions&quot;:true}}">categories</option><option value="{&quot;label&quot;:&quot;Tags&quot;,&quot;help&quot;:&quot;A list of tags for this post&quot;,&quot;field&quot;:&quot;list&quot;,&quot;settings&quot;:{&quot;propertyOptions&quot;:true}}">tags</option><option value="{&quot;label&quot;:&quot;Image&quot;,&quot;help&quot;:&quot;Main image for this post&quot;,&quot;field&quot;:&quot;image&quot;}">image</option><option value="{&quot;label&quot;:&quot;Gallery&quot;,&quot;help&quot;:&quot;Gallery of images for this post&quot;,&quot;field&quot;:&quot;gallery&quot;}">gallery</option><option value="{&quot;label&quot;:&quot;Updated Date&quot;,&quot;help&quot;:&quot;Blog Post updated date&quot;,&quot;field&quot;:&quot;datetime&quot;,&quot;settings&quot;:{&quot;onUpdate&quot;:true,&quot;readonly&quot;:true}}">updated</option><option value="{&quot;label&quot;:&quot;Creation Date&quot;,&quot;help&quot;:&quot;Blog Post creation date&quot;,&quot;field&quot;:&quot;datetime&quot;,&quot;settings&quot;:{&quot;onCreate&quot;:true,&quot;readonly&quot;:true}}">created</option></select><template class="property-template"><div class="property-field -field"><input type="hidden" name="property" value/><label></label><button type="button" class="button btn edit" title="Edit  property"></button><button type="button" class="button btn trash" title="Delete  property"></button><dialog class="cms-modal small"><section class="scroller"><div class="form-field select-field " data-type="select" style="--grid-area: field;" data-settings="{&quot;clearValue&quot;:false}"><label for="field-UID">Type of Form Field</label><div class="form-group"><select id="field-UID" name="field" aria-describedby="help-UID"><option value class="placeholder" disabled>Select a field type</option><optgroup label="Text (String) Fields"><option value="code">code</option><option value="email">email</option><option value="hidden">hidden</option><option value="json">json</option><option value="phone">phone</option><option value="radio">radio</option><option value="secret">secret</option><option value="select">select</option><option value="styledtext">styledtext</option><option value="svg">svg</option><option value="text" selected>text</option><option value="textarea">textarea</option><option value="time">time</option><option value="url">url</option></optgroup><optgroup label="Boolean Fields"><option value="checkbox">checkbox</option><option value="toggle">toggle</option></optgroup><optgroup label="Number Fields"><option value="number">number</option><option value="price">price</option><option value="range">range</option></optgroup><optgroup label="Date Fields"><option value="date">date</option><option value="datetime">datetime</option></optgroup><optgroup label="List (Array) Fields"><option value="checklist">checklist</option><option value="list">list</option><option value="multiselect">multiselect</option></optgroup><optgroup label="Special Fields"><option value="card">card</option><option value="color">color</option><option value="deck">deck</option><option value="deckTable">deckTable</option><option value="depot">depot</option><option value="file">file</option><option value="gallery">gallery</option><option value="id">id</option><option value="image">image</option><option value="password">password</option><option value="video">video</option></optgroup><optgroup label="Localization Fields"><option value="localizedtext">localizedtext</option><option value="localizedtextarea">localizedtextarea</option><option value="localizedstyledtext">localizedstyledtext</option></optgroup></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The type form field that this field will use</p></div><details open class="cms-accordion "><summary>Form Info</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: label;"><label for="field-UID">Label</label><div class="form-group"><input type="text" id="field-UID" name="label" placeholder="Enter a label" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The label that will be added to the field form</p></div><div class="form-field text-field " data-type="text" style="--grid-area: placeholder;"><label for="field-UID">Placeholder</label><div class="form-group"><input type="text" id="field-UID" name="placeholder" placeholder="Enter a placeholder" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The placeholder text that will be added to the field form</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: help;"><label for="field-UID">Help</label><div class="form-group"><textarea id="field-UID" name="help" rows="2" placeholder="Enter help text" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">The help text that will be added to the field form</p></div></div></details><details class="cms-accordion "><summary>Settings &amp; Options</summary><div class="content"><div class="form-field json-field " data-type="json" style="--grid-area: settings;"><label for="field-UID">Settings</label><div class="form-group"><textarea id="field-UID" name="settings" rows="7" placeholder="{ &quot;key&quot;: &quot;value&quot; }" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">The settings for this field in valid JSON format</p></div><div class="form-field json-field " data-type="json" style="--grid-area: options;"><label for="field-UID">Options &amp; Datalist</label><div class="form-group"><textarea id="field-UID" name="options" rows="7" placeholder="[ &quot;option1&quot;, &quot;option2&quot;, &quot;option3&quot; ]" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">The options for select fields and datalists in valid JSON format.</p></div></div></details></section><section><button type="button" class="button btn close">Close</button><a href="docs" target="_blank" class="docs-link">Search Docs</a></section></dialog></div></template></div><p class="help" id="help-UID">Override schema property attributes for this collection.</p></div><div class="form-field customProperties-field " data-type="customProperties" style="--grid-area: customProperties;"><label for="field-UID">Object Specific Overrides</label><div class="form-group"><input type="hidden" name="customProperties"/><template class="custom-property-template"><details class="cms-accordion customProperties-object"><summary><div class="customProperties-actionbar"><input type="text" name="object" placeholder="myobject" required="required" value/><div class="actions"><button class="duplicate" title="Duplicate object"></button><button class="trash" title="Delete object"></button></div></div></summary><div class="content"><template class="property-template"><div class="property-field -field"><input type="hidden" name="property" value/><label></label><button type="button" class="button btn edit" title="Edit  property"></button><button type="button" class="button btn trash" title="Delete  property"></button><dialog class="cms-modal small"><section class="scroller"><div class="form-field select-field " data-type="select" style="--grid-area: field;" data-settings="{&quot;clearValue&quot;:false}"><label for="field-UID">Type of Form Field</label><div class="form-group"><select id="field-UID" name="field" aria-describedby="help-UID"><option value class="placeholder" disabled>Select a field type</option><optgroup label="Text (String) Fields"><option value="code">code</option><option value="email">email</option><option value="hidden">hidden</option><option value="json">json</option><option value="phone">phone</option><option value="radio">radio</option><option value="secret">secret</option><option value="select">select</option><option value="styledtext">styledtext</option><option value="svg">svg</option><option value="text" selected>text</option><option value="textarea">textarea</option><option value="time">time</option><option value="url">url</option></optgroup><optgroup label="Boolean Fields"><option value="checkbox">checkbox</option><option value="toggle">toggle</option></optgroup><optgroup label="Number Fields"><option value="number">number</option><option value="price">price</option><option value="range">range</option></optgroup><optgroup label="Date Fields"><option value="date">date</option><option value="datetime">datetime</option></optgroup><optgroup label="List (Array) Fields"><option value="checklist">checklist</option><option value="list">list</option><option value="multiselect">multiselect</option></optgroup><optgroup label="Special Fields"><option value="card">card</option><option value="color">color</option><option value="deck">deck</option><option value="deckTable">deckTable</option><option value="depot">depot</option><option value="file">file</option><option value="gallery">gallery</option><option value="id">id</option><option value="image">image</option><option value="password">password</option><option value="video">video</option></optgroup><optgroup label="Localization Fields"><option value="localizedtext">localizedtext</option><option value="localizedtextarea">localizedtextarea</option><option value="localizedstyledtext">localizedstyledtext</option></optgroup></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The type form field that this field will use</p></div><details open class="cms-accordion "><summary>Form Info</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: label;"><label for="field-UID">Label</label><div class="form-group"><input type="text" id="field-UID" name="label" placeholder="Enter a label" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The label that will be added to the field form</p></div><div class="form-field text-field " data-type="text" style="--grid-area: placeholder;"><label for="field-UID">Placeholder</label><div class="form-group"><input type="text" id="field-UID" name="placeholder" placeholder="Enter a placeholder" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The placeholder text that will be added to the field form</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: help;"><label for="field-UID">Help</label><div class="form-group"><textarea id="field-UID" name="help" rows="2" placeholder="Enter help text" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">The help text that will be added to the field form</p></div></div></details><details class="cms-accordion "><summary>Settings &amp; Options</summary><div class="content"><div class="form-field json-field " data-type="json" style="--grid-area: settings;"><label for="field-UID">Settings</label><div class="form-group"><textarea id="field-UID" name="settings" rows="7" placeholder="{ &quot;key&quot;: &quot;value&quot; }" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">The settings for this field in valid JSON format</p></div><div class="form-field json-field " data-type="json" style="--grid-area: options;"><label for="field-UID">Options &amp; Datalist</label><div class="form-group"><textarea id="field-UID" name="options" rows="7" placeholder="[ &quot;option1&quot;, &quot;option2&quot;, &quot;option3&quot; ]" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">The options for select fields and datalists in valid JSON format.</p></div></div></details></section><section><button type="button" class="button btn close">Close</button><a href="docs" target="_blank" class="docs-link">Search Docs</a></section></dialog></div></template><select name="addProperty"><option value="Override Property" class="placeholder" disabled="disabled" selected="selected">Override Property</option><option value="{&quot;label&quot;:&quot;Draft&quot;,&quot;help&quot;:&quot;Mark this post as a draft&quot;,&quot;field&quot;:&quot;checkbox&quot;,&quot;default&quot;:false}">draft</option><option value="{&quot;label&quot;:&quot;Featured&quot;,&quot;help&quot;:&quot;Mark this post as featured&quot;,&quot;field&quot;:&quot;checkbox&quot;}">featured</option><option value="{&quot;label&quot;:&quot;Blog Post ID&quot;,&quot;help&quot;:&quot;A unique ID for this post. No spaces or special characters.&quot;,&quot;field&quot;:&quot;id&quot;,&quot;settings&quot;:{&quot;autogen&quot;:&quot;${title}&quot;}}">id</option><option value="{&quot;label&quot;:&quot;Title&quot;,&quot;help&quot;:&quot;Blog Post title&quot;,&quot;field&quot;:&quot;text&quot;}">title</option><option value="{&quot;label&quot;:&quot;Date&quot;,&quot;help&quot;:&quot;Blog Post date&quot;,&quot;field&quot;:&quot;date&quot;,&quot;default&quot;:&quot;now&quot;}">date</option><option value="{&quot;label&quot;:&quot;Author&quot;,&quot;help&quot;:&quot;Author for this post&quot;,&quot;field&quot;:&quot;text&quot;,&quot;settings&quot;:{&quot;propertyOptions&quot;:true}}">author</option><option value="{&quot;label&quot;:&quot;Summary&quot;,&quot;help&quot;:&quot;Blog Post summary&quot;,&quot;field&quot;:&quot;styledtext&quot;}">summary</option><option value="{&quot;label&quot;:&quot;Media&quot;,&quot;help&quot;:&quot;Media URL for this post&quot;,&quot;field&quot;:&quot;url&quot;}">media</option><option value="{&quot;label&quot;:&quot;Content&quot;,&quot;help&quot;:&quot;Main blog post content&quot;,&quot;field&quot;:&quot;styledtext&quot;}">content</option><option value="{&quot;label&quot;:&quot;Extra Content&quot;,&quot;help&quot;:&quot;Extra content area for this post&quot;,&quot;field&quot;:&quot;styledtext&quot;}">extra</option><option value="{&quot;label&quot;:&quot;Categories&quot;,&quot;help&quot;:&quot;A list of categories for this post&quot;,&quot;field&quot;:&quot;list&quot;,&quot;settings&quot;:{&quot;propertyOptions&quot;:true}}">categories</option><option value="{&quot;label&quot;:&quot;Tags&quot;,&quot;help&quot;:&quot;A list of tags for this post&quot;,&quot;field&quot;:&quot;list&quot;,&quot;settings&quot;:{&quot;propertyOptions&quot;:true}}">tags</option><option value="{&quot;label&quot;:&quot;Image&quot;,&quot;help&quot;:&quot;Main image for this post&quot;,&quot;field&quot;:&quot;image&quot;}">image</option><option value="{&quot;label&quot;:&quot;Gallery&quot;,&quot;help&quot;:&quot;Gallery of images for this post&quot;,&quot;field&quot;:&quot;gallery&quot;}">gallery</option><option value="{&quot;label&quot;:&quot;Updated Date&quot;,&quot;help&quot;:&quot;Blog Post updated date&quot;,&quot;field&quot;:&quot;datetime&quot;,&quot;settings&quot;:{&quot;onUpdate&quot;:true,&quot;readonly&quot;:true}}">updated</option><option value="{&quot;label&quot;:&quot;Creation Date&quot;,&quot;help&quot;:&quot;Blog Post creation date&quot;,&quot;field&quot;:&quot;datetime&quot;,&quot;settings&quot;:{&quot;onCreate&quot;:true,&quot;readonly&quot;:true}}">created</option></select></div></details></template><button type="button" title="Add Object Override" class="button btn cms-add"></button></div><p class="help" id="help-UID">Custom values for the form fields for specific objects.</p></div><div class="form-inline-fields"></div></form></div>