<form class="simple-form totalform import-form" data-route="/import/collections/blog/csv" data-method="POST" data-api="/api" data-refresh="true" data-ajax="true"><div><label for="csv">CSV File</label><input type="file" name="csv" id="csv"/></div><div class="checkbox-field"><input type="checkbox" name="update" id="update"/><label for="update">Update Existing Objects</label></div><div class="checkbox-field"><input type="checkbox" name="queue" id="queue"/><label for="queue">Queue Jobs for Import</label></div><div class="form-inline-fields"><button type="submit" class="button btn dash-button ">Import into Collection</button></div></form>