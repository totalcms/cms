<section class="login-form"><form class="totalform " method="post" action="/admin/login" data-disabled="true" style="position:relative;"><div class="form-field text-field" data-type="text"><label for="field-UID">Email or Username</label><div class="form-group"><input type="text" id="field-UID" name="email" placeholder="email@company.com" aria-describedby="help-UID" required autofocus autocomplete="username webauthn"/><div class="form-group-icon"></div></div><p class="help cms-hide" id="help-UID">Email address or user ID</p></div><div class="form-field password-field" data-type="password"><label for="field-UID">Password</label><div class="form-group"><input type="password" id="field-UID" name="password" placeholder="p@ssw0rd" aria-describedby="help-UID" required class="allow-enter"/><div class="form-group-icon"></div></div><p class="cms-hide help" id="help-UID">Password to login</p></div><div class="form-field checkbox-field" data-type="checkbox"><div class="form-group"><input id="field-UID" name="persistent_login" type="checkbox" value="1" aria-describedby="help-UID"/><label for="field-UID">Keep me signed in</label></div><p class="help cms-hide" id="help-UID">Stay logged in until you explicitly logout or clear browser data</p></div><button type="submit" class="button btn cms-button no-icon">Sign in</button></form></section>