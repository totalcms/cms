<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'status';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'status';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  custom-layout autosave formgrid" data-schema="toggle" data-collection="toggle" data-method="POST" data-api="/api" data-route="/collections/toggle" data-id="mytoggle"><div class="form-field hidden-field " data-type="hidden" style="--grid-area: id;"><div class="form-group"><input type="hidden" id="field-UID" name="id" value="mytoggle" autocomplete="nofill"/></div></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: status;"><div class="form-group"><input id="field-UID" name="status" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Toggle</label></div><p class="help" id="help-UID">Click to toggle the status.</p></div><div class="form-inline-fields"></div></form></div>