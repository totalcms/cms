<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'text';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'text';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  custom-layout formgrid" data-schema="text" data-collection="text" data-method="POST" data-api="/api" data-route="/collections/text" data-id="mytext"><div class="form-field hidden-field " data-type="hidden" style="--grid-area: id;"><div class="form-group"><input type="hidden" id="field-UID" name="id" value="mytext" autocomplete="nofill"/></div></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: text;"><label for="field-UID">Text</label><div class="form-group"><textarea id="field-UID" name="text" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Edit the text here.</p></div><div class="form-inline-fields"></div></form></div>