<form class="totalform help-on-hover help-box mailer-form formgrid" data-schema="mailer" data-collection="mailer" data-method="POST" data-api="/api" data-route="/collections/mailer"><div class="form-field toggle-field " data-type="toggle" style="--grid-area: active;"><label for="field-UID">Active</label><div class="form-group"><div class="switch"><input id="field-UID" name="active" type="checkbox" aria-describedby="help-UID" checked/><label for="field-UID" aria-hidden="true">Active</label></div></div><p class="help" id="help-UID">Enable or disable this email template</p></div><div class="form-field id-field " data-type="id" style="--grid-area: id;" data-settings="{&quot;autogen&quot;:&quot;${name}-${uid}&quot;,&quot;readonly&quot;:true}"><label for="field-UID">Mailer ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required readonly autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div></div><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Template Name</label><div class="form-group"><input type="text" id="field-UID" name="name" required placeholder="New User Welcome Email" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Internal name for this email template</p></div><div class="form-field text-field " data-type="text" style="--grid-area: category;" data-settings="{&quot;propertyOptions&quot;:true}"><label for="field-UID">Category</label><div class="form-group"><input type="text" id="field-UID" name="category" placeholder="Email Templates" aria-describedby="help-UID" list="datalist-UID" autocomplete="nofill"/><datalist id="datalist-UID"></datalist><div class="form-group-icon"></div></div><p class="help" id="help-UID">Category for organizing email templates</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: description;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="description" rows="3" placeholder="What is this email template used for?" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Description of what this email is for</p></div><hr class="form-grid-section-divider"/><div class="form-field text-field " data-type="text" style="--grid-area: to;" data-settings="{&quot;required&quot;:true}"><label for="field-UID">To Email</label><div class="form-group"><input type="text" id="field-UID" name="to" required placeholder="name@example.com" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Recipient email address (supports twig: {{ data.email }})</p></div><div class="form-field email-field " data-type="email" style="--grid-area: from;"><label for="field-UID">From Email</label><div class="form-group"><input type="email" id="field-UID" name="from" inputmode="email" placeholder="noreply@example.com" aria-describedby="help-UID" autocomplete="nofill" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">From email address (leave empty to use default from SMTP settings)</p></div><div class="form-field text-field " data-type="text" style="--grid-area: toName;"><label for="field-UID">To Name</label><div class="form-group"><input type="text" id="field-UID" name="toName" placeholder="John Smith" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Recipient name (supports twig: {{ data.name }})</p></div><div class="form-field text-field " data-type="text" style="--grid-area: fromName;"><label for="field-UID">From Name</label><div class="form-group"><input type="text" id="field-UID" name="fromName" placeholder="Your Company Name" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">From name (leave empty to use default from SMTP settings)</p></div><div class="form-field text-field " data-type="text" style="--grid-area: replyTo;"><label for="field-UID">Reply-To Email</label><div class="form-group"><input type="text" id="field-UID" name="replyTo" placeholder="reply@example.com" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Reply-to email address (supports twig: {{ data.email }})</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: cc;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">CC Emails</label><div class="form-group"><textarea id="field-UID" name="cc" rows="3" placeholder="manager@example.com
sales@example.com" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">CC email addresses, one per line (supports twig: {{ data.managerEmail }})</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: bcc;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">BCC Emails</label><div class="form-group"><textarea id="field-UID" name="bcc" rows="3" placeholder="admin@example.com
archive@example.com" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">BCC email addresses, one per line (supports twig: {{ data.adminEmail }})</p></div><hr class="form-grid-section-divider"/><div class="form-field text-field " data-type="text" style="--grid-area: subject;" data-settings="{&quot;required&quot;:true}"><label for="field-UID">Subject</label><div class="form-group"><input type="text" id="field-UID" name="subject" required placeholder="New Contact from {{ data.name }}" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Email subject line (supports twig: New contact from {{ data.name }})</p></div><div class="form-field code-field " data-type="code" style="--grid-area: bodyHtml;" data-settings="{&quot;rows&quot;:15,&quot;maxHeight&quot;:600,&quot;mode&quot;:&quot;twig&quot;,&quot;required&quot;:true}"><label for="field-UID">Body (HTML)</label><div class="form-group"><textarea id="field-UID" name="bodyHtml" required rows="15" placeholder="&lt;p&gt;Hello {{ data.name }},&lt;/p&gt;
&lt;p&gt;Thank you for contacting us.&lt;/p&gt;" autocomplete="off" aria-describedby="help-UID" data-field-type="code" data-mode="twig" data-theme="elegant" data-max-height="600" data-editor-options="{&quot;autofocus&quot;:false,&quot;lineNumbers&quot;:true,&quot;lineWrapping&quot;:true,&quot;indentUnit&quot;:2,&quot;tabSize&quot;:2,&quot;foldGutter&quot;:true,&quot;matchBrackets&quot;:true,&quot;autoCloseTags&quot;:true,&quot;fullscreen&quot;:true}" class="code-editor-field"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">HTML email body (supports twig variables)</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: bodyText;" data-settings="{&quot;rows&quot;:10}"><label for="field-UID">Body (Plain Text)</label><div class="form-group"><textarea id="field-UID" name="bodyText" rows="10" placeholder="Hello {{ data.name }},

Thank you for contacting us." autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Plain text email body (supports twig variables, optional)</p></div><div class="form-inline-fields"><button type="submit" class="button btn cms-save cms-button">Save</button><button type="button" class="button btn cms-delete cms-button">Delete</button></div></form>