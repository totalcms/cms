<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'depot';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'depot';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  custom-layout formgrid" data-schema="depot" data-collection="depot" data-method="POST" data-api="/api" data-route="/collections/depot" data-id="mydepot"><div class="form-field hidden-field " data-type="hidden" style="--grid-area: id;"><div class="form-group"><input type="hidden" id="field-UID" name="id" value="mydepot" autocomplete="nofill"/></div></div><div class="form-field depot-field " data-type="depot" style="--grid-area: depot;"><label for="field-UID">Files</label><div class="form-group"><input id="field-UID" type="text" name="depot" data-proxy="true"/><div class="depot-layout-container"><button type="button" class="button btn protect" title="Edit Depot Protection"></button><div class="depot-layout"><div class="depot-browser-wrapper"><div class="depot-filter-wrapper"><input type="search" class="depot-filter" placeholder="Filter files..."/></div><ul class="depot-browser"></ul></div><div class="depot-preview"><div class="folder-preview dz-clickable">
	<div class="dz-overlay"></div>
	<h4 class="folder-name"></h4>
</div><div class="file-preview cms-hide">
	<div class="file file-icon">
		<h4 class="file-name"></h4>
	</div>
	<div class="file-info">
		<div>
			<div class="info"><h6>Size</h6><span class="file-size"></span></div>
			<div class="info"><h6>Date</h6><span class="file-date"></span></div>
			<div class="info"><h6>D.Count</h6><span class="file-count"></span></div>
			<div class="info"><h6>D.Name</h6><span class="file-download"></span></div>
		</div>
		<div>
			<h6>Comments</h6>
			<p class="file-comments"></p>
		</div>
		<div>
			<h6>Tags</h6>
			<div class="file-tags"></div>
		</div>
	</div>
	<button type="button" class="preview-file" disabled>Preview</button>
</div>
<dialog class="cms-modal preview-dialog">
	<div class="preview-content"></div>
</dialog><div class="actionbar">
	<button type="button" class="edit" title="Edit File Info" disabled></button>
	<button type="button" class="links" title="Download Links" disabled></button>
	<button type="button" class="download" title="Download File" disabled></button>
	<button type="button" class="upload dz-clickable" title="Upload"></button>
	<button type="button" class="add-folder" title="New Folder" disabled></button>
	<button type="button" class="trash" title="Delete File" disabled></button>
</div></div></div></div><dialog class="cms-modal folder-add-dialog"><div class="form-field text-field " data-type="text" style="--grid-area: addpath;"><label for="field-UID">Folder path</label><div class="form-group"><input type="text" id="field-UID" name="addpath" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name and path to the folder that you want to create.</p></div><section><button type="button" class="button btn ">Add Folder</button></section></dialog><dialog class="cms-modal folder-edit-dialog"><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Folder Name</label><div class="form-group"><input type="text" id="field-UID" name="name" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name of the folder.</p></div><section><button type="button" class="button btn close">Close</button></section></dialog><template class="file-template"><li><div class="file file-icon icon-">Unknown</div><div class="size">0.0 B</div><dialog class="cms-modal file-links-dialog"><iframe style="width:100%;height:100%" data-src="/admin/filelinks?id=mydepot&amp;collection=depot&amp;property=depot&amp;name=Unknown" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" class="cms-iframe "></iframe></dialog><dialog class="cms-modal file-edit-dialog"><section class="scroller"><details class="cms-accordion "><summary>Info</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: download;"><label for="field-UID">Download Name</label><div class="form-group"><input type="text" id="field-UID" name="download" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name of the file when it gets downloaded.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: comments;"><label for="field-UID">Comments</label><div class="form-group"><textarea id="field-UID" name="comments" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Comments about this file</p></div><div class="form-field list-field " data-type="list" style="--grid-area: tags;"><label for="field-UID">Tags</label><div class="form-group"><select id="field-UID" name="tags" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Add tags to help organize your files.</p></div></div></details><details class="cms-accordion "><summary>Meta (Readonly)</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Filename</label><div class="form-group"><input type="text" id="field-UID" name="name" readonly autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: ext;"><label for="field-UID">Extension</label><div class="form-group"><input type="text" id="field-UID" name="ext" readonly autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: size;"><label for="field-UID">Size</label><div class="form-group"><input type="number" id="field-UID" name="size" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: count;"><label for="field-UID">Download Count</label><div class="form-group"><input type="number" id="field-UID" name="count" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: mime;"><label for="field-UID">MIME Type</label><div class="form-group"><input type="text" id="field-UID" name="mime" readonly autocomplete="nofill"/></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: uploadDate;"><label for="field-UID">Upload Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="uploadDate" readonly autocomplete="nofill"/></div></div></div></details></section><section><button type="button" class="button btn close">Close</button></section></dialog></li></template><template class="folder-template"><li><details><summary class="folder" data-path></summary><ul class="folder-contents"></ul></details></li></template><dialog class="cms-modal protection-dialog"><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: protected;"><div class="form-group"><input id="field-UID" name="protected" type="checkbox" aria-describedby="help-UID" checked/><label for="field-UID">Protected by Collection</label></div><p class="help" id="help-UID">Access group protection is set in the Collection.</p></div><div class="form-field password-field " data-type="password" style="--grid-area: password;" data-settings="{&quot;ignoreManagers&quot;:true}"><label for="field-UID">Password</label><div class="form-group"><input type="password" id="field-UID" name="password" aria-describedby="help-UID" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true"/><div class="form-group-icon"></div></div><div class="form-group"><input type="password" id="field-UID-confirm" name="password-confirm" aria-describedby="help-UID" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Require a password to download files from this depot. This overrides all collection level access controls.</p></div><section><button type="button" class="button btn close">Close</button></section></dialog></div><p class="help" id="help-UID">Drag and drop files here.</p></div><div class="form-inline-fields"></div></form></div>