<div class="jobqueue-all-stats" hx-get="/api/jobqueue/stats/html" hx-trigger="every 5s" hx-swap="innerHTML"><div class="jobqueue-stats-wrapper"><h4>Job Queue by Type</h4><table class="jobqueue-stats jobqueue-by-type cms-colors"><tr class="email"><td>Email</td><td>0</td></tr><tr class="export"><td>Export</td><td>0</td></tr><tr class="factory"><td>Factory</td><td>0</td></tr><tr class="import"><td>Import</td><td>0</td></tr><tr class="rebuild"><td>Rebuild</td><td>0</td></tr><tr class="search.reindex"><td>Search.reindex</td><td>0</td></tr><tr class="update"><td>Update</td><td>0</td></tr><tr class="view-update"><td>View Update</td><td>0</td></tr></table></div><div class="jobqueue-stats-wrapper"><h4>Job Queue by Status</h4><table class="jobqueue-stats jobqueue-by-status cms-colors"><tr class="pending"><td>Pending</td><td>0</td></tr><tr class="in-progress"><td>In-Progress</td><td>0</td></tr><tr class="failed"><td>Failed</td><td>0</td></tr><tr class="total"><td>Total</td><td>0</td></tr></table></div></div>