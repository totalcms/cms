eholder="No Copyright Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: exif-description;"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="exif-description" rows="3" placeholder="No Description Found" autocomplete="off"></textarea><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>EXIF - Camera</summary><div class="content"><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-make;"><label for="field-UID">Make</label><div class="form-group"><input type="text" id="field-UID" name="exif-make" placeholder="Camera Make Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-camera;"><label for="field-UID">Model</label><div class="form-group"><input type="text" id="field-UID" name="exif-camera" placeholder="Camera Model Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-lens;"><label for="field-UID">Lens</label><div class="form-group"><input type="text" id="field-UID" name="exif-lens" placeholder="Lens Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-focalLength;"><label for="field-UID">Focal Length</label><div class="form-group"><input type="number" id="field-UID" name="exif-focalLength" inputmode="decimal" placeholder="Focal Length Not Found" step="any" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-aperture;"><label for="field-UID">Aperture</label><div class="