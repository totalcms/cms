<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'label'
		'photo'
		'doc';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'label'
			'photo'
			'doc';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  edit-mode formgrid" data-form="deck" data-schema="widgets" data-collection="widgets" data-collection-count="2" data-method="PUT" data-api="/api" data-route="/collections/widgets/w1/mydeck/deck/one" data-id="w1"><div class="form-field id-field " data-type="id" style="--grid-area: id;"><div class="form-group"><input type="text" id="field-UID" name="id" required readonly value="one" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div></div><div class="form-field text-field " data-type="text" style="--grid-area: label;"><div class="form-group"><input type="text" id="field-UID" name="label" value="Item label" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field image-field " data-type="image" style="--grid-area: photo;" data-settings="{&quot;extractPalette&quot;:false}"><div class="form-group"><input id="field-UID" type="text" name="photo" data-proxy="true"/><div class="dz-overlay dz-clickable"></div><div class="total-preview"><div class="image-preview"><div class="dz-preview dz-file-preview not-found">
	<div class="actionbar">
		<button type="button" class="edit"     title="Edit Image Info"></button>
		<button type="button" class="links"    title="Image URL"></button>
		<button type="button" class="featured" title="Toggle Featured"></button>
		<button type="button" class="download" title="Download Original Image"></button>
		<button type="button" class="move"     title="Reorder Image"></button>
		<button type="button" class="upload dz-clickable" title="Upload New Image"></button>
		<button type="button" class="clear"    title="Clear Cache"></button>
		<button type="button" class="trash"    title="Delete Image"></button>
	</div>
	<img src="" alt="" onload="this.parentNode.classList.remove('not-found')" oncontextmenu="return false;" draggable="false" data-dz-thumbnail />
	<div class="dz-progress">
		<span class="dz-upload" data-dz-uploadprogress></span>
		<span class="dz-upload-progress-label" data-dz-uploadprogress>0%</span>
		<div class="dz-status"></div>
	</div>
</div><dialog class="cms-modal split-view image-edit-dialog"><section class="image-preview"><img src oncontextmenu="return false;" draggable="false" data-dz-thumbnail/><div class="focal-point" style="top:50%;left:50%"></div></section><section class="scroller"><details class="cms-accordion "><summary>Info</summary><div class="content"><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: featured;"><div class="form-group"><input id="field-UID" name="featured" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Featured</label></div><p class="help" id="help-UID">Mark this image as featured.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: alt;"><label for="field-UID">Alt Text</label><div class="form-group"><input type="text" id="field-UID" name="alt" placeholder="Enter Alt Text" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Alt text is used by screen readers and search engines to describe the image.</p></div><div class="form-field url-field " data-type="url" style="--grid-area: link;"><label for="field-UID">Link</label><div class="form-group"><input type="url" id="field-UID" name="link" inputmode="url" placeholder="https://example.com" aria-describedby="help-UID" autocomplete="nofill" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Enter a URL to link the image to.</p></div><div class="form-field list-field " data-type="list" style="--grid-area: tags;"><label for="field-UID">Tags</label><div class="form-group"><select id="field-UID" name="tags" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Add tags to help organize your images.</p></div></div></details><details class="cms-accordion "><summary>Focal Point</summary><div class="content"><div class="form-field range-field " data-type="range" style="-