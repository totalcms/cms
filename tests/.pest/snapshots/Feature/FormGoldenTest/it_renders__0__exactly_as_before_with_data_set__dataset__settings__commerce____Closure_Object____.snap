<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'enabled'
		'section-header-1'
		'currency'
		'customerCollection'
		'section-header-2'
		'providers'
		'checkoutMode'
		'returnPage'
		'payPage'
		'section-header-3'
		'orderNumberStart'
		'orderNumberPrefix'
		'pendingOrderTtlHours'
		'checkoutAttributes'
		'section-header-4'
		'taxMode'
		'taxBy'
		'taxShipping'
		'taxRates'
		'section-header-5'
		'shippingMode'
		'shippingFlatRate'
		'shippingFreeOver'
		'shippingZones'
		'section-header-6'
		'lowStockAt'
		'section-header-7'
		'receiptMailer'
		'paymentFailedMailer'
		'section-header-8'
		'downloadTtlHours'
		'downloadMaxCount'
		'grantableGroups'
		'section-header-9'
		'cartMaxLines'
		'cartMaxQty'
		'customPriceMax';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'enabled enabled'
			'section-header-1  .'
			'currency customerCollection'
			'section-header-2  .'
			'providers providers'
			'checkoutMode .'
			'returnPage payPage'
			'section-header-3  .'
			'orderNumberStart orderNumberPrefix'
			'pendingOrderTtlHours .'
			'checkoutAttributes checkoutAttributes'
			'section-header-4  .'
			'taxMode taxBy'
			'taxShipping .'
			'taxRates taxRates'
			'section-header-5  .'
			'shippingMode .'
			'shippingFlatRate shippingFreeOver'
			'shippingZones shippingZones'
			'section-header-6  .'
			'lowStockAt .'
			'section-header-7  .'
			'receiptMailer paymentFailedMailer'
			'section-header-8  .'
			'downloadTtlHours downloadMaxCount'
			'grantableGroups grantableGroups'
			'section-header-9  .'
			'cartMaxLines cartMaxQty'
			'customPriceMax .';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform help-on-hover help-box formgrid" data-method="POST" data-api="/api" data-route="/admin/settings/commerce"><h3 class="form-grid-section-header" style="grid-area: section-header-1;" data-section-fields="currency customerCollection">Store</h3><h3 class="form-grid-section-header" style="grid-area: section-header-2;" data-section-fields="providers checkoutMode returnPage payPage">Payments</h3><h3 class="form-grid-section-header" style="grid-area: section-header-3;" data-section-fields="orderNumberStart orderNumberPrefix pendingOrderTtlHours checkoutAttributes">Orders</h3><h3 class="form-grid-section-header" style="grid-area: section-header-4;" data-section-fields="taxMode taxBy taxShipping taxRates">Tax</h3><h3 class="form-grid-section-header" style="grid-area: section-header-5;" data-section-fields="shippingMode shippingFlatRate shippingFreeOver shippingZones">Shipping</h3><h3 class="form-grid-section-header" style="grid-area: section-header-6;" data-section-fields="lowStockAt">Stock</h3><h3 class="form-grid-section-header" style="grid-area: section-header-7;" data-section-fields="receiptMailer paymentFailedMailer">Email</h3><h3 class="form-grid-section-header" style="grid-area: section-header-8;" data-section-fields="downloadTtlHours downloadMaxCount grantableGroups">Digital Products and Memberships</h3><h3 class="form-grid-section-header" style="grid-area: section-header-9;" data-section-fields="cartMaxLines cartMaxQty customPriceMax">Limits</h3><div class="form-field toggle-field " data-type="toggle" style="--grid-area: enabled;"><label for="field-UID">Enable Commerce</label><div class="form-group"><div class="switch"><input id="field-UID" name="enabled" type="checkbox" aria-describedby="help-UID"/><label for="field-UID" aria-hidden="true">Enable Commerce</label></div></div><p class="help" id="help-UID">Turn the store on for this site. While it is off there is no Orders page, no Store block on the dashboard, and no cart or checkout. Turning it off later does not take anything away from a buyer: their download links keep working, and a subscriber can still cancel.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: currency;" data-settings="{&quot;propertyOptions&quot;:&quot;currencies&quot;,&quot;clearValue&quot;:false}"><label for="field-UID">Store Currency</label><div class="form-group"><select id="field-UID" name="currency" aria-describedby="help-UID"><option value="AFN">Afghan Afghani (AFN)</option><option value="ALL">Albanian Lek (ALL)</option><option value="DZD">Algerian Dinar (DZD)</option><option value="AOA">Angolan Kwanza (AOA)</option><option value="ARS">Argentine Peso (ARS)</option><option value="AMD">Armenian Dram (AMD)</option><option value="AWG">Aruban Florin (AWG)</option><option value="AUD">Australian Dollar (AUD)</option><option value="AZN">Azerbaijani Manat (AZN)</option><option value="BSD">Bahamian Dollar (BSD)</option><option value="BHD">Bahraini Dinar (BHD)</option><option value="BDT">Bangladeshi Taka (BDT)</option><option value="BBD">Barbadian Dollar (BBD)</option><option value="BYN">Belarusian Ruble (BYN)</option><option value="BZD">Belize Dollar (BZD)</option><option value="BMD">Bermudan Dollar (BMD)</option><option value="BTN">Bhutanese Ngultrum (BTN)</option><option value="BOB">Bolivian Boliviano (BOB)</option><option value="BAM">Bosnia-Herzegovina Convertible Mark (BAM)</option><option value="BWP">Botswanan Pula (BWP)</option><option value="BRL">Brazilian Real (BRL)</option><option value="GBP">British Pound (GBP)</option><option value="BND">Brunei Dollar (BND)</option><option value="BIF">Burundian Franc (BIF)</option><option value="KHR">Cambodian Riel (KHR)</option><option value="CAD">Canadian Dollar (CAD)</option><option value="CVE">Cape Verdean Escudo (CVE)</option><option value="XCG">Caribbean guilder (XCG)</option><option value="KYD">Cayman Islands Dollar (KYD)</option><option value="XAF">Central African CFA Franc (XAF)</option><option value="XPF">CFP Franc (XPF)</option><option value="CLP">Chilean Peso (CLP)</option><option value="CNY">Chinese Yuan (CNY)</option><option value="COP">Colombian Peso (COP)</option><option value="KMF">Comorian Franc (KMF)</option><option value="CDF">Congolese Franc (CDF)</option><option value="CRC">Costa Rican Colón (CRC)</option><option value="CUP">Cuban Peso (CUP)</option><option value="CZK">Czech Koruna (CZK)</option><option value="DKK">Danish Krone (DKK)</option><option value="DJF">Djiboutian Franc (DJF)</option><option value="DOP">Dominican Peso (DOP)</option><option value="XCD">East Caribbean Dollar (XCD)</option><option value="EGP">Egyptian Pound (EGP)</option><option value="ERN">Eritrean Nakfa (ERN)</option><option value="ETB">Ethiopian Birr (ETB)</option><option value="EUR">Euro (EUR)</option><option value="FKP">Falkland Islands Pound (FKP)</option><option value="FJD">Fijian Dollar (FJD)</option><option value="GMD">Gambian Dalasi (GMD)</option><option value="GEL">Georgian Lari (GEL)</option><option value="GHS">Ghanaian Cedi (GHS)</option><option value="GIP">Gibraltar Pound (GIP)</option><option value="GTQ">Guatemalan Quetzal (GTQ)</option><option value="GNF">Guinean Franc (GNF)</option><option value="GYD">Guyanaese Dollar (GYD)</option><option value="HTG">Haitian Gourde (HTG)</option><option value="HNL">Honduran Lempira (HNL)</option><option value="HKD">Hong Kong Dollar (HKD)</option><option value="HUF">Hungarian Forint (HUF)</option><option value="ISK">Icelandic Króna (ISK)</option><option value="INR">Indian Rupee (INR)</option><option value="IDR">Indonesian Rupiah (IDR)</option><option value="IRR">Iranian Rial (IRR)</option><option value="IQD">Iraqi Dinar (IQD)</option><option value="ILS">Israeli New Shekel (ILS)</option><option value="JMD">Jamaican Dollar (JMD)</option><option value="JPY">Japanese Yen (JPY)</option><option value="JOD">Jordanian Dinar (JOD)</option><option value="KZT">Kazakhstani Tenge (KZT)</option><option value="KES">Kenyan Shilling (KES)</option><option value="KWD">Kuwaiti Dinar (KWD)</option><option value="KGS">Kyrgyz Som (KGS)</option><option value="LAK">Laotian Kip (LAK)</option><option value="LBP">Lebanese Pound (LBP)</option><option value="LSL">Lesotho Loti (LSL)</option><option value="LRD">Liberian Dollar (LRD)</option><option value="LYD">Libyan Dinar (LYD)</option><option value="MOP">Macanese Pataca (MOP)</option><option value="MKD">Macedonian Denar (MKD)</option><option value="MGA">Malagasy Ariary (MGA)</option><option value="MWK">Malawian Kwacha (MWK)</option><option value="MYR">Malaysian Ringgit (MYR)</option><option value="MVR">Maldivian Rufiyaa (MVR)</option><option value="MRU">Mauritanian Ouguiya (MRU)</option><option value="MUR">Mauritian Rupee (MUR)</option><option value="MXN">Mexican Peso (MXN)</option><option value="MDL">Moldovan Leu (MDL)</option><option value="MNT">Mongolian Tugrik (MNT)</option><option value="MAD">Moroccan Dirham (MAD)</option><option value="MZN">Mozambican Metical (MZN)</option><option value="MMK">Myanmar Kyat (MMK)</option><option value="NAD">Namibian Dollar (NAD)</option><option value="NPR">Nepalese Rupee (NPR)</option><option value="TWD">New Taiwan Dollar (TWD)</option><option value="NZD">New Zealand Dollar (NZD)</option><option value="NIO">Nicaraguan Córdoba (NIO)</option><option value="NGN">Nigerian Naira (NGN)</option><option value="KPW">North Korean Won (KPW)</option><option value="NOK">Norwegian Krone (NOK)</option><option value="OMR">Omani Rial (OMR)</option><option value="PKR">Pakistani Rupee (PKR)</option><option value="PAB">Panamanian Balboa (PAB)</option><option value="PGK">Papua New Guinean Kina (PGK)</option><option value="PYG">Paraguayan Guarani (PYG)</option><option value="PEN">Peruvian Sol (PEN)</option><option value="PHP">Philippine Peso (PHP)</option><option value="PLN">Polish Zloty (PLN)</option><option value="QAR">Qatari Riyal (QAR)</option><option value="RON">Romanian Leu (RON)</option><option value="RUB">Russian Ruble (RUB)</option><option value="RWF">Rwandan Franc (RWF)</option><option value="WST">Samoan Tala (WST)</option><option value="SAR">Saudi Riyal (SAR)</option><option value="RSD">Serbian Dinar (RSD)</option><option value="SCR">Seychellois Rupee (SCR)</option><option value="SLE">Sierra Leonean Leone (SLE)</option><option value="SGD">Singapore Dollar (SGD)</option><option value="SBD">Solomon Islands Dollar (SBD)</option><option value="SOS">Somali Shilling (SOS)</option><option value="ZAR">South African Rand (ZAR)</option><option value="KRW">South Korean Won (KRW)</option><option value="SSP">South Sudanese Pound (SSP)</option><option value="LKR">Sri Lankan Rupee (LKR)</option><option value="SHP">St. Helena Pound (SHP)</option><option value="SDG">Sudanese Pound (SDG)</option><option value="SRD">Surinamese Dollar (SRD)</option><option value="SZL">Swazi Lilangeni (SZL)</option><option value="SEK">Swedish Krona (SEK)</option><option value="CHF">Swiss Franc (CHF)</option><option value="SYP">Syrian Pound (SYP)</option><option value="STN">São Tomé &amp; Príncipe Dobra (STN)</option><option value="TJS">Tajikistani Somoni (TJS)</option><option value="TZS">Tanzanian Shilling (TZS)</option><option value="THB">Thai Baht (THB)</option><option value="TOP">Tongan Paʻanga (TOP)</option><option value="TTD">Trinidad &amp; Tobago Dollar (TTD)</option><option value="TND">Tunisian Dinar (TND)</option><option value="TRY">Turkish Lira (TRY)</option><option value="TMT">Turkmenistani Manat (TMT)</option><option value="UGX">Ugandan Shilling (UGX)</option><option value="UAH">Ukrainian Hryvnia (UAH)</option><option value="AED">United Arab Emirates Dirham (AED)</option><option value="UYU">Uruguayan Peso (UYU)</option><option value="USD" selected>US Dollar (USD)</option><option value="UZS">Uzbekistani Som (UZS)</option><option value="VUV">Vanuatu Vatu (VUV)</option><option value="VES">Venezuelan Bolívar (VES)</option><option value="VND">Vietnamese Dong (VND)</option><option value="XOF">West African CFA Franc (XOF)</option><option value="YER">Yemeni Rial (YER)</option><option value="ZMW">Zambian Kwacha (ZMW)</option><option value="ZWG">Zimbabwean Gold (ZWG)</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The currency every price and order is in. Choose it before the first order: changing it later does not convert existing prices or orders.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: customerCollection;" data-settings="{&quot;propertyOptions&quot;:&quot;schemaCollections:auth&quot;}"><label for="field-UID">Customer Accounts Collection</label><div class="form-group"><select id="field-UID" name="customerCollection" aria-describedby="help-UID"><option value class="placeholder" disabled selected>Guest checkout only</option><option value="auth">Auth</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The collection customers sign in to, so they can see their orders. Leave empty for guest checkout only.</p></div><div class="form-field checklist-field  choice-field" data-type="checklist" style="--grid-area: providers;--fieldset-grid-size:250px;" data-settings="{&quot;fieldGrid&quot;:&quot;250px&quot;,&quot;propertyOptions&quot;:&quot;paymentProviders&quot;}"><fieldset><legend>Payment Providers<button type="button" class="choice-field-toggle-all" title="Select all" aria-label="Select all"></button></legend></fieldset><p class="help" id="help-UID">The ways a buyer can pay. Checkout lists them in the order shown here. A provider appears here once its extension is enabled, and is offered to buyers once it has its keys.</p></div><div class="form-field radio-field  choice-field" data-type="radio" style="--grid-area: checkoutMode;"><fieldset><legend>Checkout</legend><div class="radio"><input id="field-UID-1" name="checkoutMode" type="radio" value="hosted" aria-describedby="help-UID" checked/><label for="field-UID-1" class="radio-label">On the provider's page</label></div><div class="radio"><input id="field-UID-2" name="checkoutMode" type="radio" value="embedded" aria-describedby="help-UID"/><label for="field-UID-2" class="radio-label">On this site</label></div></fieldset><p class="help" id="help-UID">Where the buyer pays. <strong>Provider's page</strong> sends them to the payment provider and brings them back. <strong>On this site</strong> shows the payment form on your own page; it is used when the chosen provider can do it, and the provider's page otherwise.</p></div><div class="form-field number-field " data-type="number" style="--grid-area: orderNumberStart;"><label for="field-UID">First Order Number</label><div class="form-group"><input type="number" id="field-UID" name="orderNumberStart" inputmode="numeric" placeholder="1001" aria-describedby="help-UID" value="1001" min="1" max="999999999" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The number the first order gets. Raise it later to jump ahead; lowering it does nothing, because a number is never used twice.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: orderNumberPrefix;"><label for="field-UID">Order Number Prefix</label><div class="form-group"><input type="text" id="field-UID" name="orderNumberPrefix" placeholder="#" aria-describedby="help-UID" value="#" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Shown before an order number, as in <code>#1001</code>. For display only.</p></div><div class="form-field radio-field  choice-field" data-type="radio" style="--grid-area: taxMode;"><fieldset><legend>Tax</legend><div class="radio"><input id="field-UID-1" name="taxMode" type="radio" value="none" aria-describedby="help-UID" checked/><label for="field-UID-1" class="radio-label">No tax</label></div><div class="radio"><input id="field-UID-2" name="taxMode" type="radio" value="exclusive" aria-describedby="help-UID"/><label for="field-UID-2" class="radio-label">Added to prices</label></div><div class="radio"><input id="field-UID-3" name="taxMode" type="radio" value="inclusive" aria-describedby="help-UID"/><label for="field-UID-3" class="radio-label">Included in prices</label></div></fieldset><p class="help" id="help-UID"><strong>No tax</strong> charges none. <strong>Added to prices</strong> adds the tax at checkout. <strong>Included in prices</strong> treats your prices as already including it and shows the tax part on the order.</p></div><div class="form-field radio-field  choice-field field-hidden" data-type="radio" style="--grid-area: taxBy; display: none;" data-settings="{&quot;visibility&quot;:{&quot;watch&quot;:&quot;taxMode&quot;,&quot;value&quot;:&quot;none&quot;,&quot;operator&quot;:&quot;!=&quot;}}"><fieldset><legend>Tax Worked Out By</legend><div class="radio"><input id="field-UID-1" name="taxBy" type="radio" value="table" aria-describedby="help-UID" checked/><label for="field-UID-1" class="radio-label">My tax rates</label></div><div class="radio"><input id="field-UID-2" name="taxBy" type="radio" value="provider" aria-describedby="help-UID"/><label for="field-UID-2" class="radio-label">The payment provider, when it can</label></div></fieldset><p class="help" id="help-UID"><strong>My tax rates</strong> uses the table below for every order. <strong>The payment provider, when it can</strong> leaves it to Stripe Tax for orders paid with Stripe: Stripe finds the exact rate for the buyer's address and adds it when they pay. That needs Stripe Tax set up in your Stripe account; run <code>tcms stripe:tax</code> to check. An order paid with a provider that cannot work out tax, such as PayPal, uses your tax rates.</p></div><div class="form-field toggle-field  field-hidden" data-type="toggle" style="--grid-area: taxShipping; display: none;" data-settings="{&quot;visibility&quot;:{&quot;watch&quot;:&quot;taxMode&quot;,&quot;value&quot;:&quot;none&quot;,&quot;operator&quot;:&quot;!=&quot;}}"><label for="field-UID">Tax Shipping</label><div class="form-group"><div class="switch"><input id="field-UID" name="taxShipping" type="checkbox" aria-describedby="help-UID"/><label for="field-UID" aria-hidden="true">Tax Shipping</label></div></div><p class="help" id="help-UID">Charge tax on the shipping amount as well as on the goods. This is for your own tax rates: a payment provider that works out the tax decides this by the rules of the buyer's place.</p></div><div class="form-field deckTable-field  field-hidden" data-type="deckTable" style="--grid-area: taxRates; display: none;" data-settings="{&quot;visibility&quot;:{&quot;watch&quot;:&quot;taxMode&quot;,&quot;value&quot;:&quot;none&quot;,&quot;operator&quot;:&quot;!=&quot;},&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/commerce-tax-rate.json&quot;}"><label for="field-UID">Tax Rates</label><div class="form-group"><input id="field-UID" type="text" name="taxRates" value="taxRates" data-proxy="true"/><div class="deck-table"><div class="deck-table-header"><span class="deck-table-handle-spacer"></span><span class="deck-table-header-cell" data-field-type="select">Country</span><span class="deck-table-header-cell" data-field-type="text">Region</span><span class="deck-table-header-cell" data-field-type="text">Rate (%)</span><span class="deck-table-header-cell" data-field-type="text">Label</span><span class="deck-table-actions-spacer"></span></div><div class="deck-table-body"></div><template class="deck-table-template"><div class="deck-table-row"><div class="sort-handle"></div><div class="deck-table-cell cms-hide" data-label="Rate ID" data-field-type="id"><div class="form-field id-field cms-hide" data-type="id" style="--grid-area: id;" data-settings="{&quot;autogen&quot;:&quot;tax_${uid}&quot;,&quot;hide&quot;:true}"><div class="form-group"><input type="text" id="field-UID" name="id" required autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></