">dateTimeBetween(&#039;-27 week&#039;, &#039;now&#039;)</option><option value="dateTimeThisYear">dateTimeThisYear</option><option value="dateTimeThisMonth">dateTimeThisMonth</option><option value="dayOfWeek">dayOfWeek</option><option value="monthName">monthName</option><option value="year">year</option><option value="timezone">timezone</option><option value="randomNumber(5)">randomNumber(5)</option><option value="randomFloat(2, 0, 100)">randomFloat(2, 0, 100)</option><option value="numberBetween(1, 100)">numberBetween(1, 100)</option><option value="randomDigit">randomDigit</option><option value="randomLetter">randomLetter</option><option value="numerify(&#039;###-###-####&#039;)">numerify(&#039;###-###-####&#039;)</option><option value="lexify(&#039;????-????&#039;)">lexify(&#039;????-????&#039;)</option><option value="bothify(&#039;??##-##??&#039;)">bothify(&#039;??##-##??&#039;)</option><option value="cityPrefix">cityPrefix</option><option value="secondaryAddress">secondaryAddress</option><option value="state">state</option><option value="stateAbbr">stateAbbr</option><option value="citySuffix">citySuffix</option><option value="streetSuffix">streetSuffix</option><option value="buildingNumber">buildingNumber</option><option value="city">city</option><option value="streetName">streetName</option><option value="streetAddress">streetAddress</option><option value="postcode">postcode</option><option value="address">address</option><option value="country">country</option><option value="countryCode">countryCode</option><option value="languageCode">languageCode</option><option value="currencyCode">currencyCode</option><option value="locale">locale</option><option value="emoji">emoji</option><option value="url">url</option><option value="latitude(-90, 90)">latitude(-90, 90)</option><option value="longitude(-180, 180)">longitude(-180, 180)</option><option value="phoneNumber">phoneNumber</option><option value="phoneNumberWithExtension">phoneNumberWithExtension</option><option value="tollFreePhoneNumber">tollFreePhoneNumber</option><option value="e164PhoneNumber">e164PhoneNumber</option><option value="catchPhrase">catchPhrase</option><option value="bs">bs</option><option value="company">company</option><option value="companySuffix">companySuffix</option><option value="jobTitle">jobTitle</option><option value="md5">md5</option><option value="sha1">sha1</option><option value="sha256">sha256</option></datalist><div class="form-group-icon"></div></div><p class="help" id="help-UID">The factory that will be used to generate the field form. See the datalist options for examples. See docs for more info.</p></div><div class="form-field select-field " data-type="select" style="--grid-area: schemaref;"><label for="field-UID">Schema Reference</label><div class="form-group"><select id="field-UID" name="schemaref" aria-describedby="help-UID"><option value></option><option value="https://www.totalcms.co/schemas/auth.json">auth</option><option value="https://www.totalcms.co/schemas/automation-trigger.json">automation-trigger</option><option value="https://www.totalcms.co/schemas/builder-page.json">builder-page</option><option value="https://www.totalcms.co/schemas/code.json">code</option><option value="https://www.totalcms.co/schemas/color.json">color</option><option value="https://www.totalcms.co/schemas/dataviews.json">dataviews</option><option value="https://www.totalcms.co/schemas/date.json">date</option><option value="https://www.totalcms.co/schemas/email.json">email</option><option value="https://www.totalcms.co/schemas/feed.json">feed</option><option value="https://www.totalcms.co/schemas/file.json">file</option><option value="https://www.totalcms.co/schemas/image.json">image</option><option value="https://www.totalcms.co/schemas/mailer.json">mailer</option><option value="https://www.totalcms.co/schemas/mcp-prompt-arg.json">mcp-prompt-arg</option><option value="https://www.totalcms.co/schemas/mcp-property.json">mcp-property</option><option value="https://www.totalcms.co/schemas/mcp-tool.json">mcp-tool</option><option value="https://www.totalcms.co/schemas/number.json">number</option><option value="https://www.totalcms.co/schemas/playground.json">playground</option><option value="https://www.totalcms.co/schemas/preset-item.json">preset-item</option><option value="https://www.totalcms.co/schemas/seo.json">seo</option><option value="https://www.totalcms.co/schemas/seo-collection.json">seo-collection</option><option value="https://www.totalcms.co/schemas/seo-site.json">seo-site</option><option value="https://www.totalcms.co/schemas/sitemap-meta.json">sitemap-meta</option><option value="https://www.totalcms.co/schemas/styledtext.json">styledtext</option><option value="https://www.totalcms.co/schemas/svg.json">svg</option><option value="https://www.totalcms.co/schemas/text.json">text</option><option value="https://www.totalcms.co/schemas/toggle.json">toggle</option><option value="https://www.totalcms.co/schemas/totalcms-item.json">totalcms-item</option><option value="https://www.totalcms.co/schemas/url.json">url</option><option value="https://www.totalcms.co/schemas/video.json">video</option><option value="https://www.totalcms.co/schemas/custom/widget-card.json">widget-card</option></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">The schema reference for deck or card items. Only compatible schemas are shown.</p></div><div class="form-field json-field " data-type="json" style="--grid-area: extra;" data-settings="{&quot;rows&quot;:3}"><label for="field-UID">Extra Schema Definitions</label><div class="form-group"><textarea id="field-UID" name="extra" rows="3" placeholder="{ &quot;key&quot;: &quot;value&quot; }" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Extra schema definitions for this property in valid JSON format</p></div></div></details><details class="cms-accordion "><summary>MCP Details</summary><div class="content"><div class="form-field card-field " data-type="card" style="--grid-area: mcp;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/mcp-property.json&quot;}"><input id="field-UID" type="hidden" name="mcp" value="mcp" data-proxy="true"/><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'description'
		'expose'
		'id';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'description description'
			'expose expose'
			'id id';
		grid-template-columns: repeat(2, 1fr);
	}
