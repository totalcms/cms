<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'depot';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'depot';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform custom-layout depot-drop-form formgrid" data-schema="depot" data-collection="depot" data-method="POST" data-api="/api" data-route="/collections/depot" data-id="mydepot"><div class="form-field hidden-field " data-type="hidden" style="--grid-area: id;"><div class="form-group"><input type="hidden" id="field-UID" name="id" value="mydepot" autocomplete="nofill"/></div></div><div class="form-field depotDrop-field " data-type="depotDrop" style="--grid-area: depot;"><label for="field-UID">Files</label><div class="form-group"><input id="field-UID" type="text" name="depot"/><div class="depot-drop-zone dz-clickable"><div class="dz-overlay"></div><ul class="total-preview"></ul><div class="depot-drop-upload dz-clickable"><button type="button" title="Upload Files"></button></div></div><template class="file-template"><li class="depot-drop-card"><div class="dz-preview"><div class="file-icon"></div><p class="filename"></p></div></li></template></div><p class="help" id="help-UID">Drag and drop files here.</p></div><div class="form-inline-fields"></div></form></div>