<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'date';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'date';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  formgrid" data-schema="date" data-collection="date" data-method="POST" data-api="/api" data-route="/collections/date"><div class="form-field id-field " data-type="id" style="--grid-area: id;"><label for="field-UID">Date ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required aria-describedby="help-UID" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">A unique ID for this date. No spaces or special characters.</p></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: date;"><label for="field-UID">Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="date" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The date to use.</p></div><div class="form-inline-fields"></div></form></div>