<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'file';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id'
			'file';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  formgrid" data-schema="file" data-collection="file" data-method="POST" data-api="/api" data-route="/collections/file"><div class="form-field id-field " data-type="id" style="--grid-area: id;"><label for="field-UID">File ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required aria-describedby="help-UID" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">A unique ID for this file. No spaces or special characters.</p></div><div class="form-field file-field " data-type="file" style="--grid-area: file;"><label for="field-UID">File</label><div class="form-group"><input id="field-UID" type="text" name="file" data-proxy="true"/><div class="dz-overlay dz-clickable"></div><div class="total-preview"><div class="file-preview"><div class="dz-preview dz-file-preview not-found">
	<div class="actionbar">
		<button type="button" class="edit" title="Edit File Info"></button>
		<button type="button" class="links" title="Download Links"></button>
		<button type="button" class="download" title="Download File"></button>
		<button type="button" class="upload dz-clickable" title="Upload New File"></button>
		<button type="button" class="trash" title="Delete File"></button>
	</div>

	<div class="file-icon icon-"></div>
	<p class="filename"></p>

	<div class="dz-progress">
		<span class="dz-upload" data-dz-uploadprogress></span>
		<span class="dz-upload-progress-label" data-dz-uploadprogress>0%</span>
		<div class="dz-status"></div>
	</div>
</div><dialog class="cms-modal file-edit-dialog"><section class="scroller"><details class="cms-accordion "><summary>Info</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: download;"><label for="field-UID">Download Name</label><div class="form-group"><input type="text" id="field-UID" name="download" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name of the file when it gets downloaded.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: comments;"><label for="field-UID">Comments</label><div class="form-group"><textarea id="field-UID" name="comments" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Comments about this file</p></div><div class="form-field list-field " data-type="list" style="--grid-area: tags;" data-settings="{&quot;propertyOptions&quot;:{&quot;source&quot;:&quot;mediaTags&quot;,&quot;field&quot;:&quot;file&quot;,&quot;type&quot;:&quot;file&quot;}}"><label for="field-UID">Tags</label><div class="form-group"><select id="field-UID" name="tags" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Add tags to help organize your files.</p></div></div></details><details class="cms-accordion "><summary>Protection</summary><div class="content"><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: protected;"><div class="form-group"><input id="field-UID" name="protected" type="checkbox" aria-describedby="help-UID" checked/><label for="field-UID">Protected by Collection</label></div><p class="help" id="help-UID">Access group protection is set in the Collection.</p></div><div class="form-field password-field " data-type="password" style="--grid-area: password;" data-settings="{&quot;ignoreManagers&quot;:true}"><label for="field-UID">Password</label><div class="form-group"><input type="password" id="field-UID" name="password" aria-describedby="help-UID" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true"/><div class="form-group-icon"></div></div><div class="form-group"><input type="password" id="field-UID-confirm" name="password-confirm" aria-describedby="help-UID" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Require a password to download this file. This overrides all collection level access controls.</p></div></div></details><details class="cms-accordion "><summary>Meta (Readonly)</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Filename</label><div class="form-group"><input type="text" id="field-UID" name="name" readonly autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: ext;"><label for="field-UID">Extension</label><div class="form-group"><input type="text" id="field-UID" name="ext" readonly autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: size;"><label for="field-UID">Size</label><div class="form-group"><input type="number" id="field-UID" name="size" readonly inputmode="numeric" value="0" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: count;"><label for="field-UID">Download Count</label><div class="form-group"><input type="number" id="field-UID" name="count" readonly inputmode="numeric" value="0" autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: mime;"><label for="field-UID">MIME Type</label><div class="form-group"><input type="text" id="field-UID" name="mime" readonly autocomplete="nofill"/></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: uploadDate;"><label for="field-UID">Upload Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="uploadDate" readonly autocomplete="nofill"/></div></div></div></details></section><section><button type="button" class="button btn close">Close</button></section></dialog><dialog class="cms-modal file-links-dialog"><iframe style="width:100%;height:100%" data-src="/admin/filelinks?collection=file&amp;property=file" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" class="cms-iframe "></iframe></dialog></div></div><template id="template-UID"><div class="file-preview"><div class="dz-preview dz-file-preview not-found">
	<div class="actionbar">
		<button type="button" class="edit" title="Edit File Info"></button>
		<button type="button" class="links" title="Download Links"></button>
		<button type="button" class="download" title="Download File"></button>
		<button type="button" class="upload dz-clickable" title="Upload New File"></button>
		<button type="button" class="trash" title="Delete File"></button>
	</div>

	<div class="file-icon icon-"></div>
	<p class="filename"></p>

	<div class="dz-progress">
		<span class="dz-upload" data-dz-uploadprogress></span>
		<span class="dz-upload-progress-label" data-dz-uploadprogress>0%</span>
		<div class="dz-status"></div>
	</div>
</div><dialog class="cms-modal file-edit-dialog"><section class="scroller"><details class="cms-accordion "><summary>Info</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: download;"><label for="field-UID">Download Name</label><div class="form-group"><input type="text" id="field-UID" name="download" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The name of the file when it gets downloaded.</p></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: comments;"><label for="field-UID">Comments</label><div class="form-group"><textarea id="field-UID" name="comments" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea><div class="form-group-icon"></div></div><p class="help" id="help-UID">Comments about this file</p></div><div class="form-field list-field " data-type="list" style="--grid-area: tags;" data-settings="{&quot;propertyOptions&quot;:{&quot;source&quot;:&quot;mediaTags&quot;,&quot;field&quot;:&quot;file&quot;,&quot;type&quot;:&quot;file&quot;}}"><label for="field-UID">Tags</label><div class="form-group"><select id="field-UID" name="tags" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Add tags to help organize your files.</p></div></div></details><details class="cms-accordion "><summary>Protection</summary><div class="content"><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: protected;"><div class="form-group"><input id="field-UID" name="protected" type="checkbox" aria-describedby="help-UID" checked/><label for="field-UID">Protected by Collection</label></div><p class="help" id="help-UID">Access group protection is set in the Collection.</p></div><div class="form-field password-field " data-type="password" style="--grid-area: password;" data-settings="{&quot;ignoreManagers&quot;:true}"><label for="field-UID">Password</label><div class="form-group"><input type="password" id="field-UID" name="password" aria-describedby="help-UID" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true"/><div class="form-group-icon"></div></div><div class="form-group"><input type="password" id="field-UID-confirm" name="password-confirm" aria-describedby="help-UID" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Require a password to download this file. This overrides all collection level access controls.</p></div></div></details><details class="cms-accordion "><summary>Meta (Readonly)</summary><div class="content"><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Filename</label><div class="form-group"><input type="text" id="field-UID" name="name" readonly autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: ext;"><label for="field-UID">Extension</label><div class="form-group"><input type="text" id="field-UID" name="ext" readonly autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: size;"><label for="field-UID">Size</label><div class="form-group"><input type="number" id="field-UID" name="size" readonly inputmode="numeric" value="0" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: count;"><label for="field-UID">Download Count</label><div class="form-group"><input type="number" id="field-UID" name="count" readonly inputmode="numeric" value="0" autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: mime;"><label for="field-UID">MIME Type</label><div class="form-group"><input type="text" id="field-UID" name="mime" readonly autocomplete="nofill"/></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: uploadDate;"><label for="field-UID">Upload Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="uploadDate" readonly autocomplete="nofill"/></div></div></div></details></section><section><button type="button" class="button btn close">Close</button></section></dialog><dialog class="cms-modal file-links-dialog"><iframe style="width:100%;height:100%" data-src="/admin/filelinks?collection=file&amp;property=file" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" class="cms-iframe "></iframe></dialog></div></template></div><p class="help" id="help-UID">Drag and drop a file here.</p></div><div class="form-inline-fields"></div></form></div>