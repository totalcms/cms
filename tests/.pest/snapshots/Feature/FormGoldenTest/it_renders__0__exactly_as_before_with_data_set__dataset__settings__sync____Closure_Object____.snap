<form class="totalform help-on-hover help-box" data-method="POST" data-route="/admin/settings/sync"><div class="form-field text-field " data-type="text" style="--grid-area: url;"><label for="field-UID">Production Server API</label><div class="form-group"><input type="text" id="field-UID" name="url" placeholder="https://example.com/tcms" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">The URL of your production Total CMS installation.</p></div><div class="form-field secret-field " data-type="secret" style="--grid-area: key;"><label for="field-UID">API Key</label><div class="form-group"><input type="password" id="field-UID" name="key" placeholder="your-api-key" aria-describedby="help-UID" autocomplete="off" data-1p-ignore data-lpignore="true"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">An API key from the production server with import/export permissions.</p></div><div class="form-inline-fields"><button type="submit" class="button btn cms-save cms-button">Save Settings</button></div></form>