</button><button type="button" class="button btn cancel cms-button transparent no-icon">Discard Changes</button></section></dialog><dialog class="cms-modal image-link-dialog"><iframe style="width:100%;height:100%" data-src="/admin/imageworks?id=myblog&amp;collection=blog&amp;property=gallery" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" class="cms-iframe "></iframe></dialog></div></template><script type="application/json" id="gallery-data-UID">[]</script><div class="gallery-upload dz-clickable"><button type="button" title="Upload New Image"></button></div></div><p class="help" id="help-UID">Gallery of images for this post</p></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: updated;" data-settings="{&quot;onUpdate&quot;:true,&quot;readonly&quot;:true}"><label for="field-UID">Updated Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="updated" required readonly aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Blog Post updated date</p></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: created;" data-settings="{&quot;onCreate&quot;:true,&quot;readonly&quot;:true}"><label for="field-UID">Creation Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="created" required readonly aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Blog Post creation date</p></div><div class="form-inline-fields"></div></form></div>