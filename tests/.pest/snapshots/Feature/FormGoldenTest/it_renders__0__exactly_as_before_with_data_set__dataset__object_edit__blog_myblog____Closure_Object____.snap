<style>
#form-ID-container {
	container-type: inline-size;
}
#form-ID {
	grid-template-areas:
		'id'
		'title'
		'draft'
		'featured'
		'date'
		'author'
		'image'
		'categories'
		'tags'
		'summary'
		'content'
		'media'
		'gallery'
		'extra'
		'updated'
		'created';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#form-ID {
		grid-template-areas:
			'id id'
			'title title'
			'draft featured'
			'date author'
			'image image'
			'categories categories'
			'tags tags'
			'summary summary'
			'content content'
			'media media'
			'gallery gallery'
			'extra extra'
			'updated created';
		grid-template-columns: repeat(2, 1fr);
	}
}
</style><div id="form-ID-container"><form id="form-ID" class="totalform  formgrid" data-schema="blog" data-collection="blog" data-method="POST" data-api="/api" data-route="/collections/blog" data-id="myblog"><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: draft;"><div class="form-group"><input id="field-UID" name="draft" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Draft</label></div><p class="help" id="help-UID">Mark this post as a draft</p></div><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: featured;"><div class="form-group"><input id="field-UID" name="featured" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Featured</label></div><p class="help" id="help-UID">Mark this post as featured</p></div><div class="form-field id-field " data-type="id" style="--grid-area: id;" data-settings="{&quot;autogen&quot;:&quot;${title}&quot;}"><label for="field-UID">Blog Post ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required readonly aria-describedby="help-UID" value="myblog" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">A unique ID for this post. No spaces or special characters.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: title;"><label for="field-UID">Title</label><div class="form-group"><input type="text" id="field-UID" name="title" required aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Blog Post title</p></div><div class="form-field date-field " data-type="date" style="--grid-area: date;"><label for="field-UID">Date</label><div class="form-group"><input type="date" id="field-UID" name="date" aria-describedby="help-UID" value="TODAY" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Blog Post date</p></div><div class="form-field text-field " data-type="text" style="--grid-area: author;" data-settings="{&quot;propertyOptions&quot;:true}"><label for="field-UID">Author</label><div class="form-group"><input type="text" id="field-UID" name="author" aria-describedby="help-UID" list="datalist-UID" autocomplete="nofill"/><datalist id="datalist-UID"></datalist><div class="form-group-icon"></div></div><p class="help" id="help-UID">Author for this post</p></div><div class="form-field styledtext-field " data-type="styledtext" style="--grid-area: summary;"><label for="field-UID">Summary</label><div class="form-group"><div class="styledtext-wrapper"><textarea id="field-UID" name="summary" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea></div><div class="form-group-icon"></div></div><p class="help" id="help-UID">Blog Post summary</p></div><div class="form-field url-field " data-type="url" style="--grid-area: media;"><label for="field-UID">Media</label><div class="form-group"><input type="url" id="field-UID" name="media" inputmode="url" aria-describedby="help-UID" autocomplete="nofill" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Media URL for this post</p></div><div class="form-field styledtext-field " data-type="styledtext" style="--grid-area: content;"><label for="field-UID">Content</label><div class="form-group"><div class="styledtext-wrapper"><textarea id="field-UID" name="content" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea></div><div class="form-group-icon"></div></div><p class="help" id="help-UID">Main blog post content</p></div><div class="form-field styledtext-field " data-type="styledtext" style="--grid-area: extra;"><label for="field-UID">Extra Content</label><div class="form-group"><div class="styledtext-wrapper"><textarea id="field-UID" name="extra" rows="8" autocomplete="off" aria-describedby="help-UID"></textarea></div><div class="form-group-icon"></div></div><p class="help" id="help-UID">Extra content area for this post</p></div><div class="form-field list-field " data-type="list" style="--grid-area: categories;" data-settings="{&quot;propertyOptions&quot;:true}"><label for="field-UID">Categories</label><div class="form-group"><select id="field-UID" name="categories" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">A list of categories for this post</p></div><div class="form-field list-field " data-type="list" style="--grid-area: tags;" data-settings="{&quot;propertyOptions&quot;:true}"><label for="field-UID">Tags</label><div class="form-group"><select id="field-UID" name="tags" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">A list of tags for this post</p></div><div class="form-field image-field " data-type="image" style="--grid-area: image;"><label for="field-UID">Image</label><div class="form-group"><input id="field-UID" type="text" name="image" data-proxy="true"/><div class="dz-overlay dz-clickable"></div><div class="total-preview"><div class="image-preview"><div class="dz-preview dz-file-preview not-found">
	<div class="actionbar">
		<button type="button" class="edit"     title="Edit Image Info"></button>
		<button type="button" class="links"    title="Image URL"></button>
		<button type="button" class="featured" title="Toggle Featured"></button>
		<button type="button" class="download" title="Download Original Image"></button>
		<button type="button" class="move"     title="Reorder Image"></button>
		<button type="button" class="upload dz-clickable" title="Upload New Image"></button>
		<button type="button" class="clear"    title="Clear Cache"></button>
		<button type="button" class="trash"    title="Delete Image"></button>
	</div>
	<img src="" alt="" onload="this.parentNode.classList.remove('not-found')" oncontextmenu="return false;" draggable="false" data-dz-thumbnail />
	<div class="dz-progress">
		<span class="dz-upload" data-dz-uploadprogress></span>
		<span class="dz-upload-progress-label" data-dz-uploadprogress>0%</span>
		<div class="dz-status"></div>
	</div>
</div><dialog class="cms-modal split-view image-edit-dialog"><section class="image-preview"><img src oncontextmenu="return false;" draggable="false" data-dz-thumbnail/><div class="focal-point" style="top:50%;left:50%"></div></section><section class="scroller"><details class="cms-accordion "><summary>Info</summary><div class="content"><div class="form-field checkbox-field " data-type="checkbox" style="--grid-area: featured;"><div class="form-group"><input id="field-UID" name="featured" type="checkbox" aria-describedby="help-UID"/><label for="field-UID">Featured</label></div><p class="help" id="help-UID">Mark this image as featured.</p></div><div class="form-field text-field " data-type="text" style="--grid-area: alt;"><label for="field-UID">Alt Text</label><div class="form-group"><input type="text" id="field-UID" name="alt" placeholder="Enter Alt Text" aria-describedby="help-UID" autocomplete="nofill"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Alt text is used by screen readers and search engines to describe the image.</p></div><div class="form-field url-field " data-type="url" style="--grid-area: link;"><label for="field-UID">Link</label><div class="form-group"><input type="url" id="field-UID" name="link" inputmode="url" placeholder="https://example.com" aria-describedby="help-UID" autocomplete="nofill" autocapitalize="off"/><div class="form-group-icon"></div></div><p class="help" id="help-UID">Enter a URL to link the image to.</p></div><div class="form-field list-field " data-type="list" style="--grid-area: tags;" data-settings="{&quot;propertyOptions&quot;:{&quot;source&quot;:&quot;mediaTags&quot;,&quot;field&quot;:&quot;image&quot;,&quot;type&quot;:&quot;image&quot;}}"><label for="field-UID">Tags</label><div class="form-group"><select id="field-UID" name="tags" multiple size="1" aria-describedby="help-UID"></select><div class="form-group-icon"></div></div><p class="help" id="help-UID">Add tags to help organize your images.</p></div></div></details><details class="cms-accordion "><summary>Focal Point</summary><div class="content"><div class="form-field range-field " data-type="range" style="--grid-area: focalpoint-x;"><label for="field-UID">Focal Point X</label><div class="form-group"><input type="range" id="field-UID" name="focalpoint-x" aria-describedby="help-UID" value="50" autocomplete="nofill"/><div class="range-value" id="value-UID">50</div></div><p class="help" id="help-UID">Set the horizontal focal point coordinate of the image.</p></div><div class="form-field range-field " data-type="range" style="--grid-area: focalpoint-y;"><label for="field-UID">Focal Point Y</label><div class="form-group"><input type="range" id="field-UID" name="focalpoint-y" aria-describedby="help-UID" value="50" autocomplete="nofill"/><div class="range-value" id="value-UID">50</div></div><p class="help" id="help-UID">Set the vertical focal point coordinate of the image.</p></div></div></details><details class="cms-accordion "><summary>EXIF - Info</summary><div class="content"><div class="form-field datetime-field " data-type="datetime" style="--grid-area: exif-date;"><label for="field-UID">Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="exif-date" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field " data-type="text" style="--grid-area: exif-title;"><label for="field-UID">Title</label><div class="form-group"><input type="text" id="field-UID" name="exif-title" placeholder="No Title Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-user" data-type="text" style="--grid-area: exif-author;"><label for="field-UID">Author</label><div class="form-group"><input type="text" id="field-UID" name="exif-author" placeholder="No Author Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-copyright" data-type="text" style="--grid-area: exif-copyright;"><label for="field-UID">Copyright</label><div class="form-group"><input type="text" id="field-UID" name="exif-copyright" placeholder="No Copyright Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field textarea-field " data-type="textarea" style="--grid-area: exif-description;"><label for="field-UID">Description</label><div class="form-group"><textarea id="field-UID" name="exif-description" rows="3" placeholder="No Description Found" autocomplete="off" data-autosize style="--rows:3"></textarea><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>EXIF - Camera</summary><div class="content"><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-make;"><label for="field-UID">Make</label><div class="form-group"><input type="text" id="field-UID" name="exif-make" placeholder="Camera Make Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-camera;"><label for="field-UID">Model</label><div class="form-group"><input type="text" id="field-UID" name="exif-camera" placeholder="Camera Model Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-camera" data-type="text" style="--grid-area: exif-lens;"><label for="field-UID">Lens</label><div class="form-group"><input type="text" id="field-UID" name="exif-lens" placeholder="Lens Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-focalLength;"><label for="field-UID">Focal Length</label><div class="form-group"><input type="number" id="field-UID" name="exif-focalLength" inputmode="decimal" placeholder="Focal Length Not Found" step="any" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-aperture;"><label for="field-UID">Aperture</label><div class="form-group"><input type="number" id="field-UID" name="exif-aperture" inputmode="decimal" placeholder="Aperture Not Found" step="any" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field number-field icon-shutter" data-type="number" style="--grid-area: exif-iso;"><label for="field-UID">ISO</label><div class="form-group"><input type="number" id="field-UID" name="exif-iso" inputmode="decimal" placeholder="ISO Not Found" step="any" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-shutter" data-type="text" style="--grid-area: exif-shutterSpeed;"><label for="field-UID">Shutter Speed</label><div class="form-group"><input type="text" id="field-UID" name="exif-shutterSpeed" placeholder="Shutter Speed Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>EXIF - Location</summary><div class="content"><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-country;"><label for="field-UID">Country</label><div class="form-group"><input type="text" id="field-UID" name="exif-country" placeholder="Country Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-state;"><label for="field-UID">State/Province</label><div class="form-group"><input type="text" id="field-UID" name="exif-state" placeholder="State or Province Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-city;"><label for="field-UID">City</label><div class="form-group"><input type="text" id="field-UID" name="exif-city" placeholder="City Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-sublocation;"><label for="field-UID">Sub-Location</label><div class="form-group"><input type="text" id="field-UID" name="exif-sublocation" placeholder="Sub-Location Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><hr/><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-longitude;"><label for="field-UID">Longitude</label><div class="form-group"><input type="text" id="field-UID" name="exif-longitude" placeholder="Longitude Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-latitude;"><label for="field-UID">Latitude</label><div class="form-group"><input type="text" id="field-UID" name="exif-latitude" placeholder="Latitude Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div><div class="form-field text-field icon-gps" data-type="text" style="--grid-area: exif-altitude;"><label for="field-UID">Altitude</label><div class="form-group"><input type="text" id="field-UID" name="exif-altitude" placeholder="Altitude Not Found" autocomplete="nofill"/><div class="form-group-icon"></div></div></div></div></details><details class="cms-accordion "><summary>Color Palette</summary><div class="content"><div class="palette"><div class="form-field color-field " data-type="color" style="--grid-area: palette-0;"><div class="form-group"><input id="field-UID" name="palette-0" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-1;"><div class="form-group"><input id="field-UID" name="palette-1" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-2;"><div class="form-group"><input id="field-UID" name="palette-2" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-3;"><div class="form-group"><input id="field-UID" name="palette-3" type="color"/></div></div><div class="form-field color-field " data-type="color" style="--grid-area: palette-4;"><div class="form-group"><input id="field-UID" name="palette-4" type="color"/></div></div></div></div></details><details class="cms-accordion "><summary>Meta (Readonly)</summary><div class="content"><div class="form-field number-field " data-type="number" style="--grid-area: height;"><label for="field-UID">Height</label><div class="form-group"><input type="number" id="field-UID" name="height" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: width;"><label for="field-UID">Width</label><div class="form-group"><input type="number" id="field-UID" name="width" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field number-field " data-type="number" style="--grid-area: size;"><label for="field-UID">Size</label><div class="form-group"><input type="number" id="field-UID" name="size" readonly inputmode="numeric" autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: name;"><label for="field-UID">Filename</label><div class="form-group"><input type="text" id="field-UID" name="name" readonly autocomplete="nofill"/></div></div><div class="form-field text-field " data-type="text" style="--grid-area: mime;"><label for="field-UID">MIME Type</label><div class="form-group"><input type="text" id="field-UID" name="mime" readonly autocomplete="nofill"/></div></div><div class="form-field datetime-field " data-type="datetime" style="--grid-area: uploadDate;"><label for="field-UID">Upload Date</label><div class="form-group"><input type="datetime-local" id="field-UID" name="uploadDate" readonly autocomplete="nofill"/></div></div></div></details></section><section class="dialog-actions"><button type="button" class="button btn close cms-button no-icon">Save</button><button type="button" class="button btn cancel cms-button transparent no-icon">Discard Changes</button></section></dialog><dialog class="cms-modal image-link-dialog"><iframe style="width:100%;height:100%" data-src="/admin/imageworks?id=myblog&amp;collection=blog&amp;property=image" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" class="cms-iframe "></iframe></dialog></div></div><template id="template-UID"><div class="image-preview"><div class="dz-preview dz-file-preview not-found">
