<form class="totalform help-on-hover help-box" data-method="POST" data-route="/admin/settings/presets"><div class="form-field deck-field " data-type="deck" style="--grid-area: presetsettings;" data-settings="{&quot;schemaref&quot;:&quot;https:\/\/www.totalcms.co\/schemas\/preset-item.json&quot;}"><label for="field-UID">Property Setting Presets</label><div class="form-group"><input id="field-UID" type="text" name="presetsettings" value="presetsettings" data-proxy="true"/><template class="deck-template"><div class="deck-item deck-item-" data-deck-label-pattern="${id}"><button type="button" class="button btn deck-item-label sort-handle"></button><button type="button" class="button btn edit" title="Edit  item"></button><button type="button" class="button btn duplicate" title="Duplicate  item"></button><button type="button" class="button btn trash" title="Delete  item"></button><dialog class="cms-modal small"><section class="scroller"><style>
#formgrid-ID-container {
	container-type: inline-size;
}
#formgrid-ID {
	grid-template-areas:
		'id'
		'settings';
	grid-template-columns: 1fr;
}
@container (min-width: 500px) {
	#formgrid-ID {
		grid-template-areas:
			'id'
			'settings';
		grid-template-columns: repeat(1, 1fr);
	}
}
</style><div id="formgrid-ID-container"><div id="formgrid-ID" class="formgrid"><div class="form-field id-field " data-type="id" style="--grid-area: id;"><label for="field-UID">Preset ID</label><div class="form-group"><input type="text" id="field-UID" name="id" required placeholder="styledtext-simple" autocomplete="off" data-1p-ignore data-lpignore="true" autocapitalize="off"/><div class="form-group-icon"></div></div></div><div class="form-field json-field " data-type="json" style="--grid-area: settings;" data-settings="{&quot;rows&quot;:20}"><label for="field-UID">Settings</label><div class="form-group"><textarea id="field-UID" name="settings" required rows="20" placeholder="{&quot;height&quot;: 400, &quot;wordCounterCount&quot;: true}" autocomplete="off" data-autosize style="--rows:20"></textarea><div class="form-group-icon"></div></div></div></div></div></section><section><button type="button" class="button btn close">Close</button></section></dialog></div></template><button type="button" title="Add Item" class="button btn cms-add"></button></div><p class="help" id="help-UID">Named presets of property settings. Each preset has a name and a settings object. Reference in any property with {"preset": "name"}</p></div><div class="form-inline-fields"><button type="submit" class="button btn cms-save cms-button">Save Settings</button></div></form>