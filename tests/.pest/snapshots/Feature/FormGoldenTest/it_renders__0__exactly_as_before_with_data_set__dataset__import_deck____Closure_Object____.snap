<form class="simple-form totalform import-form" data-route="/import/collections/widgets/deck/csv" data-method="POST" data-api="/api" data-refresh="true" data-ajax="true"><div><label for="object">Object</label><select name="object" id="object" required><option value>Select an object...</option><option value="w1">Widget</option></select></div><div><label for="property">Deck Property</label><select name="property" id="property" required><option value>Select a deck property...</option><option value="mydeck">mydeck</option></select></div><div><label for="csv">CSV File</label><input type="file" name="csv" id="csv"/></div><div class="checkbox-field"><input type="checkbox" name="update" id="deck-update"/><label for="deck-update">Update Existing Items</label></div><div class="form-inline-fields"><button type="submit" class="button btn dash-button ">Import into Deck</button></div></form>