# No directory listings, and no content negotiation guessing at file names
Options -MultiViews -Indexes

# Security headers for every page, the public site included. The admin sets
# its own (SecurityHeadersMiddleware), and setifempty leaves those alone.
# SAMEORIGIN stops other sites framing your pages (clickjacking a contact or
# sign-up form); delete that line if another site has to embed yours.
<IfModule mod_headers.c>
	Header setifempty X-Frame-Options "SAMEORIGIN"
	Header setifempty X-Content-Type-Options "nosniff"
	Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
	# Only once HTTPS works everywhere on this domain: browsers remember it for a year.
	# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

RewriteEngine On

# Compute this directory's URL prefix dynamically (equivalent to RewriteBase,
# but with no hardcoded path). Some hosts cannot reverse-map relative rewrite
# substitutions in per-directory context (e.g. IONOS symlinked docroots), so
# rewrites there silently 404 without an explicit base.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=TCMS_BASE:%1]

# Don't rewrite if "public/" is already in the path
RewriteCond %{REQUEST_URI} !public/
RewriteRule ^$ %{ENV:TCMS_BASE}public/ [L]

RewriteCond %{REQUEST_URI} !public/
RewriteRule ^(.*)$ %{ENV:TCMS_BASE}public/$1 [L]
