# Tests use /tests/tcms-data/ as a fully-mutable runtime sandbox. The
# canonical fixture data lives at /tests/tcms-data-fixtures/ and is copied
# in by tests/Pest.php::restoreFixtures() (called from recursiveDelete()
# whenever the root dir is wiped). Nothing under /tests/tcms-data/ is
# tracked.
/tests/tcms-data

# Internal working docs — planning specs and pre-release audit reports.
# Kept local-only (also already export-ignore'd from the Composer package).
# Audit reports in particular can contain unpatched-vulnerability detail.
/docs/planning
/docs/audits
/docs/superpowers
graphify-out/

# Mermaid ships a lazy chunk per diagram type; the data visualizers only render
# erDiagram (Collection Visualizer) and flowchart (Object Visualizer), so the
# other renderers are emitted by the build but never loaded. Keep them out of git
# (computed from mermaid.core's import graph minus erDiagram + flowDiagram + our
# own code — see docs/planning/data-visualizers.md).
/public/assets/architecture-*
/public/assets/architectureDiagram-*
/public/assets/blockDiagram-*
/public/assets/c4Diagram-*
/public/assets/classDiagram-*
/public/assets/diagram-*
/public/assets/eventmodeling-*
/public/assets/ganttDiagram-*
/public/assets/gitGraph-*
/public/assets/gitGraphDiagram-*
/public/assets/info-*
/public/assets/infoDiagram-*
