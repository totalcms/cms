{% extends 'layouts/default.twig' %}

{% block content %}
<section class="masthead hero">
	<div class="container">
		<h1>Clear plans, good design, and software that keeps working.</h1>
		<p>We help businesses grow with modern solutions, from the first plan to the years of support after launch.</p>
		<div class="hero-actions">
			<a class="button" href="/contact">Start a project</a>
			<a class="button button-ghost" href="/services">See our services</a>
		</div>
		{% set readmeUrl = cms.builder.url('readme') %}
		{% if readmeUrl %}
			<a class="guide-link" href="{{ readmeUrl }}">New here? Read the Getting Started guide</a>
		{% endif %}
	</div>
</section>

{# The cards come from the Services collection, in the order set on each service. #}
<section class="container">
	<div class="service-cards">
		{% for service in cms.collection.query('services', {sort: 'order:asc'}).objects %}
			<a class="service-card" href="/services#{{ service.id }}">
				{{ cms.render.image(service.id, {w: 640, h: 360, fit: 'crop'}, {collection: 'services', alt: ''}) }}
				<div class="body">
					{% if service.icon %}<span class="icon" aria-hidden="true">{{ service.icon }}</span>{% endif %}
					<h3>{{ service.title }}</h3>
					<p>{{ service.summary }}</p>
				</div>
			</a>
		{% endfor %}
	</div>
</section>

<section class="cta">
	<div class="container">
		<div>
			<h2>Have a project in mind?</h2>
			<p>Tell us what you're working on. We reply within one business day.</p>
		</div>
		<a class="button" href="/contact">Contact us</a>
	</div>
</section>
{% endblock %}
