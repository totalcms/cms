{% extends 'layouts/default.twig' %}

{% block content %}
<section class="masthead">
	<div class="container">
		<h1>Our Services</h1>
		<p>We offer a range of services to help your business grow. Pick one, or let us put a plan together for you.</p>
	</div>
</section>

{# One row per service from the Services collection. Edit them under Collections → Services. #}
<section class="service-list container">
	{% for entry in cms.collection.query('services', {sort: 'order:asc'}).objects %}
		{% set service = cms.collection.object('services', entry.id) %}
		<article class="service-row" id="{{ service.id }}">
			{{ cms.render.image(service, {w: 1120, h: 700, fit: 'crop'}, {collection: 'services', alt: '', class: 'service-art'}) }}
			<div>
				{% if service.icon %}<span class="icon" aria-hidden="true">{{ service.icon }}</span>{% endif %}
				<h2>{{ service.title }}</h2>
				<p class="summary">{{ service.summary }}</p>
				<div class="description">{{ service.description|raw }}</div>
			</div>
		</article>
	{% endfor %}
</section>

<section class="cta">
	<div class="container">
		<div>
			<h2>Not sure which one you need?</h2>
			<p>Tell us about your business and we'll suggest where to start.</p>
		</div>
		<a class="button" href="/contact">Contact us</a>
	</div>
</section>
{% endblock %}
