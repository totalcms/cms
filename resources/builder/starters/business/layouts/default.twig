<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	{# Title, description, canonical, Open Graph, Twitter and JSON-LD for this page — from the page's SEO card, then the page fields, then Settings → SEO. Override {% block seo %} on a page to pass a collection object instead. #}
	{% block seo %}{{ cms.seo.head(page|default(null)) }}{% endblock %}
	{# Total CMS core styles: {% cmsgrid %} grids (e.g. Services), galleries, and pagination controls. Placed ahead of the site stylesheet so your branding always takes precedence over the defaults. #}
	{{ cms.assetsHead() }}
	{# Site stylesheet at <docroot>/assets/style.css. Edit it directly — cms.builder.css adds an mtime cache-buster automatically. #}
	{{ cms.builder.css('style.css') }}
	{% block head %}{% endblock %}
</head>
<body>
	{% include 'partials/nav.twig' %}

	<main>
		{% block content %}{% endblock %}
	</main>

	{% include 'partials/footer.twig' %}

	{# Total CMS core scripts, including htmx, which powers the Load More button used on longer listings. Take this out and Load More has nothing left to drive it. #}
	{{ cms.assetsBody() }}
</body>
</html>
