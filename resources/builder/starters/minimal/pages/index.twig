{% extends 'layouts/default.twig' %}

{% block content %}
<section class="hero container">
	<div>
		<h1>Hello. This is your new site.</h1>
		<p>One page, one layout and one stylesheet. Change the words in Site Builder, upload your own picture, and make it yours.</p>
		<div class="hero-actions">
			<a class="button" href="/admin/builder">Open Site Builder</a>
			{% set readmeUrl = cms.builder.url('readme') %}
			{% if readmeUrl %}
				<a href="{{ readmeUrl }}">Read the Getting Started guide</a>
			{% endif %}
		</div>
	</div>

	{# The picture is the "hero" object in the Images collection. Upload your own there. #}
	{{ cms.render.image('hero', {w: 1200, h: 900, fit: 'crop'}, {alt: '', class: 'hero-art', loading: 'eager'}) }}
</section>
{% endblock %}
