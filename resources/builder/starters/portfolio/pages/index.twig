{% extends 'layouts/default.twig' %}

{% block content %}
<section class="intro container">
	<h1>Hello, I'm a designer and developer.</h1>
	<p>I craft digital experiences that are thoughtful, functional, and beautiful. Take a look at my work below.</p>
	{% set readmeUrl = cms.builder.url('readme') %}
	{% if readmeUrl %}
		<a class="guide-link" href="{{ readmeUrl }}">New here? Read the Getting Started guide</a>
	{% endif %}
</section>

{# Projects ticked Featured in the Projects collection. The first one shows large. #}
<section class="container">
	<div class="featured">
		{% set featured = cms.collection.query('projects', {
			filter: [{property: 'featured', operator: 'istrue'}],
			sort: 'order:asc',
			limit: 3
		}).objects %}
		{% for project in featured %}
			<a class="project" href="/work#{{ project.id }}">
				{{ cms.render.image(project.id, loop.first ? {w: 1600, h: 1200, fit: 'crop'} : {w: 800, h: 600, fit: 'crop'}, {collection: 'projects', alt: '', loading: loop.first ? 'eager' : 'lazy'}) ?: '<div class="no-image"></div>' }}
				<figcaption>
					<h2>{{ project.title }}</h2>
					<p>{{ project.summary }}</p>
				</figcaption>
			</a>
		{% endfor %}
	</div>
	<a class="more-work" href="/work">View all work</a>
</section>
{% endblock %}
