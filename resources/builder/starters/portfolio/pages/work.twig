{% extends 'layouts/default.twig' %}

{% block content %}
<section class="intro container">
	<h1>Work</h1>
	<p>A selection of projects I have worked on. Each one presented unique challenges and opportunities.</p>
</section>

{# Every project in the Projects collection, in display order. #}
<section class="container">
	<div class="work-grid">
		{% for project in cms.collection.query('projects', {sort: 'order:asc'}).objects %}
			<figure class="project" id="{{ project.id }}">
				{{ cms.render.image(project.id, {w: 1200, h: 900, fit: 'crop'}, {collection: 'projects'}) ?: '<div class="no-image"></div>' }}
				<figcaption>
					<h2>{{ project.title }}</h2>
					<p>{{ project.summary }}</p>
				</figcaption>
			</figure>
		{% endfor %}
	</div>
</section>
{% endblock %}
