{% extends 'layouts/default.twig' %}

{% block content %}
{% set readmeUrl = cms.builder.url('readme') %}
{% if readmeUrl %}
	<p class="guide-note">New here? Read the <a href="{{ readmeUrl }}">Getting Started guide</a> to learn how this starter works.</p>
{% endif %}

<div class="container">
	{% set posts = cms.collection.query('blog', {sort: 'date:desc', limit: 5}).objects %}

	{# The newest post leads, with a large picture. #}
	{% for post in posts|slice(0, 1) %}
		{% include 'partials/post-lead.twig' with {post: post} %}
	{% else %}
		<section class="prose narrow">
			<h1>No posts yet</h1>
			<p>Add your first post under Collections → Blog in the admin.</p>
		</section>
	{% endfor %}

	{% if posts|length > 1 %}
		<h2 class="section-title">More stories</h2>
		<div class="post-grid">
			{% for post in posts|slice(1) %}
				{% include 'partials/post-card.twig' with {post: post} %}
			{% endfor %}
		</div>
		<a class="all-posts" href="/blog">All posts</a>
	{% endif %}
</div>
{% endblock %}
