<header class="masthead">
	<div class="container">
		<a class="site-name" href="/">{{ cms.config('domain') }}</a>
		<nav>
			<ul>
				{% for p in cms.builder.nav() %}
					<li><a href="{{ p.route }}"{% if page is defined and page.route == p.route %} aria-current="page"{% endif %}>{{ p.title }}</a></li>
				{% endfor %}
			</ul>
		</nav>
	</div>
</header>
