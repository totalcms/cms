#!/usr/bin/env php
<?php

declare(strict_types=1);

// This script ships inside the project directory, which on Stacks and zip
// installs sits under the document root — so `tcms` is fetchable over HTTP.
// Served that way it would boot the container, discover and boot every
// extension, and render a command list to a stranger; the stderr writes it
// makes along the way are themselves fatal, because STDIN/STDOUT/STDERR are
// only defined under the CLI SAPI.
//
// The test is REQUEST_METHOD rather than PHP_SAPI: some shared hosts run cron
// through php-cgi, which is not the CLI SAPI but is not a web request either,
// and those crons must keep working. Only an actual HTTP request is refused.
if (isset($_SERVER['REQUEST_METHOD'])) {
	http_response_code(403);
	header('Content-Type: text/plain; charset=utf-8');
	echo "tcms is a command line tool and cannot be run over HTTP.\n";

	exit(1);
}

ini_set('memory_limit', '512M');

// Locate the Composer autoloader. Several invocation styles must all work:
//   1. Composer bin proxy: vendor/bin/tcms wraps this script and sets
//      _composer_autoload_path to <project>/vendor/autoload.php. Also the only
//      reliable signal for path-repo / symlinked dev installs, where __DIR__
//      resolves THROUGH the symlink into the source repo.
//   2. Direct invocation of an installed dependency by package path
//      (vendor/totalcms/cms/resources/bin/tcms) — e.g. a hand-written cron.
//      The project autoloader is four levels up at <project>/vendor/autoload.php.
//   3. Standalone / zip install (or running bin/tcms in the source repo): the
//      package ships its own vendor/ at the package root.
$autoloadCandidates = [
	$GLOBALS['_composer_autoload_path'] ?? null,
	__DIR__ . '/../../../../autoload.php', // installed as a dependency
	__DIR__ . '/../../vendor/autoload.php', // standalone / zip / dev repo
];
$autoloadPath = null;
foreach ($autoloadCandidates as $candidate) {
	if (is_string($candidate) && is_file($candidate)) {
		$autoloadPath = $candidate;
		break;
	}
}
if ($autoloadPath === null) {
	fwrite(STDERR, "tcms: could not locate Composer's autoload.php. Run via vendor/bin/tcms, or `composer install` first.\n");
	exit(1);
}
require $autoloadPath;

// PathResolver needs TCMS_PROJECT_ROOT to find writable dirs (cache/,
// tmp/, logs/, tcms-data/). Without it, the CLI would write to the
// package root — which for a symlinked install is the source repo, not
// the consuming project. Derive it from autoload.php's parent: the
// autoload always lives at <root>/vendor/autoload.php.
if (!defined('TCMS_PROJECT_ROOT')) {
	// realpath() collapses any `..` segments — Composer's bin proxy sets
	// _composer_autoload_path to `<bindir>/../autoload.php`, which dirname
	// alone won't normalize (so TCMS_PROJECT_ROOT would end up at
	// `<project>/vendor/bin` instead of `<project>`).
	$resolvedAutoload = realpath($autoloadPath);
	define('TCMS_PROJECT_ROOT', dirname($resolvedAutoload !== false ? $resolvedAutoload : $autoloadPath, 2));
}

\TotalCMS\CLI\CliApplication::run();
