{% extends "admin-dashboard.twig" %}

{% set sections = {
	'general': {
		'label': t('settings.general'),
		'description': t('settings.general_desc')
	},
	'auth': {
		'label': t('settings.authentication'),
		'description': t('settings.authentication_desc')
	},
	'cache': {
		'label': t('settings.cache'),
		'description': t('settings.cache_desc')
	},
	'dashboard': {
		'label': t('settings.dashboard'),
		'description': t('settings.dashboard_desc')
	},
	'extensions': {
		'label': t('settings.extensions'),
		'description': t('settings.extensions_desc')
	},
	'htmlclean': {
		'label': t('settings.html_sanitization'),
		'description': t('settings.html_sanitization_desc')
	},
	'i18n': {
		'label': t('settings.i18n'),
		'description': t('settings.i18n_desc')
	},
	'imageworks': {
		'label': t('settings.imageworks'),
		'description': t('settings.imageworks_desc')
	},
	'mailer': {
		'label': t('settings.mailer'),
		'description': t('settings.mailer_desc')
	},
	'mcp': {
		'label': t('settings.mcp'),
		'description': t('settings.mcp_desc')
	},
	'presets': {
		'label': t('settings.presets'),
		'description': t('settings.presets_desc')
	},
	'smtp': {
		'label': t('settings.smtp'),
		'description': t('settings.smtp_desc')
	},
	'search': {
		'label': t('settings.search'),
		'description': t('settings.search_desc')
	},
	'sync': {
		'label': t('settings.sync'),
		'description': t('settings.sync_desc')
	},
	'builder': {
		'label': 'Builder',
		'description': 'Site Builder stub generation settings'
	},
} %}

{% if cms.edition.can('oauth_server') %}
	{% set sections = sections|merge({
		'oauth': {
			'label': t('settings.oauth'),
			'description': t('settings.oauth_desc')
		}
	}) %}
{% endif %}

{% if cms.license.canSimulateEdition() %}
	{% set sections = sections|merge({
		'license': {
			'label': t('settings.license_simulator'),
			'description': t('settings.license_simulator_desc')
		}
	}) %}
{% endif %}

{# Sort the sidebar alphabetically by the visible label so it scales as
   more sections are added. Sorts by label (which is localized) so each
   operator sees their own language's ordering. Twig's |sort preserves
   the dict keys, which the for-loop below uses for the `settings-{id}`
   class and active-state matching. #}
{% set sections = sections|sort((a, b) => a.label|lower <=> b.label|lower) %}

{% block dashcontent %}

<aside class="dash-content-sidebar">
	<header>
		<input type="search" name="filter" class="filter" placeholder="{{ t('settings.filter') }}" autofocus />
	</header>

	<nav class="links" id="settings-links">
		<ul>
			{% for sectionId, section in sections %}
			<li class="settings-{{ sectionId }}">
				<a {% if url.section == sectionId %}class="active"{% endif %}
					href="settings/{{ sectionId }}"
					title="{{ section.description }}">{{ section.label }}</a>
			</li>
			{% endfor %}
		</ul>
	</nav>
</aside>

<main class="dash-main-content">
	<header>
		<h1><a href="settings">settings</a> / <span>{{ sections[currentSection].label | lower }}</span></h1>
	</header>

	<section class="dash-content-section">
		{% if sections[currentSection].description %}
		<p>{{ sections[currentSection].description }}</p>
		{% endif %}

		{% if currentSection == 'presets' %}
		<div class="cms-info">
			<p><strong>Named presets</strong> &mdash; Reference a preset by name in a schema property's settings with <code>"preset": "my-preset-name"</code>. The preset's settings become the base, and any additional field settings override them.</p>
			<p><strong>Type defaults</strong> &mdash; Name a preset after a field type (e.g., <code>styledtext</code>, <code>image</code>) and it will automatically apply to every field of that type that has no settings defined at the schema, collection, or object level.</p>
		</div>
		{% endif %}

		{% if currentSection == 'oauth' and oauthKeys is defined %}
		<style>
			.oauth-key-paths { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1rem; margin: 0.5rem 0 0; }
			.oauth-key-paths dt { font-weight: 600; }
			.oauth-key-paths dd { margin: 0; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
			.oauth-key-paths code { word-break: break-all; }
		</style>
		<div class="cms-info oauth-key-status">
			<p><strong>Signing key paths</strong> &mdash; Override in <code>config/tcms.php</code>.</p>
			<dl class="oauth-key-paths">
				<dt>Private key</dt>
				<dd>
					<code>{{ oauthKeys.signingKeyPath }}</code>
					{% if oauthKeys.signingExists %}
						<span class="dash-badge success">present</span>
					{% else %}
						<span class="dash-badge danger">missing</span>
					{% endif %}
				</dd>
				<dt>Public key</dt>
				<dd>
					<code>{{ oauthKeys.publicKeyPath }}</code>
					{% if oauthKeys.publicExists %}
						<span class="dash-badge success">present</span>
					{% else %}
						<span class="dash-badge danger">missing</span>
					{% endif %}
				</dd>
			</dl>
			{% if not oauthKeys.signingExists or not oauthKeys.publicExists %}
			<p>Run <code>tcms oauth:setup</code> to generate the key pair.</p>
			{% endif %}
		</div>
		{% endif %}

		{% if currentSection == 'mcp' and mcpConnection is defined %}
		<style>
			.mcp-conn { display: grid; gap: 0.75rem; }
			.mcp-conn .mcp-badges { display: flex; gap: 0.4rem; flex-wrap: wrap; }
			.mcp-conn .mcp-field { display: grid; gap: 0.3rem; }
			.mcp-conn .mcp-label { font-weight: 600; font-size: 0.9rem; }
			.mcp-codebox {
				position: relative;
				padding: 0.6rem 5.5rem 0.6rem 0.75rem;
				background: oklch(var(--totalform-nearwhite));
				border: 1px solid oklch(var(--totalform-border-color));
				border-radius: var(--totalform-radius);
				font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				font-size: 0.85rem;
				word-break: break-all;
				line-height: 1.5;
			}
			.mcp-codebox .cms-clip-button {
				position: absolute; top: 0.4rem; right: 0.4rem;
				padding: 0.2rem 0.6rem; font-size: 0.75rem; line-height: 1.4;
				border: 1px solid oklch(var(--totalform-border-color));
				border-radius: var(--totalform-radius);
				background: oklch(var(--totalform-purewhite));
				color: oklch(var(--totalform-text-color));
				cursor: pointer;
			}
			.mcp-codebox .cms-clip-button:hover,
			.mcp-codebox .cms-clip-button.copied {
				background: oklch(var(--totalform-accent));
				border-color: oklch(var(--totalform-accent));
				color: oklch(var(--totalform-purewhite));
			}
			.mcp-conn .mcp-auth { font-size: 0.9rem; }
		</style>
		<div class="cms-info mcp-conn">
			<div class="mcp-badges">
				{% if mcpConnection.enabled %}
					<span class="dash-badge success">enabled</span>
				{% else %}
					<span class="dash-badge danger">disabled</span>
				{% endif %}
				{% if mcpConnection.publicAccess %}
					<span class="dash-badge warning">public access</span>
				{% else %}
					<span class="dash-badge muted">auth required</span>
				{% endif %}
			</div>

			<p><strong>Connection details</strong> &mdash; point your MCP client (Cursor, Claude, etc.) at the endpoint below. On subpath / Stacks installs this already includes the install's base path, so copy it as-is rather than assuming <code>/mcp</code> at the domain root.</p>

			<div class="mcp-field">
				<span class="mcp-label">Endpoint</span>
				<div class="mcp-codebox">
					<span id="mcp-endpoint-url">{{ mcpConnection.endpoint }}</span>
					<button type="button" class="cms-clip-button" data-clip="#mcp-endpoint-url" title="{{ t('btn.copy_clipboard') }}">Copy</button>
				</div>
			</div>

			<div class="mcp-field">
				<span class="mcp-label">Discovery</span>
				<div class="mcp-codebox">
					<span id="mcp-discovery-url">{{ mcpConnection.discovery }}</span>
					<button type="button" class="cms-clip-button" data-clip="#mcp-discovery-url" title="{{ t('btn.copy_clipboard') }}">Copy</button>
				</div>
			</div>

			<p class="mcp-auth"><strong>Auth header:</strong> <code>{{ mcpConnection.apiKeyHeader }}</code>{% if not mcpConnection.publicAccess %} &mdash; required (this server is not public){% endif %}</p>

			{% if not mcpConnection.enabled %}
			<p>The MCP server is currently <strong>disabled</strong>. Enable it below to accept connections.</p>
			{% endif %}
		</div>
		{% endif %}

		{% if currentSection == 'general' and appEnvLocked is defined and appEnvLocked %}
		<div class="cms-info">
			<p><strong>Site Environment is controlled by an environment variable.</strong> The <code>APP_ENV</code> environment variable is set to <code>{{ appEnvValue }}</code>, which overrides the Site Environment selector below. To change the environment via the UI, remove the <code>APP_ENV</code> variable from your server configuration.</p>
		</div>
		{% endif %}

		{{ cms.form.settings(currentSection) }}

		{% if currentSection == 'smtp' %}
		<section class="dash-content-section" style="margin-top: 40px;">
			<h2>{{ t('settings.smtp_test_title') }}</h2>

			{% if testResult is defined %}
				{% if testResult.success %}
					<p class="cms-success" role="alert">{{ testResult.message }}</p>
				{% else %}
					<p class="cms-error" role="alert">{{ testResult.message }}</p>
				{% endif %}
			{% else %}
				<p>{{ t('settings.smtp_test_desc') }}</p>

				{{ cms.form.simple('settings/smtp?test=1', '
					<div class="field-wrapper field-email">
						<label for="test_email">' ~ t('settings.smtp_test_email') ~ '</label>
						<input type="email" id="test_email" name="test_email" placeholder="'~ t('settings.smtp_test_ph') ~'" required />
						<div class="help">'~ t('settings.smtp_test_help') ~'</div>
					</div>
				', {
					'method': 'POST',
					'label': t('settings.smtp_test_btn'),
					'buttonClass': 'cms-secondary',
					'ajax': false
				}) }}
			{% endif %}
		</section>
		{% endif %}

	</section>
</main>

{% endblock %}
