{#
	Quick Navigation Index
	Builds a JSON array of all navigable admin items for the quick-nav dialog.
	Included in admin-dashboard.twig so it's available on every admin page.
#}
{# Recursive macro — flattens the builder pages tree into quick-nav entries.
   Children get a leading "↳ " so the nesting is visible in the search results
   without requiring the dialog itself to render the tree. #}
{% macro builderPageItems(pages, indent) %}
{% for page in pages %}
{"label":"{{ (indent ~ (page.title|default(page.id))) | e('js') }}","section":"Builder Pages","path":"builder/page/{{ page.id | e('js') }}","keywords":"builder page {{ page.route|default('') | e('js') }}"},
{% if page.children is defined and page.children is not empty %}
{{ _self.builderPageItems(page.children, indent ~ '↳ ') }}
{% endif %}
{% endfor %}
{% endmacro %}
<script>
window.TCMS_QUICK_NAV = [
{# ── Top-level nav items ── #}
{% if cms.auth.canAccessCollectionsOperation('read') %}
{"label":"{{ t('nav.collections') }}","section":"Navigation","path":"collections","keywords":"nav"},
{% endif %}
{% if cms.auth.canAccessSchemasOperation('read') %}
{"label":"{{ t('nav.schemas') }}","section":"Navigation","path":"schemas","keywords":"nav"},
{% endif %}
{% if cms.auth.canAccessDataViews() and cms.edition.can('data_views') %}
{"label":"{{ t('nav.dataviews') }}","section":"Navigation","path":"dataviews","keywords":"nav"},
{% endif %}
{% if cms.auth.canAccessBuilder() %}
{"label":"Builder","section":"Navigation","path":"builder","keywords":"nav site pages templates"},
{% endif %}
{% if cms.auth.canAccessMailer() and cms.edition.can('mailer_actions') %}
{"label":"{{ t('nav.mailer') }}","section":"Navigation","path":"mailer","keywords":"nav email"},
{% endif %}
{% if cms.auth.isAdmin() and cms.edition.can('automations') %}
{"label":"Automations","section":"Navigation","path":"automations","keywords":"nav schedule cron webhook event jobs"},
{% endif %}
{% if cms.auth.canAccessPlayground() %}
{"label":"{{ t('nav.playground') }}","section":"Navigation","path":"playground","keywords":"nav twig test"},
{% endif %}
{% if cms.auth.canAccessUtils() %}
{"label":"{{ t('nav.utils') }}","section":"Navigation","path":"utils","keywords":"nav utilities tools"},
{% endif %}
{% if cms.auth.isAdmin() %}
{"label":"{{ t('nav.extensions') }}","section":"Navigation","path":"extensions","keywords":"nav plugins"},
{"label":"{{ t('nav.settings') }}","section":"Navigation","path":"settings","keywords":"nav config configuration"},
{% endif %}
{% if cms.auth.canAccessDocs() %}
{"label":"{{ t('nav.docs') }}","section":"Navigation","path":"docs","keywords":"nav documentation help"},
{% endif %}

{# ── Individual collections ── #}
{% if cms.auth.canAccessCollectionsOperation('read') %}
{% for category, collections in cms.collection.byCategory() %}
{% for c in collections %}
{% if c.id not in ['playground', 'mailer', 'dataviews', 'builder-pages'] and cms.auth.canAccessCollection(c.id, 'read') %}
{"label":"{{ c.name | e('js') }}","section":"Collections","path":"collections/{{ c.id | e('js') }}","keywords":"{{ category | e('js') }} {{ c.schema | e('js') }}"},
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}

{# ── Individual data views ── #}
{% if cms.auth.canAccessDataViews() and cms.edition.can('data_views') %}
{% for view in cms.view.list() %}
{"label":"{{ view.name | default(view.id) | e('js') }}","section":"Data Views","path":"dataviews/{{ view.id | e('js') }}","keywords":"view {{ view.id | e('js') }}"},
{% endfor %}
{% endif %}

{# ── Individual schemas ── #}
{% if cms.auth.canAccessSchemasOperation('read') %}
{% for category, schemas in cms.schema.byCategory() %}
{% for s in schemas %}
{% if s.id != 'blog-legacy' and cms.auth.canAccessSchema(s.id, 'read') %}
{"label":"{{ s.id | e('js') }}","section":"Schemas","path":"schemas/{{ s.id | e('js') }}","keywords":"{{ category | e('js') }} {{ s.description | e('js') }}"},
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}

{# ── Utilities ── #}
{% if cms.auth.canAccessUtils() %}
{% set utilItems = [
	{"title":"Project Setup","path":"project-setup","group":"Setup"},
	{"title":"JumpStart Data","path":"jumpstart","group":"Setup"},
	{"title":"Cache Manager","path":"cache-manager","group":"Cache"},
	{"title":"Cache Sizing Advisor","path":"cache-sizing","group":"Cache"},
	{"title":"Image Batcher","path":"image-batcher","group":"Cache"},
	{"title":"Image Cache","path":"image-cache","group":"Cache"},
	{"title":"Import Alloy","path":"import-alloy","group":"Import"},
	{"title":"Import Total CMS 1","path":"import-totalcms-one","group":"Import"},
	{"title":"Collection Report","path":"collection-report","group":"System"},
	{"title":"Job Queue Manager","path":"jobqueue","group":"System"},
	{"title":"License Manager","path":"license-manager","group":"System"},
	{"title":"Log Analyzer","path":"logs","group":"System"},
	{"title":"Orphan Scanner","path":"orphan-scanner","group":"System"},
	{"title":"Pretty URL Builder","path":"pretty-url-builder","group":"System"},
	{"title":"Server Checker","path":"server-checker","group":"System"},
	{"title":"Sync Manager","path":"sync","group":"System"},
	{"title":"Twig Debugger","path":"twig-debugger","group":"System"},
	{"title":"Update Manager","path":"update","group":"System"}
] %}
{% for item in utilItems %}
{% if cms.auth.canAccessUtil(item.path, 'read') %}
{"label":"{{ item.title }}","section":"Utilities","path":"utils/{{ item.path }}","keywords":"{{ item.group }}"},
{% endif %}
{% endfor %}
{% if cms.auth.isAdmin() and cms.edition.can('access_groups') %}
{% if cms.auth.canAccessUtil('access-groups', 'read') %}
{"label":"Access Groups","section":"Utilities","path":"utils/access-groups","keywords":"Authentication"},
{% endif %}
{% endif %}
{% if cms.auth.isAdmin() and cms.edition.can('api_keys') %}
{% if cms.auth.canAccessUtil('api-keys', 'read') %}
{"label":"API Keys","section":"Utilities","path":"utils/api-keys","keywords":"Authentication"},
{% endif %}
{% endif %}
{% if cms.auth.isAdmin() and cms.edition.can('rss_import') %}
{% if cms.auth.canAccessUtil('import-rss', 'read') %}
{"label":"Import RSS Feed","section":"Utilities","path":"utils/import-rss","keywords":"Import"},
{% endif %}
{% if cms.auth.canAccessUtil('import-wordpress', 'read') %}
{"label":"Import WordPress","section":"Utilities","path":"utils/import-wordpress","keywords":"Import"},
{% endif %}
{% endif %}
{% endif %}

{# ── Settings ── #}
{% if cms.auth.isAdmin() %}
{"label":"{{ t('settings.general') | e('js') }}","section":"Settings","path":"settings/general","keywords":""},
{"label":"{{ t('settings.authentication') | e('js') }}","section":"Settings","path":"settings/auth","keywords":"login password"},
{"label":"{{ t('settings.cache') | e('js') }}","section":"Settings","path":"settings/cache","keywords":""},
{"label":"{{ t('settings.dashboard') | e('js') }}","section":"Settings","path":"settings/dashboard","keywords":"admin"},
{"label":"{{ t('settings.html_sanitization') | e('js') }}","section":"Settings","path":"settings/htmlclean","keywords":"sanitize xss"},
{"label":"{{ t('settings.imageworks') | e('js') }}","section":"Settings","path":"settings/imageworks","keywords":"image watermark"},
{"label":"{{ t('settings.mailer') | e('js') }}","section":"Settings","path":"settings/mailer","keywords":"email"},
{"label":"{{ t('settings.presets') | e('js') }}","section":"Settings","path":"settings/presets","keywords":"field defaults"},
{"label":"{{ t('settings.smtp') | e('js') }}","section":"Settings","path":"settings/smtp","keywords":"email mail server"},
{"label":"{{ t('settings.sync') | e('js') }}","section":"Settings","path":"settings/sync","keywords":"remote"},
{"label":"Builder","section":"Settings","path":"settings/builder","keywords":"site pages"},
{% if cms.license.canSimulateEdition() %}
{"label":"{{ t('settings.license_simulator') | e('js') }}","section":"Settings","path":"settings/license","keywords":"edition"},
{% endif %}
{% endif %}

{# ── Docs ── #}
{% if cms.auth.canAccessDocs() %}
{# Derived from resources/docs/menu.php (via cms.admin.docsMenu) so quick-nav
   never drifts from the real doc tree. Don't hand-maintain a list here. #}
{% for doc in cms.admin.docsMenu() %}
{"label":"{{ doc.title | e('js') }}","section":"Docs","path":"docs/{{ doc.path | e('js') }}","keywords":"{{ doc.group | e('js') }} documentation"},
{% endfor %}
{% endif %}

{# ── Builder pages ── #}
{% if cms.auth.canAccessBuilder() %}
{{ _self.builderPageItems(cms.builder.pagesTree(), '') }}
{% endif %}

{# ── Builder templates (layouts, partials, macros, pages, etc.) ── #}
{% if cms.auth.canAccessBuilder() %}
{% for folder, templates in cms.admin.templatesByFolder() %}
{% for tpl in templates %}
{"label":"{{ tpl.path | e('js') }}","section":"Builder Templates","path":"builder/{{ tpl.path | e('js') }}","keywords":"builder template {{ folder | e('js') }}"},
{% endfor %}
{% endfor %}
{% endif %}

{# ── Extension nav items ── #}
{% if extensionNavItems is defined and extensionNavItems is iterable %}
{% for item in extensionNavItems %}
{% if (item.permission == 'any' and cms.auth.canAccessExtension(item.extensionId)) or (item.permission == 'admin' and cms.auth.isAdmin()) %}
{"label":"{{ item.label | e('js') }}","section":"Extensions","path":"{{ item.url | e('js') }}","keywords":"extension plugin"},
{% endif %}
{% endfor %}
{% endif %}
];
</script>
