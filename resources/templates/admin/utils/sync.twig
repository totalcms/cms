<h1>{{ t('sync.title') }}</h1>

{% set settings = syncData.settings %}
{% set schemas = syncData.schemas %}
{% set templates = syncData.templates %}
{% set collections = syncData.collections %}
{% set isConfigured = settings.url is not empty and settings.key is not empty %}

<section class="sync-utility">

{% if not isConfigured %}
	<div class="sync-notice">
		<p>{{ t('sync.not_configured') }}</p>
		<p><a href="settings/sync" class="dash-button">{{ t('sync.configure_link') }}</a></p>
	</div>
{% else %}
	<p>{{ t('sync.desc') }}</p>
	<p class="sync-remote-url"><strong>{{ t('sync.remote') }}:</strong> {{ settings.url }}</p>

	{% if schemas|length == 0 and templates|length == 0 and collections|length == 0 %}
		<p>{{ t('sync.nothing_to_sync') }}</p>
	{% else %}

	{% set formFields %}

		{% if schemas|length > 0 %}
		<div class="sync-section">
			<h3>{{ t('sync.schemas_title') }}</h3>

			{{ cms.form.field("multicheckbox", "schemas-all", {
				value   : [],
				options : [
					{value: "all", label: t('sync.select_all')}
				],
				settings : { relationalOptions: false }
			}) }}

			{% set schemaOptions = [] %}
			{% for schema in schemas %}
				{% set schemaOptions = schemaOptions|merge([{
					value: schema.id,
					label: schema.id
				}]) %}
			{% endfor %}

			{{ cms.form.field("multicheckbox", "schemas", {
				label    : t('sync.specific_schemas'),
				value    : [],
				options  : schemaOptions,
				settings : {
					fieldGrid: "200px",
					visibility : {
						watch    : "schemas-all",
						value    : "all",
						operator : "not_in"
					}
				}
			}) }}
		</div>
		{% endif %}

		{% if templates|length > 0 %}
		<div class="sync-section">
			<h3>{{ t('sync.templates_title') }}</h3>

			{{ cms.form.field("multicheckbox", "templates-all", {
				value   : [],
				options : [
					{value: "all", label: t('sync.select_all')}
				],
				settings : { relationalOptions: false }
			}) }}

			{% set templateOptions = [] %}
			{% for template in templates %}
				{% set templateOptions = templateOptions|merge([{
					value: template,
					label: template
				}]) %}
			{% endfor %}

			{{ cms.form.field("multicheckbox", "templates", {
				label    : t('sync.specific_templates'),
				value    : [],
				options  : templateOptions,
				settings : {
					fieldGrid: "200px",
					visibility : {
						watch    : "templates-all",
						value    : "all",
						operator : "not_in"
					}
				}
			}) }}
		</div>
		{% endif %}

		{% for collection in collections %}
		<div class="sync-section">
			<h3>{{ collection.name }}</h3>

			{% if collection.objects|length == 0 %}
				<p class="sync-empty">{{ t('sync.no_objects') }}</p>
			{% else %}

				{{ cms.form.field("multicheckbox", "collection-" ~ collection.id ~ "-all", {
					value   : [],
					options : [
						{value: "all", label: t('sync.select_all')}
					],
					settings : { relationalOptions: false }
				}) }}

				{% set objectOptions = [] %}
				{% for obj in collection.objects %}
					{% set objectOptions = objectOptions|merge([{
						value: obj.id,
						label: obj.label
					}]) %}
				{% endfor %}

				{{ cms.form.field("multicheckbox", "collection-" ~ collection.id, {
					label    : t('sync.specific_objects'),
					value    : [],
					options  : objectOptions,
					settings : {
						fieldGrid: "200px",
						visibility : {
							watch    : "collection-" ~ collection.id ~ "-all",
							value    : "all",
							operator : "not_in"
						}
					}
				}) }}

			{% endif %}
		</div>
		{% endfor %}

	{% endset %}

	{{ cms.form.totalform("", formFields, {
		class  : "sync-form no-unsaved-warning",
		method : "POST",
		save   : false,
	}) }}

	<div class="sync-actions">
		<button type="button" class="dash-button" id="sync-push-btn">
			{{ t('sync.push_btn') }}
		</button>
		<button type="button" class="dash-button transparent" id="sync-pull-btn">
			{{ t('sync.pull_btn') }}
		</button>
		<span id="sync-spinner" style="display:none">{{ t('sync.syncing') }}</span>
	</div>

	<div id="sync-results"></div>

	{% endif %}
{% endif %}

</section>

<style>
.sync-utility {
	display: grid;
	align-content: start;
	gap: 1.5rem;
	max-width: 900px;
}

.sync-notice {
	padding: 2rem;
	text-align: center;
	border: 2px dashed oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
}

.sync-remote-url  {
	color: oklch(var(--totalform-accent));
	font-size: 1.05rem;
}
.sync-remote-url strong {
	color: oklch(var(--totalform-darkgray));
}


.sync-section {
	background: oklch(var(--totalform-nearwhite) / 0.5);
	border: 1px solid oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
	padding: 1.5rem;
	margin-block: 0.5rem;
}

.sync-section h3 {
	margin-block-start: 0;
	margin-block-end: 1rem;
}

.sync-section .multicheckbox-field {
	margin-block-start: 1rem;
}

.sync-section .sync-empty {
	margin-block: 0;
	color: oklch(var(--totalform-darkgray));
	font-style: italic;
}

.sync-section .multicheckbox-field label {
	max-width : 200px;
}

.sync-actions {
	display: flex;
	align-items: center;
	gap: 1rem;
}

#sync-results:not(:empty) {
	margin-top: 1rem;
	padding: 1rem 1.5rem;
	border-radius: var(--totalform-radius);
	background: oklch(var(--totalform-nearwhite));
	border: 1px solid oklch(var(--totalform-border-color));
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const form     = document.querySelector('.sync-form');
	const results  = document.getElementById('sync-results');
	const spinner  = document.getElementById('sync-spinner');
	const pushBtn  = document.getElementById('sync-push-btn');
	const pullBtn  = document.getElementById('sync-pull-btn');

	if (!form || !pushBtn || !pullBtn) return;

	// Encode a section's selection into the form body. Three modes:
	//   - all:      the "All …" checkbox is checked → send mode=all
	//   - specific: individual items are checked    → send mode=specific + ids
	//   - none:     nothing is checked              → send mode=none
	// The mode is explicit because the previous encoding ("missing keys = all")
	// couldn't tell "user picked nothing" from "user picked everything" — both
	// arrived as null at the exporter, which then exported everything.
	function appendSelection(body, key, allFieldName, itemsFieldName) {
		const allCheckbox = form.querySelector(`input[name="${allFieldName}"][value="all"]`);
		if (allCheckbox && allCheckbox.checked) {
			body.append(`${key}_mode`, 'all');
			return;
		}
		// multicheckbox renders each option with a bare `name` (no `[]`), so the
		// selector must match that — `${itemsFieldName}`, not `${itemsFieldName}[]`.
		// The body.append below still uses `[]` so PHP parses it as an array.
		const selected = Array.from(form.querySelectorAll(`input[name="${itemsFieldName}"]:checked`))
			.map(cb => cb.value);
		if (selected.length === 0) {
			body.append(`${key}_mode`, 'none');
			return;
		}
		body.append(`${key}_mode`, 'specific');
		selected.forEach(s => body.append(`${key}[]`, s));
	}

	async function doSync(action) {
		const body = new FormData();

		// Get CSRF token from the form. The field is named `csrf_token` per
		// CSRFTokenManager — not `_csrf_token`. CSRFProtectionMiddleware
		// looks for that exact name (also accepts an X-CSRF-Token header).
		const csrf = form.querySelector('input[name="csrf_token"]');
		if (csrf) body.append('csrf_token', csrf.value);

		appendSelection(body, 'schemas',   'schemas-all',   'schemas');
		appendSelection(body, 'templates', 'templates-all', 'templates');

		// Per-collection nested payload:
		//   collections[<id>][mode]    = all | specific | none
		//   collections[<id>][items][] = <objectId>
		// Server parses this into a map of {collectionId: list<ids>|null}
		// and threads it through to JumpStartExporter, which filters both
		// which collections to walk AND which object ids inside each.
		const syncableCollections = {{ collections|map(c => c.id)|json_encode|raw }};
		syncableCollections.forEach(cid => {
			const allCheckbox = form.querySelector(`input[name="collection-${cid}-all"][value="all"]`);
			if (allCheckbox && allCheckbox.checked) {
				body.append(`collections[${cid}][mode]`, 'all');
				return;
			}
			const selected = Array.from(form.querySelectorAll(`input[name="collection-${cid}"]:checked`))
				.map(cb => cb.value);
			if (selected.length === 0) {
				body.append(`collections[${cid}][mode]`, 'none');
				return;
			}
			body.append(`collections[${cid}][mode]`, 'specific');
			selected.forEach(s => body.append(`collections[${cid}][items][]`, s));
		});

		spinner.style.display = 'inline';
		pushBtn.disabled = true;
		pullBtn.disabled = true;
		results.innerHTML = '';

		try {
			// The sync route lives at `/admin/sync/{action}` (admin group, not
			// the API group). `cms.api` is the subpath prefix T3 is mounted at
			// — typically empty, `/cms` for subpath installs — so prefixing
			// with it keeps both layouts working.
			const resp = await fetch(`{{ cms.base }}/admin/sync/${action}`, {
				method: 'POST',
				body: body,
			});
			const data = await resp.json();

			if (data.success) {
				// SyncService returns an OperationResult whose `data` array
				// is flattened into the JSON root, so the counts are
				// `data.schemas` / `data.templates` / `data.collections` —
				// not nested under `data.pushed` / `data.pulled`.
				// `collections` is the total object count across every
				// allowlisted collection that participated.
				const schemas   = data.schemas   ?? 0;
				const templates = data.templates ?? 0;
				const objects   = data.collections ?? 0;
				results.innerHTML = `<p style="color:oklch(var(--totalform-success))"><strong>${data.message}</strong></p>` +
					`<p>Schemas: ${schemas}, Templates: ${templates}, Objects: ${objects}</p>`;
			} else {
				results.innerHTML = `<p style="color:oklch(var(--totalform-error))"><strong>Error:</strong> ${data.error}</p>`;
			}
		} catch (err) {
			results.innerHTML = `<p style="color:oklch(var(--totalform-error))">Request failed: ${err.message}</p>`;
		} finally {
			spinner.style.display = 'none';
			pushBtn.disabled = false;
			pullBtn.disabled = false;
		}
	}

	pushBtn.addEventListener('click', () => {
		if (confirm('Are you sure you want to push to production? This will overwrite the selected schemas, templates, and collection objects on the remote server.')) {
			doSync('push');
		}
	});
	pullBtn.addEventListener('click', () => {
		if (confirm('Are you sure you want to pull from production? This will overwrite the selected schemas, templates, and collection objects locally.')) {
			doSync('pull');
		}
	});
});
</script>
