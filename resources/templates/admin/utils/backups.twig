{# Utilities → Backups. Autoescape is off in this engine: every value that came
   from a record, a file name or the query string is escaped with |e here. #}
{% set b = backups %}
{% set here = 'utils/backups?collection=' ~ (b.collection|url_encode) ~ '&id=' ~ (b.id|url_encode) %}
{% set full = 'D j M Y, g:i:s A' %}
{% set today = 'now'|date('Y-m-d') %}
{% set yesterday = '-1 day'|date('Y-m-d') %}

{# "Today", "Yesterday", or the date. #}
{% macro day(at, today, yesterday) %}
	{%- set d = at|date('Y-m-d') -%}
	{{- d == today ? 'Today' : (d == yesterday ? 'Yesterday' : at|date('l j F Y')) -}}
{% endmacro %}

{# Who made a change: the user's id, with their collection on hover. #}
{% macro who(name) %}
	{%- if name == '' -%}<span class="backups-muted">unknown</span>
	{%- else -%}<span title="{{ name|e }}">{{ (name|split('/')|last)|e }}</span>
	{%- endif -%}
{% endmacro %}

{% macro state(state) %}
	{%- if state == 'kept' -%}<span class="dash-badge sm success" title="A restore brings this file back">kept</span>
	{%- elseif state == 'live' -%}<span class="dash-badge sm muted" title="This file is still in the field">on disk</span>
	{%- elseif state == 'gone' -%}<span class="dash-badge sm warning" title="This file was deleted and was not kept. A restore cannot bring it back.">not kept</span>
	{%- endif -%}
{% endmacro %}

{# One side of a changed value. A long one shows its start and opens in full;
   with room (`whole`), it is shown in full straight away. #}
{% macro side(text, long, whole) %}
	{%- if text == '' -%}<span class="backups-empty">empty</span>
	{%- elseif long and whole -%}<pre class="backups-whole">{{ text|e }}</pre>
	{%- elseif long -%}
		<details class="backups-long">
			<summary>{{ text|slice(0, 110)|e }}{{ text|length > 110 ? '…' }}</summary>
			<pre>{{ text|e }}</pre>
		</details>
	{%- else -%}{{ text|e }}
	{%- endif -%}
{% endmacro %}

{% macro filename(file) %}{{ (file.path ? file.path ~ '/' : '')|e }}{{ file.name|e }}{% endmacro %}

{#
   The fields that differ, as a table of two sides.
   `hint` is a note beside the left heading. `link` is the URL that restores
   one field, without the property; '' to offer none. `whole` shows long
   values in full, for where there is room.
#}
{% macro changes(list, left, right, hint, link, whole) %}
	{% import _self as ui %}
	<table class="backups-changes">
		<thead>
			<tr><th>Field</th><th>{{ left|e }}{% if hint %} <span class="backups-hint">{{ hint|e }}</span>{% endif %}</th><th>{{ right|e }}</th>{% if link %}<th></th>{% endif %}</tr>
		</thead>
		<tbody>
			{% set offered = [] %}
			{% for c in list %}
				<tr>
					<th scope="row">{{ c.label|e }}</th>
					{% if c.kind == 'secret' %}
						<td colspan="2"><span class="backups-muted">Changed. The value is never shown.</span></td>
					{% elseif c.kind == 'files' %}
						{% if c.removed is empty and c.added is empty %}
							<td colspan="2"><span class="backups-muted">The same files, in another order or with other details.</span></td>
						{% else %}
							<td data-label="{{ left|e }}">
								{% for file in c.removed %}<div class="backups-file">{{ ui.filename(file) }} {{ ui.state(file.state|default('')) }}</div>{% else %}<span class="backups-empty">nothing removed</span>{% endfor %}
							</td>
							<td data-label="{{ right|e }}">
								{% for file in c.added %}<div class="backups-file">{{ ui.filename(file) }}</div>{% else %}<span class="backups-empty">nothing added</span>{% endfor %}
							</td>
						{% endif %}
					{% else %}
						<td data-label="{{ left|e }}">{{ ui.side(c.before, c.kind == 'long', whole) }} {{ c.kind == 'file' and c.before ? ui.state(c.beforeState|default('')) }}</td>
						<td data-label="{{ right|e }}">{{ ui.side(c.after, c.kind == 'long', whole) }}</td>
					{% endif %}
					{% if link %}
						<td class="backups-actions">
							{% if c.property not in offered %}
								{% set offered = offered|merge([c.property]) %}
								<a class="backups-link" href="{{ link }}&property={{ c.property|url_encode }}#restore">Restore this field</a>
							{% endif %}
						</td>
					{% endif %}
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endmacro %}

{% import _self as ui %}

<h1>Backups</h1>

<section class="dash-content-section backups-util">

	{# ── Where you are, and the way to somewhere else ── #}
	{% set picker %}
		<form class="backups-pick totalform no-save no-unsaved-warning" method="get" data-method="GET" data-ajax="false" action="utils/backups">
			<label><span>Collection</span>
				<select name="collection">
					<option value="">Choose…</option>
					{% for cid, name in b.collections %}
						<option value="{{ cid|e }}" {{ cid == b.collection ? 'selected' }}>{{ name|e }}</option>
					{% endfor %}
				</select>
			</label>
			<label><span>Object ID <span class="backups-optional">(optional)</span></span>
				<input type="text" name="id" value="{{ b.id|e }}" placeholder="leave blank to list deleted objects" autocomplete="off">
			</label>
			<button class="dash-button transparent" type="submit">Open</button>
		</form>
	{% endset %}

	{% if b.view in ['object', 'collection'] %}
		<nav class="backups-crumbs" aria-label="Breadcrumb">
			<a href="utils/backups">Backups</a>
			<span aria-hidden="true">/</span>
			{% if b.view == 'object' %}
				<a href="utils/backups?collection={{ b.collection|url_encode }}">{{ b.collections[b.collection]|e }}</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{{ b.id|e }}</span>
			{% else %}
				<span aria-current="page">{{ b.collections[b.collection]|e }}</span>
			{% endif %}
			<details class="backups-switch">
				<summary>Open another</summary>
				{{ picker }}
			</details>
		</nav>
	{% else %}
		<p>Every save keeps the version it replaced, and every delete keeps the final state. Open an object to see what changed and to put a version, or one field, back.</p>
		{{ picker }}
	{% endif %}

	{% if b.notice %}
		{% if b.notice.ok %}
			<div class="info-box backups-notice">
				<p>
					<strong>{{ b.notice.created ? 'The object is back.' : (b.notice.property ? 'The field was restored.' : 'The object was restored.') }}</strong>
					{% if not b.notice.created %}The version it replaced is the newest change below, so this can be undone.{% endif %}
				</p>
				{% for file in b.notice.files %}
					<p class="backups-file-result {{ file.outcome == 'missing' ? 'backups-missing' }}">
						{{ file.property|e }}{{ file.path ? ('/' ~ file.path)|e }}: {{ file.file|e }}
						{{ file.outcome == 'restored' ? 'came back' : 'could not come back: it is not on disk and was not kept. Upload it again.' }}
					</p>
				{% endfor %}
			</div>
		{% else %}
			<div class="warning-box backups-notice"><p>{{ b.notice.error|default('The restore did not happen.')|e }}</p></div>
		{% endif %}
	{% endif %}

	{% if b.view == 'denied' %}

		<div class="warning-box"><p>There is no history here that you can open. The collection or object does not exist, or you may not edit it.</p></div>

	{% elseif b.view == 'owned' %}

		<div class="info-box"><p>In this collection each member sees only their own objects, so its deleted objects are listed for administrators. Enter an object ID above to open the history of one of yours.</p></div>

	{% elseif b.view == 'collection' %}

		<header class="backups-heading">
			<h2>Deleted objects</h2>
			{% if b.total %}<span class="backups-count">{{ b.total|number_format }}{% if b.pages > 1 %} · page {{ b.page }} of {{ b.pages }}{% endif %}</span>{% endif %}
		</header>

		{% if b.deleted is empty %}
			<div class="dash-empty-state"><em>No deleted object of this collection has a snapshot.</em></div>
		{% else %}
			<div class="backups-table-wrap">
				<table class="admin-table backups-deleted">
					<thead>
						<tr><th>Object</th><th>Deleted</th><th>By</th><th>History</th><th>Kept files</th><th></th></tr>
					</thead>
					<tbody>
						{% for row in b.deleted %}
							{% set link = 'utils/backups?collection=' ~ (b.collection|url_encode) ~ '&id=' ~ (row.id|url_encode) %}
							<tr>
								<td>
									<a class="backups-name" href="{{ link }}">{{ (row.title ?: row.id)|e }}</a>
									{% if row.title %}<span class="backups-meta">{{ row.id|e }}</span>{% endif %}
								</td>
								<td class="backups-when"><time datetime="{{ row.at|e }}" title="{{ row.at|date(full) }}">{{ ui.day(row.at, today, yesterday) }}, {{ row.at|date('g:i A') }}</time></td>
								<td>{{ ui.who(row.who) }}</td>
								<td>{{ row.snapshots }} {{ row.snapshots == 1 ? 'version' : 'versions' }}</td>
								<td>{{ row.files ? row.files ~ ' (' ~ row.size ~ ')' : '<span class="backups-muted">none</span>' }}</td>
								<td class="backups-actions">
									{% if row.canRestore %}
										<a class="dash-button" href="{{ link }}&restore={{ row.file|url_encode }}#restore">Restore</a>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			{% if b.pages > 1 %}
				<nav class="backups-pager">
					{% if b.page > 1 %}<a class="dash-button transparent" href="utils/backups?collection={{ b.collection|url_encode }}&page={{ b.page - 1 }}">← Newer</a>{% endif %}
					{% if b.page < b.pages %}<a class="dash-button transparent" href="utils/backups?collection={{ b.collection|url_encode }}&page={{ b.page + 1 }}">Older →</a>{% endif %}
				</nav>
			{% endif %}
		{% endif %}

	{% elseif b.view == 'object' %}

		<header class="backups-heading">
			<h2>{{ b.id|e }}</h2>
			{% if b.live %}
				<a class="dash-button transparent" href="collections/{{ b.collection|url_encode }}/{{ b.id|url_encode }}">Edit object</a>
			{% else %}
				<span class="dash-badge warning">Deleted</span>
			{% endif %}
		</header>

		{# ── The confirmation: what a restore would do, and the button that does it ── #}
		{% if b.restoring %}
			{% set r = b.restoring %}
			{% set nothing = r.live and r.changes is empty and r.back is empty %}
			<div class="backups-confirm" id="restore">
				<h3>
					{% if not r.live %}
						Bring {{ b.id|e }} back as it was {{ r.event == 'deleted' ? 'when it was deleted' : 'before ' ~ r.at|date(full) }}?
					{% elseif r.property %}
						Restore {{ (r.changes is not empty ? (r.changes|first).label|split(' › ')|first : r.property)|e }} to how it was before {{ r.at|date(full) }}?
					{% else %}
						Restore {{ b.id|e }} to how it was before {{ r.at|date(full) }}?
					{% endif %}
				</h3>

				{% if nothing %}
					<p>Nothing would change: the object already matches this version.</p>
				{% endif %}

				{% if r.changes is not empty %}
					{{ ui.changes(r.changes, 'Now', 'After the restore', '', '', false) }}
				{% endif %}
				{% if r.back is not empty %}
					<p class="backups-confirm-label">{{ r.back|length == 1 ? 'This file will come back' : 'These files will come back' }}</p>
					<ul>{% for f in r.back %}<li>{{ f.property|e }}{{ f.path ? ('/' ~ f.path)|e }}: {{ f.name|e }}</li>{% endfor %}</ul>
				{% endif %}
				{% if r.lost is not empty %}
					<p class="backups-confirm-label backups-missing">{{ r.lost|length == 1 ? 'This file cannot come back' : 'These files cannot come back' }}</p>
					<ul>{% for f in r.lost %}<li>{{ f.property|e }}{{ f.path ? ('/' ~ f.path)|e }}: {{ f.name|e }}</li>{% endfor %}</ul>
					<p class="backups-muted">{{ r.lost|length == 1 ? 'It is' : 'They are' }} not on disk and {{ r.lost|length == 1 ? 'was' : 'were' }} not kept. The record will name a file that is missing, until you upload it again.</p>
				{% endif %}
				{% if r.passwordKept %}
					<p class="backups-muted">The password stays as it is now. This version had a different one.</p>
				{% endif %}

				<form class="backups-confirm-actions" method="post" action="utils/backups/restore">
					{{ csrf_field() }}
					<input type="hidden" name="collection" value="{{ b.collection|e }}">
					<input type="hidden" name="id" value="{{ b.id|e }}">
					<input type="hidden" name="snapshot" value="{{ r.file|e }}">
					<input type="hidden" name="property" value="{{ r.property|e }}">
					{% if not nothing %}
						<button class="dash-button" type="submit">{{ r.live ? 'Restore' : 'Bring it back' }}</button>
					{% endif %}
					<a class="dash-button transparent" href="{{ here }}">Cancel</a>
					{% if r.live and not nothing %}
						<span class="backups-muted">The current version is saved first, so this can be undone.</span>
					{% endif %}
				</form>
			</div>
		{% endif %}

		{# ── The history: newest first, a heading for each day ── #}
		{% if b.entries is empty %}
			<div class="dash-empty-state">
				<em>{{ b.live ? 'This object has no history yet. A snapshot is taken each time it is saved.' : 'There is no object with this ID, and no history of one.' }}</em>
			</div>
		{% else %}
			{% if not b.keeping.enabled %}
				<div class="warning-box"><p>Keep Object History is off in <a href="settings/backups">Settings → Backups</a>, so no new snapshots are being taken. The ones below were taken before it was turned off.</p></div>
			{% endif %}

			<p class="backups-lead">{{ b.entries|length }} {{ b.entries|length == 1 ? 'change' : 'changes' }}, newest first. <strong>Restore</strong> takes the object back to just before that change.</p>

			<div class="backups-table-wrap">
				<table class="admin-table backups-history">
					<thead class="backups-sr">
						<tr><th>When</th><th>Who</th><th>What changed</th><th>Actions</th></tr>
					</thead>
					<tbody>
						{% if b.live %}
							<tr class="backups-now">
								<td class="backups-when">Now</td>
								<td colspan="3">The current version</td>
							</tr>
						{% endif %}
						{% set lastDay = '' %}
						{% for entry in b.entries %}
							{% set isOpen = b.open and b.open.file == entry.file %}
							{% set canView = entry.event != 'deleted' and entry.changed is not empty %}
							{% set entryDay = entry.at|date('Y-m-d') %}
							{% if entryDay != lastDay %}
								{% set lastDay = entryDay %}
								<tr class="backups-day"><th colspan="4" scope="colgroup">{{ ui.day(entry.at, today, yesterday) }}</th></tr>
							{% endif %}
							<tr class="{{ isOpen ? 'backups-open' }}">
								<td class="backups-when"><time datetime="{{ entry.at|e }}" title="{{ entry.at|date(full) }}">{{ entry.at|date('g:i A') }}</time></td>
								<td class="backups-who">{{ ui.who(entry.who) }}</td>
								<td class="backups-what">
									{% if entry.event == 'deleted' %}
										<span class="dash-badge sm warning">Deleted</span>
									{% elseif entry.changed is empty %}
										<span class="backups-muted">Saved with no change you would see</span>
									{% else %}
										{% for label in entry.changed %}<span class="dash-badge sm muted">{{ label|e }}</span>{% endfor %}
									{% endif %}
								</td>
								<td class="backups-actions">
									{% if canView %}
										<a class="dash-button transparent" href="{{ here }}&snapshot={{ entry.file|url_encode }}" data-compare aria-haspopup="dialog">Compare</a>
									{% endif %}
									{% if b.canRestore %}
										<a class="dash-button" href="{{ here }}&restore={{ entry.file|url_encode }}#restore" title="{{ entry.event == 'deleted' ? 'Bring the object back as it was when it was deleted' : 'Take the object back to just before this change' }}">Restore</a>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}

		{# ── One change, compared: a dialog, so the two versions have room ──
		   Rendered open, so it shows without scripts; the script below makes it modal. #}
		{% if b.open %}
			{% set o = b.open %}
			{% set day = ui.day(o.at, today, yesterday)|trim %}
			<dialog id="backups-compare" class="cms-modal large backups-dialog" open aria-labelledby="backups-compare-title" data-close="{{ here }}">
				<header class="backups-dialog-head">
					<h2 id="backups-compare-title">
						What changed {{ day in ['Today', 'Yesterday'] ? day|lower : 'on ' ~ day }} at {{ o.at|date('g:i A') }}{% if o.who %} <span class="backups-muted">by {{ (o.who|split('/')|last)|e }}</span>{% endif %}
					</h2>
					<a class="dash-button transparent backups-dialog-close" href="{{ here }}">Close</a>
				</header>
				<div class="backups-dialog-body">
					{{ ui.changes(o.changes, 'Before', 'After', b.canRestore ? 'Restore brings this back' : '', (b.canRestore and b.live) ? here ~ '&restore=' ~ (o.file|url_encode) : '', true) }}
				</div>
				{% if b.canRestore %}
					<footer class="backups-dialog-foot">
						<a class="dash-button" href="{{ here }}&restore={{ o.file|url_encode }}#restore">Restore everything to before this change</a>
						<span class="backups-muted">You will see what it does before anything changes.</span>
					</footer>
				{% endif %}
			</dialog>
		{% endif %}

		{# ── The files kept for it ── #}
		<header class="backups-heading">
			<h3>Kept files</h3>
			{% if b.files is not empty %}<span class="backups-count">They come back when you restore the version or the field that named them.</span>{% endif %}
		</header>
		{% if b.files is empty %}
			<div class="dash-empty-state">
				<em>
					No image or file of this object is kept.
					{% if not b.keeping.images and not b.keeping.files and not b.keeping.trash %}
						Replaced and removed files are not being kept at all: turn that on in <a href="settings/backups">Settings → Backups</a>.
					{% endif %}
				</em>
			</div>
		{% else %}
			<div class="backups-table-wrap">
				<table class="admin-table">
					<thead>
						<tr><th>Field</th><th>File</th><th>Set aside</th><th>Size</th><th></th></tr>
					</thead>
					<tbody>
						{% for file in b.files %}
							<tr>
								<td>{{ file.property|e }}{{ file.path ? ('/' ~ file.path)|e }}</td>
								<td>{{ file.name|e }}</td>
								<td class="backups-when">{% if file.at %}<time datetime="{{ file.at|e }}" title="{{ file.at|date(full) }}">{{ ui.day(file.at, today, yesterday) }}, {{ file.at|date('g:i A') }}</time>{% endif %}</td>
								<td class="backups-size">{{ file.size }}</td>
								<td>{{ file.trash ? '<span class="dash-badge sm muted">trash</span>' }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}

	{% else %}

		<p class="backups-muted">Choose a collection to list its deleted objects, or add an object ID to open one object's history. On an object's edit form, <strong>Restore from Backup</strong> in the ⋯ menu brings you straight here.</p>

	{% endif %}

</section>

{# Compare opens in a modal without leaving the page. Without scripts the link
   still works: the page comes back with the same dialog already open. #}
<script>
(() => {
	const root = document.querySelector('.backups-util');
	if (!root) return;

	const show = dialog => {
		// It arrives open, as a plain block. showModal() needs it closed, and
		// removing the attribute closes it without a close event.
		dialog.removeAttribute('open');
		dialog.showModal();

		dialog.addEventListener('close', () => {
			history.replaceState(null, '', new URL(dialog.dataset.close, document.baseURI));
			root.querySelector('tr.backups-open')?.classList.remove('backups-open');
			dialog.remove();
		}, { once: true });
		dialog.querySelector('.backups-dialog-close')?.addEventListener('click', event => {
			event.preventDefault();
			dialog.close();
		});
		// A click on the backdrop lands on the dialog itself.
		dialog.addEventListener('click', event => {
			if (event.target === dialog) dialog.close();
		});
	};

	const present = document.getElementById('backups-compare');
	if (present) show(present);

	root.addEventListener('click', async event => {
		const link = event.target.closest('a[data-compare]');
		if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
		event.preventDefault();

		try {
			const response = await fetch(link.href, { credentials: 'same-origin' });
			const page     = new DOMParser().parseFromString(await response.text(), 'text/html');
			const dialog   = page.getElementById('backups-compare');
			if (!response.ok || !dialog) throw new Error('no comparison in the answer');

			document.getElementById('backups-compare')?.remove();
			root.append(document.adoptNode(dialog));
			history.replaceState(null, '', link.href);
			link.closest('tr')?.classList.add('backups-open');
			show(dialog);
		} catch {
			// Whatever went wrong, the plain link still shows it.
			location.href = link.href;
		}
	});
})();
</script>
