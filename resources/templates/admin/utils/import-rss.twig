<h1>{{ t('import_rss.title') }}</h1>

{% set action = getData.action %}

<section class="dash-content-section">
	<div class="rss-import-description">
		<p>{{ t('import_rss.desc') }}</p>
	</div>

	{% set analyzeFields %}
		{{ cms.form.field("text", "url", {
			label       : t('import_rss.feed_url'),
			placeholder : t('import_rss.feed_url_ph'),
			help        : t('import_rss.feed_url_help'),
			value       : postData.url | default(''),
			required    : true
		}) }}
	{% endset %}

	{{ cms.form.simple(url.path, analyzeFields, {
		method : "POST",
		label  : t('import_rss.analyze_btn'),
		ajax   : false
	}) }}

	{% if rssError %}
		<div class="message error">{{ t('import_rss.analysis_failed') }} {{ rssError }}</div>
		<p><a class="dash-button transparent" href="utils/import-rss">{{ t('btn.try_again') }}</a></p>
	{% endif %}

	{% if rssAnalysis %}
		{% set feed = rssAnalysis.feed %}
		{% set entries = rssAnalysis.entries %}

		{% if entries is empty %}
			<div class="message error">{{ t('import_rss.no_entries') }}</div>
			<p><a class="dash-button transparent" href="utils/import-rss">{{ t('btn.try_again') }}</a></p>
		{% else %}

			<div class="rss-feed-info">
				{% if feed.title %}<h3>{{ feed.title }}</h3>{% endif %}
				{% if feed.description %}<p>{{ feed.description }}</p>{% endif %}
				<p><strong>{{ feed.count }} {{ t('import_rss.entries') }}</strong> found in this feed.</p>
			</div>

			{% set importFields %}
				{{ cms.form.field("hidden", "url", {
					value : postData.url | default('')
				}) }}

				{{ cms.form.field("select", "collection", {
					label       : t('import_rss.target_collection'),
					help        : t('import_rss.select_collection'),
					options     : cms.collection.list() | map(c => { value: c.id, label: c.name }) | sortBy("label"),
					value       : "blog"
				}) }}

				{{ cms.form.field("checkbox", "draft", {
					label : t('import_rss.import_as_drafts'),
					help  : t('import_rss.drafts_desc'),
					value : true
				}) }}

				<details class="rss-field-mapping">
					<summary><strong>{{ t('import_rss.field_mapping') }}</strong></summary>
					<div style="margin-top: 0.5rem;">
						<p class="help" style="margin-bottom: 0.5rem;">{{ t('import_rss.field_mapping_desc') }} {{ t('import_rss.leave_empty') }}</p>
						<p class="help" style="margin-bottom: 0.5rem;">{{ t('import_rss.field_mapping_columns') }}</p>

						{% set fieldDefaults = { title: 'title', content: 'content', summary: 'summary', date: 'date', author: 'author', categories: 'categories', link: 'media', image: 'image' } %}
						{% for rssField, defaultValue in fieldDefaults %}
							{{ cms.form.field("text", "fieldMap[" ~ rssField ~ "]", {
								label       : rssField,
								value       : defaultValue,
								placeholder : t('import_rss.collection_field')
							}) }}
						{% endfor %}
					</div>
				</details>

				<details class="rss-cron-panel">
					<summary><strong>{{ t('import_rss.cron_title') }}</strong></summary>
					<div style="margin-top: 0.5rem;">
						<p>{{ t('import_rss.cron_desc')|raw }}</p>
						<p><em>{{ t('jobqueue.php_path_note') }} {{ t('jobqueue.server_note') }}</em></p>

						<pre class="jobqueue-command"><code id="rss-cron-command-text" data-tcms-prefix="{{ cms.admin.tcmsCommandPrefix() }}">{{ cms.admin.tcmsCommandPrefix() }} rss:import …</code></pre>
						<button type="button" class="cms-clip-button dash-button transparent" data-clip="#rss-cron-command-text">{{ t('btn.copy_command') }}</button>

						<p class="rss-cron-note">{{ t('import_rss.cron_field_mapping_note')|raw }} <a href="docs/extensions/cli#rss-import" target="_blank">{{ t('import_rss.cron_docs_link') }}</a>.</p>
					</div>
				</details>

			{% endset %}

			{{ cms.form.simple("/import/rss", importFields, {
				method : "POST",
				label  : "Import All " ~ entries|length ~ " Entries",
				class  : "rss-import-form",
			}) }}

			<div id="rss-import-result"></div>

			<div class="rss-entry-preview">
				<h3>{{ t('import_rss.entry_preview') }}</h3>
				<div class="rss-entry-list">
					{% for entry in entries %}
						<div class="rss-entry-item">
							<strong>{{ entry.title }}</strong>
							{% set meta = [] %}
							{% if entry.date %}{% set meta = meta|merge([entry.date|date('M j, Y')]) %}{% endif %}
							{% if entry.author %}{% set meta = meta|merge([entry.author]) %}{% endif %}
							{% if entry.hasImage %}{% set meta = meta|merge([t('import_rss.has_image')]) %}{% endif %}
							{% if meta is not empty %}
								<div class="rss-entry-meta">{{ meta|join(' &middot; ') }}</div>
							{% endif %}
							{% if entry.summary %}
								<div class="rss-entry-summary">{{ entry.summary }}</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}
	{% endif %}

	<script>
		const importForm = document.querySelector('.rss-import-form');
		if (importForm) {
			importForm.addEventListener('simpleform:success', function(e) {
				const data = e.detail.data;
				const msg = data?.message || '{{ t('import_rss.queued') }}';

				document.getElementById('rss-import-result').innerHTML =
					`<div class="message success">${msg}</div>` +
					'<p>{{ t('import_rss.queued') }}</p>';

				const preview = document.querySelector('.rss-entry-preview');
				if (preview) preview.style.display = 'none';

				this.style.display = 'none';
			});

			// Live-update the base cron command as the user edits URL / collection /
			// draft. Field mapping is intentionally NOT mirrored here — operators
			// configure it once in the form for their click-through import, then
			// translate to `--map feedField=collectionProperty` in their crontab.
			// The docs link in the panel covers the full mapping syntax.
			const cronText = document.getElementById('rss-cron-command-text');
			const cronPrefix = cronText?.dataset.tcmsPrefix || 'tcms';

			const shellQuote = (s) => `"${String(s).replace(/(["\\$`])/g, '\\$1')}"`;

			const buildCron = () => {
				const url = importForm.querySelector('[name="url"]')?.value || '';
				const collection = importForm.querySelector('[name="collection"]')?.value || '';
				const draft = importForm.querySelector('[name="draft"]')?.checked ?? true;

				const parts = [cronPrefix, 'rss:import', shellQuote(url), collection || '<collection>'];
				if (!draft) parts.push('--no-draft');

				cronText.textContent = parts.join(' ');
			};

			importForm.addEventListener('input', buildCron);
			importForm.addEventListener('change', buildCron);
			buildCron();
		}
	</script>

</section>

<style>
.dash-content-section { max-width: 800px; }
.rss-import-description { margin-bottom: 1rem; }
.message { padding: 1rem; border-radius: var(--totalform-radius); margin: 1rem 0; }
.message.success { background-color: oklch(var(--totalform-success) / 0.1); border: 1px solid oklch(var(--totalform-success)); }
.message.error { background-color: oklch(var(--totalform-error) / 0.1); border: 1px solid oklch(var(--totalform-error)); }
.rss-feed-info { margin-top: 1rem; padding: 1rem; background: oklch(var(--totalform-nearwhite)); border-radius: var(--totalform-radius); }
.rss-entry-preview { margin-top: 1.5rem; }
.rss-entry-preview h3 { margin-bottom: 1rem; }
.rss-entry-list {
	max-height    : 400px;
	overflow-y    : auto;
	padding       : 1rem;
	border        : 1px solid oklch(var(--totalform-border-color));
	border-radius : var(--totalform-radius);
	background    : oklch(var(--totalform-nearwhite));
	font-size     : 0.85rem;
	line-height   : 1.5;
}
.rss-entry-item { padding: 0.75rem 0; border-bottom: 1px solid oklch(var(--totalform-border-color) / 0.5); }
.rss-entry-item:first-child { padding-top: 0; }
.rss-entry-item:last-child { border-bottom: none; padding-bottom: 0; }
.rss-entry-meta { font-size: 0.8rem; color: oklch(var(--totalform-darkgray)); margin-top: 0.25rem; }
.rss-entry-summary { font-size: 0.8rem; color: oklch(var(--totalform-text-color)); margin-top: 0.25rem; }
.rss-field-mapping, .rss-cron-panel {
	border: 1px solid oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
	padding: 0.75rem;
	margin-top: 1rem;
}
.rss-field-mapping summary, .rss-cron-panel summary { cursor: pointer; }
.rss-cron-panel .jobqueue-command {
	width         : 100%;
	max-width     : 100%;
	overflow-x    : auto;
	white-space   : nowrap;
	background    : oklch(var(--totalform-nearwhite));
	border        : 1px solid oklch(var(--totalform-border-color));
	border-radius : var(--totalform-radius);
	padding       : 1rem;
	font-size     : 0.9em;
	box-sizing    : border-box;
	margin        : 0.5rem 0;
}
.rss-cron-panel .jobqueue-command code {
	white-space : nowrap;
	display     : block;
}
.rss-cron-note {
	margin-top    : 0.75rem;
	max-width     : 100% !important;
	font-size     : var(--totalform-help-size);
	font-style    : italic;
	color         : oklch(var(--totalform-help-color));
}
.rss-cron-note a {
	color           : oklch(var(--totalform-accent));
	text-decoration : underline;
}
</style>