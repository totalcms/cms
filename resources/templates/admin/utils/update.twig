<h1>{{ t('update.title') }}</h1>

<section class="update-utility">

	<div class="update-current">
		<h3>{{ t('update.current_version') }}</h3>
		<p class="version-number">{{ cms.version }}</p>
	</div>

	{% if updateInfo %}
	<div class="update-license-info">
		{% if updateInfo.updatesExpireDate %}
			<p>{{ t('update.expires') }}: <strong>{{ updateInfo.updatesExpireDate }}</strong></p>
		{% endif %}
		{% if not updateInfo.updatesValid %}
			<p class="update-expired-notice">{{ t('update.expired_notice') }} <a href="utils/license-manager">{{ t('update.renew_link') }}</a></p>
		{% endif %}
	</div>
	{% endif %}

	{% if updateInfo and updateInfo.available %}
	<div class="update-available">
		<h3>{{ t('update.available') }}</h3>
		<div class="update-details">
			<p class="version-number new-version">{{ updateInfo.version }}</p>
			<span class="severity-badge severity-{{ updateInfo.severity }}">{{ updateInfo.severity }}</span>
			<p class="release-date">{{ t('update.released') }}: {{ updateInfo.releaseDate }}</p>
		</div>

		{% if updateInfo.changelog %}
		<div class="update-changelog">
			{{ updateInfo.changelog|markdown }}
		</div>
		{% endif %}
	</div>

	<div class="update-actions" id="update-actions">
		{% if composerInstall %}
		<div class="update-composer-notice">
			<p>This installation is managed by Composer. Run <code>composer update totalcms/cms</code> to update.</p>
		</div>
		{% elseif updateInfo.updatesValid %}
		<label class="update-keep-backup">
			<input type="checkbox" id="keep-backup" checked>
			{{ t('update.keep_backup') }}
		</label>
		<button type="button" class="dash-button" id="update-btn">
			{{ t('update.update_btn', {'{version}': updateInfo.version}) }}
		</button>
		{% else %}
		<div class="update-renew-notice">
			<p>{{ t('update.renew_required') }} <a href="utils/license-manager">{{ t('update.renew_link') }}</a></p>
		</div>
		{% endif %}
	</div>
	{% else %}
	<div class="update-current-notice">
		<p>{{ t('update.up_to_date') }}</p>
	</div>
	<div class="update-check-action">
		<a href="utils/update?check=1" class="dash-button transparent">{{ t('update.check_btn') }}</a>
	</div>
	{% endif %}

	{% if retainedBackup %}
	<div class="update-previous" id="update-previous">
		<div class="update-previous-info">
			<strong>{{ t('update.previous') }}</strong>
			<span class="update-previous-meta">{{ retainedBackup.name }} &middot; {{ (retainedBackup.bytes / 1048576)|round }} MB</span>
			<p class="update-previous-hint">{{ t('update.previous_hint')|raw }}</p>
		</div>
		<button type="button" class="dash-button transparent" id="delete-backup-btn">{{ t('update.previous_delete') }}</button>
	</div>
	{% endif %}

	<div id="update-results"></div>

</section>

<style>
.update-utility {
	display: grid;
	align-content: start;
	gap: 1.5rem;
	max-width: 700px;
}

.update-current .version-number {
	font-size: 1.5rem;
	font-weight: 600;
}

.update-license-info {
	color: oklch(var(--totalform-darkgray));
	font-size: 0.9rem;
}

.update-expired-notice {
	color: oklch(var(--totalform-error));
	font-weight: 500;
}

.update-renew-notice {
	color: oklch(var(--totalform-error));
}

.update-composer-notice {
	color: oklch(var(--totalform-darkgray));
}

.update-composer-notice code {
	background: oklch(var(--totalform-nearwhite));
	padding: 0.15rem 0.4rem;
	border-radius: 3px;
	font-size: 0.9em;
}

.update-available {
	background: oklch(var(--totalform-nearwhite));
	border: 1px solid oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
	padding: 1.5rem;
}

.update-available h3 {
	margin-top: 0;
}

.new-version {
	font-size: 1.3rem;
	font-weight: 600;
	display: inline;
	margin-right: 0.75rem;
}

.severity-badge {
	display: inline-block;
	padding: 0.15rem 0.6rem;
	border-radius: 1rem;
	font-size: 0.8rem;
	font-weight: 600;
	text-transform: uppercase;
	vertical-align: middle;
}

.severity-patch { background: oklch(var(--totalform-accent) / 0.15); color: oklch(var(--totalform-accent)); }
.severity-minor { background: oklch(0.8 0.15 85 / 0.2); color: oklch(0.5 0.15 85); }
.severity-major { background: oklch(var(--totalform-error) / 0.15); color: oklch(var(--totalform-error)); }

.release-date {
	color: oklch(var(--totalform-darkgray));
	font-size: 0.9rem;
	margin-top: 0.5rem;
}

.update-changelog {
	margin-top: 1.5rem;
	padding-top: 1rem;
	border-top: 1px solid oklch(var(--totalform-border-color));
	display: grid;
	gap: 1rem;
	font-size: 0.9em;
}

.update-changelog > * {
	margin : 0!important;
}

.update-actions {
	margin-top: 1.5rem;
}

.update-current-notice {
	color: oklch(var(--totalform-success));
	font-weight: 500;
}

.update-keep-backup {
	display: flex;
	align-items: center;
	gap: 6px;
	margin-bottom: 10px;
	font-size: 0.9rem;
	color: oklch(var(--totalform-darkgray));
}

.update-previous {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 16px;
	margin-top: 24px;
	padding: 12px 16px;
	background: oklch(var(--totalform-nearwhite));
	border: 1px solid oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
}

.update-previous-meta {
	margin-left: 8px;
	color: oklch(var(--totalform-darkgray));
}

.update-previous-hint {
	margin: 4px 0 0;
	font-size: 0.85rem;
	color: oklch(var(--totalform-darkgray));
}

.update-installing {
	text-align: center;
	padding: 2rem 1rem;
}

.update-installing.success h3 {
	color: oklch(var(--totalform-success));
}

.update-installing.error h3 {
	color: oklch(var(--totalform-error));
}
</style>

<script>
document.getElementById('update-btn')?.addEventListener('click', async () => {
	if (!confirm('{{ t('update.confirm') }}')) return;

	const available = document.querySelector('.update-available');
	const results = document.getElementById('update-results');

	// The actions block sits OUTSIDE the card whose innerHTML is replaced with
	// the installing message, so it has to be removed by hand — otherwise the
	// button stays live while the update runs.
	const keepBackupEl = document.getElementById('keep-backup');
	const keepBackup   = keepBackupEl ? keepBackupEl.checked : true;
	document.getElementById('update-actions')?.remove();

	available.innerHTML = '<div class="update-installing"><h3>Installing Update&hellip;</h3><p>Please wait while the update is being applied. Do not close this page.</p></div>';
	results.innerHTML = '';

	try {
		const res = await fetch('utils/update/apply', {
			method: 'POST',
			headers: {
				'X-Requested-With': 'XMLHttpRequest',
				'X-CSRF-Token': '{{ csrf_token() }}',
				'Content-Type': 'application/json',
			},
			body: JSON.stringify({ keepBackup: keepBackup }),
		});
		const data = await res.json();
		if (data.success) {
			available.innerHTML = `<div class="update-installing success"><h3>${data.message}</h3></div>`;
			setTimeout(() => location.reload(), 2000);
		} else {
			available.innerHTML = `<div class="update-installing error"><h3>Update Failed</h3><p>${data.error}</p></div>`;
		}
	} catch (err) {
		available.innerHTML = `<div class="update-installing error"><h3>Update Failed</h3><p>Unexpected error. Check the server logs.</p></div>`;
	}
});

const deleteBackupBtn = document.getElementById('delete-backup-btn');
if (deleteBackupBtn) {
	deleteBackupBtn.addEventListener('click', async () => {
		deleteBackupBtn.disabled = true;
		try {
			const res = await fetch('utils/update/backup/delete', {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest',
					'X-CSRF-Token': '{{ csrf_token() }}',
				},
			});
			const data = await res.json();
			if (data.success) {
				document.getElementById('update-previous').remove();
			} else {
				deleteBackupBtn.disabled = false;
			}
		} catch (e) {
			deleteBackupBtn.disabled = false;
		}
	});
}
</script>
