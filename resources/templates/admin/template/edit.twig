{% set templatesLocked = cms.admin.templatesLocked() %}
<header>
	<h1><a href="templates">templates</a> / <span>{{ url.template }}</span></h1>
	{% if cms.auth.canAccessTemplates() and not templatesLocked %}
	<button class="dash-action-dots" title="Template Actions" popovertarget="template-actions"></button>
	<nav popover id="template-actions">
		<ul>
			<li class="duplicate"><a href="#" onclick="duplicateTemplate(event)">Duplicate</a></li>
		</ul>
	</nav>
	{% endif %}
</header>

{% if templatesLocked %}
<div class="warning-box" role="status">
	<div>
		<strong>{{ t('template.locked.title') }}</strong>
		<p>{{ t('template.locked.banner') }}</p>
	</div>
</div>
{% endif %}

{{ cms.form.template({
	path        : url.template,
	save        : (cms.auth.canAccessTemplates() and not templatesLocked) ? "Save" : false,
	delete      : (cms.auth.canAccessTemplates() and not templatesLocked) ? "Delete" : false,
	helpStyle   : 'label',
	helpOnFocus : true,
	deleteActions : [
		{
			"action" : "redirect",
			"link"   : "templates"
		}
	],
	editActions : [
		{
			"action" : "refresh",
		}
	],
}) }}

<script>
function duplicateTemplate(event) {
	event.preventDefault();
	// Get the current form data
	const form = document.querySelector('form[data-form="template"]');
	if (!form || !form.totalform) {
		console.error('Template form not found');
		return;
	}

	const formData = form.totalform.generateData();

	// Create a temporary form to POST the data to /admin/templates/new
	const tempForm               = document.createElement('form');
	      tempForm.method        = 'POST';
	      tempForm.action        = 'templates/new';
	      tempForm.style.display = 'none';

	// Add form data as hidden inputs
	for (const [key, value] of Object.entries(formData)) {
		const input = document.createElement('input');
		input.type = 'hidden';
		input.name = key;
		input.value = typeof value === 'object' ? JSON.stringify(value) : value;
		tempForm.appendChild(input);
	}

	// CSRF token — without this CSRFProtectionMiddleware rejects the POST with 403.
	const csrfMeta = document.querySelector('meta[name="csrf-token"]');
	if (csrfMeta) {
		const csrfInput = document.createElement('input');
		csrfInput.type  = 'hidden';
		csrfInput.name  = 'csrf_token';
		csrfInput.value = csrfMeta.getAttribute('content');
		tempForm.appendChild(csrfInput);
	}

	document.body.appendChild(tempForm);
	tempForm.submit();
}
</script>
