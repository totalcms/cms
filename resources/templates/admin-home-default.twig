{% import 'dashboard-widgets.twig' as dashboard %}

{# Alerts: critical ones (something is broken, or will lock you out) are
   banners across the top; the rest go in the sidebar's Needs Attention card. #}
{% set alerts = [] %}
{% if cms.auth.isAdmin() %}
	{% set alerts = cms.admin.dashboardAlerts() %}
	{% if cms.edition.isSimulating %}
		{% set alerts = [{level: 'warning', message: t('dashboard.simulation_warning', {'{edition}': cms.edition.current | capitalize}), link: 'settings/license', linkText: t('dashboard.disable_simulation'), critical: true}]|merge(alerts) %}
	{% endif %}
	{{ dashboard.criticalAlerts(alerts|filter(alert => alert.critical)) }}
{% endif %}

{# Get dashboard data #}
{% set stats = cms.admin.dashboardStats() %}
{% set collections = cms.admin.dashboardRecentCollections() %}
{% set emptyCollections = cms.admin.dashboardEmptyCollections() %}
{% set systemStatus = cms.admin.dashboardSystemStatus() %}
{% set inaccessibleCollections = cms.admin.inaccessibleCollections() %}


{% if stats.collections <= 3 %}
	{# Show new user welcome if no user collections exist (accounts for system collections: auth, mailer) #}
	{{ dashboard.newUserWelcome() }}
{% else %}
	{# Display welcome message #}
	{{ include(cms.edition.can('whitelabel_standard')
		? ['whitelabel/admin-welcome.twig', 'admin-welcome-message.twig']
		: ['admin-welcome-message.twig']
	, ignore_missing = true) }}

	{# Display quick stats #}
	{{ dashboard.statsCard(stats) }}

	{# Display quick actions #}
	{{ dashboard.quickActions(cms.admin.dashboardQuickActions()) }}

	{# Main content area - two column layout #}
	<div class="dashboard-grid">
		<div class="dashboard-main">
			{# Recent activity from the activity log — admins only #}
			{% if cms.auth.isAdmin() %}
				{{ dashboard.recentActivity(cms.admin.dashboardRecentActivity(25)) }}
			{% endif %}

			{# Collections overview table #}
			{{ dashboard.collectionsTable(collections) }}

			{# Inaccessible collections alert (edition downgrade) #}
			{{ dashboard.inaccessibleCollectionsAlert(inaccessibleCollections) }}

			{# Empty collections beside what visitors added; either takes the
			   full width when the other has nothing to show #}
			<div class="dashboard-pair">
				{{ dashboard.emptyCollectionsAlert(emptyCollections) }}
				{% if cms.auth.isAdmin() %}
					{{ dashboard.siteSubmissions(cms.admin.dashboardSiteSubmissions()) }}
				{% endif %}
			</div>

			{# Extension widgets (main area) #}
			{% if extensionDashWidgets is defined %}
				{% for widget in extensionDashWidgets %}
					{% if widget.position == 'main' and cms.auth.canAccessExtension(widget.extensionId) %}
						{% include widget.template ignore missing %}
					{% endif %}
				{% endfor %}
			{% endif %}
		</div>

		<div class="dashboard-sidebar">
			{# Alerts that are not critical; hidden when there are none #}
			{{ dashboard.needsAttention(alerts|filter(alert => not alert.critical)) }}

			{# Development mode toggle #}
			{% if cms.auth.isAdmin() %}
				{{ dashboard.devModeToggle() }}
			{% endif %}

			{# Automations widget #}
			{% if cms.auth.isAdmin() %}
				{% set automations = cms.admin.dashboardAutomations() %}
				{% if automations %}
					{{ dashboard.automationsWidget(automations) }}
				{% endif %}
			{% endif %}

			{# System status #}
			{% if cms.auth.isAdmin() %}
				{{ dashboard.systemStatus(systemStatus) }}
			{% endif %}

			{# Extension widgets (sidebar) #}
			{% if extensionDashWidgets is defined %}
				{% for widget in extensionDashWidgets %}
					{% if widget.position == 'sidebar' and cms.auth.canAccessExtension(widget.extensionId) %}
						{% include widget.template ignore missing %}
					{% endif %}
				{% endfor %}
			{% endif %}
		</div>
	</div>
{% endif %}
