{% extends "admin-layout.twig" %}

{% block title %}{{ t('wizard.welcome') }}{% endblock %}

{% block content %}
<main class="login-layout admin-layout">
	<section class="welcome-header">
		<h1>{{ t('wizard.welcome') }}</h1>
		<p>{{ t('wizard.welcome_desc') }}</p>
	</section>

	<form method="post" action="{{ cms.base }}/setup" class="welcome-form">
		<div class="welcome-field">
			<label for="locale-select">{{ t('wizard.language') }}</label>
			<select id="locale-select" onchange="location.href='?lang='+this.value">
				{% for code, label in locales %}
				<option value="{{ code }}" {{ currentLocale == code ? 'selected' : '' }}>{{ label }}</option>
				{% endfor %}
			</select>
		</div>

		<div class="welcome-field">
			<label for="site-name">{{ t('wizard.site_name') }}</label>
			<input
				type="text"
				id="site-name"
				name="siteName"
				value="{{ siteName }}"
				placeholder="{{ t('wizard.site_name_placeholder') }}"
				autocomplete="off"
				autofocus>
			<p class="welcome-help">{{ t('wizard.site_name_help') }}</p>
		</div>

		<button type="submit" class="dash-button setup-continue">{{ t('wizard.get_started') }}</button>
	</form>
</main>

<style>
.welcome-header {
	text-align: center;
}

.welcome-header h1 {
	font-size: 2rem;
	margin-bottom: 0.5rem;
}

.welcome-form {
	display: flex;
	flex-direction: column;
	gap: 1.25rem;
	max-width: 320px;
	margin: 0 auto;
}

.welcome-field {
	display: flex;
	flex-direction: column;
	gap: 0.4rem;
}

.welcome-field label {
	font-weight: 500;
	color: oklch(var(--totalform-darkgray));
	font-size: 0.9rem;
}

.welcome-field select,
.welcome-field input {
	padding: 0.4rem 0.75rem;
	border: 1px solid oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
	background: oklch(var(--totalform-nearwhite));
	font-size: 0.95rem;
	cursor: pointer;
	width: 100%;
	box-sizing: border-box;
}

.welcome-field input {
	cursor: text;
}

.welcome-help {
	margin: 0;
	font-size: 0.8rem;
	color: oklch(var(--totalform-darkgray) / 0.7);
}

.setup-continue {
	text-align: center;
	margin-top: 0.5rem;
}
</style>
{% endblock %}
