{% extends "admin-layout.twig" %}

{% block title %}{{ t('wizard.license_title') }}{% endblock %}

{% block content %}
<main class="login-layout admin-layout">
	<section class="setup-header">
		<h1>{{ t('wizard.license_title') }}</h1>
		{# In the register/code states the step-specific line below is the real
		   subtitle; the generic "license validated" copy would be misleading. #}
		{% if not (pending or needsRegistration) %}
			<p>{{ t('wizard.license_desc') }}</p>
		{% endif %}
	</section>

	{% for message in flash.get('error') %}
		<div class="cms-error" role="alert">
			{{ message }}
		</div>
	{% endfor %}

	{% if pending %}
		<p>{{ t('wizard.license_code_sent', {'{email}': pending.email}) }}</p>
		{% set codeFields %}
			{{ cms.form.field("text", "code", {
				label       : t('wizard.license_code'),
				required    : true,
				placeholder : "123456",
				settings    : { maxlength: 6 },
			}) }}
		{% endset %}
		{{ cms.form.simple(cms.base ~ '/setup/license/verify', codeFields, {
			class  : "setup-form",
			method : "POST",
			label  : t('wizard.license_code_btn'),
			ajax   : false,
		}) }}
		<form method="POST" action="{{ cms.base }}/setup/license" class="license-resend">
			<button type="submit" class="dash-button transparent">{{ t('wizard.license_resend') }}</button>
		</form>
	{% elseif needsRegistration %}
		<p>{{ t('wizard.license_register_intro') }}</p>
		{% set regFields %}
			{{ cms.form.field("text", "name", {
				label       : t('wizard.license_name'),
				required    : true,
				value       : prefillName,
			}) }}
			{{ cms.form.field("email", "email", {
				label       : t('wizard.license_email'),
				required    : true,
				value       : prefillEmail,
			}) }}
		{% endset %}
		{{ cms.form.simple(cms.base ~ '/setup/license', regFields, {
			class  : "setup-form",
			method : "POST",
			label  : t('wizard.license_start_btn'),
			ajax   : false,
		}) }}
	{% elseif error %}
		<div class="cms-error" role="alert">
			{{ t('wizard.license_error', {'{error}': error}) }}
		</div>
		<p>{{ t('wizard.license_skip') }}</p>
	{% elseif license %}
		<table class="license-table">
			<tr>
				<td><strong>{{ t('wizard.license_domain') }}</strong></td>
				<td>{{ license.domain }}</td>
			</tr>
			<tr>
				<td><strong>{{ t('wizard.license_edition') }}</strong></td>
				<td>{{ license.edition|capitalize }}</td>
			</tr>
			<tr>
				<td><strong>{{ t('wizard.license_status') }}</strong></td>
				<td>
					{% if license.trial %}
						{{ t('wizard.license_trial') }}
						{# Development Editions show 999999 days. I don't want to show that #}
						{% if license.trialDaysRemaining is not null and license.trialDaysRemaining < 100 %}
							({{ t('wizard.license_days', {'{days}': license.trialDaysRemaining}) }})
						{% endif %}
					{% elseif license.valid %}
						{{ t('wizard.license_active') }}
					{% else %}
						{{ t('wizard.license_invalid') }}
					{% endif %}
				</td>
			</tr>
		</table>
	{% endif %}

	{% if pending or needsRegistration %}
		{# Registering is the primary action here, so the skip is demoted to a
		   quiet link — but kept, so a customer with a license key or a dev
		   install isn't trapped on this step. #}
		<a href="{{ cms.base }}/setup/error-monitoring" class="setup-skip-link">{{ t('wizard.license_skip_link') }}</a>
	{% else %}
		<a href="{{ cms.base }}/setup/error-monitoring" class="dash-button setup-continue">{{ t('wizard.continue') }}</a>
	{% endif %}
</main>

<style>
.license-table {
	width: 100%;
	max-width: 400px;
	border-collapse: collapse;
	margin-block: 1.5rem;
}

.license-table td {
	padding: 0.6rem 0.75rem;
	border-bottom: 1px solid oklch(var(--totalform-border-color));
}

.license-table td:first-child {
	width: 120px;
	color: oklch(var(--totalform-darkgray));
}

.setup-continue {
	margin-top: 1rem;
}

.license-resend {
	margin-top: 0.75rem;
}

.setup-skip-link {
	display: inline-block;
	margin-top: 1.5rem;
	color: oklch(var(--totalform-darkgray));
	font-size: 0.9rem;
	text-decoration: underline;
}

.setup-skip-link:hover {
	color: oklch(var(--totalform-text-color));
}
</style>
{% endblock %}
