{# Sidebar entry helpers. `navActive` echoes "1" when the entry is the current
   page (core entries match the page slug, extension entries the URL suffix);
   `navLink` renders the anchor the rail and the More popover share. The
   --action-icon custom property is what the popover's icon mask reads. #}
{% macro navActive(entry, url) %}{% if entry.isExtension ? (url.path ends with entry.slug) : (url.page == entry.id) %}1{% endif %}{% endmacro %}
{% macro navLink(entry, class) %}{% if entry.isExtension %}<a class="ext-nav{{ class ? ' ' ~ class }}" href="{{ entry.url }}" title="{{ entry.label }}"{% if entry.icon %} style="--ext-icon: url('data:image/svg+xml,{{ entry.icon|url_encode }}'); --action-icon: var(--ext-icon)"{% endif %}>{{ entry.label }}</a>{% else %}<a class="{{ entry.id }}{{ class ? ' ' ~ class }}" href="{{ entry.url }}" title="{{ entry.label }}" style="--action-icon: {{ entry.icon }}">{{ entry.label }}</a>{% endif %}{% endmacro %}
<!doctype html>
<html lang="{{ cms.locale.htmlLang() }}">
<head>
	<meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
	<meta name="robots" content="noindex, nofollow">
	<title>{{ cms.adminTitle }}</title>

	{# Apply theme immediately to prevent flash of wrong theme #}
	<script>
		(function() {
			const saved = localStorage.getItem('totalcms-theme');
			const theme = ['auto', 'light', 'dark'].includes(saved) ? saved : 'auto';
			const html  = document.documentElement;

			html.classList.remove('theme-light', 'theme-dark', 'theme-auto');
			html.classList.add('theme-' + theme);

			switch (theme) {
				case 'light':
					html.style.colorScheme = 'light';
					break;
				case 'dark':
					html.style.colorScheme = 'dark';
					break;
				case 'auto':
				default:
					html.style.colorScheme = 'light dark';
					break;
			}
		})();
	</script>

	{% include 'partials/sentry.twig' %}

	<meta name="csrf-token" content="{{ csrf_token() }}">
    <base href="{{ cms.dashboard }}/">

	{% block head %}{% endblock %}
	{# dashboard.css ships the global reset (* { margin: 0 }, normalize rules) the dashboard chrome relies on.
	   It is deliberately NOT in adminAssetsHead() so customers using that helper on their own admin pages
	   don't get the reset bleeding into their content. Load it here explicitly for the dashboard frame. #}
	<link rel="stylesheet" href="{{ cms.api }}/assets/dashboard.css?v={{ cms.version }}"/>
	{{ cms.adminAssetsHead() }}

	{% if cms.edition.can('whitelabel_pro') %}
		{{ include('whitelabel/admin-head.twig', ignore_missing = true) }}
	{% endif %}

	{% set accentColor = cms.config('dashboard', 'accent') %}
	{% if accentColor %}
	<style>:root{--totalform-accent:{{ accentColor | hexToColor | oklch(100, false) }};}</style>
	{% endif %}
</head>
<body{% if cms.config('dashboard', 'fullWidthForms') %} class="full-width-forms"{% endif %}>

    {% block content %}

    <div class="admin-dashboard">
        <button class="mobile-menu-toggle" aria-label="Toggle menu"></button>
        <div class="mobile-overlay"></div>

        <aside class="dash-sidebar">
            <nav>
                <ul class="menu">
                    <li class="menu-item">
						{{ include(cms.edition.can('whitelabel_pro')
							? ['whitelabel/admin-logo.twig', 'admin-logo-default.twig']
							: ['admin-logo-default.twig']
						, ignore_missing = true) }}
                    </li>
                    <li class="menu-item">
                        <button class="quick-nav-trigger" type="button" title="Quick Navigation (&#x21E7;&#x2318;O)"></button>
                    </li>
                    {# One registry drives the rail, the More menu and quick-nav — see AdminNavRegistry. #}
                    {% set navMenu = cms.admin.navMenu() %}
                    {% for entry in navMenu.rail %}
                    <li class="menu-item{% if _self.navActive(entry, url) %} active{% endif %}">
                        {{ _self.navLink(entry) }}
                    </li>
                    {% endfor %}
                    {% if navMenu.more is not empty %}
                    {% set moreActive = false %}
                    {% for entry in navMenu.more %}{% if _self.navActive(entry, url) %}{% set moreActive = true %}{% endif %}{% endfor %}
                    <li class="menu-item nav-more-item{% if moreActive %} active{% endif %}">
                        <button class="nav-more" type="button" popovertarget="nav-more" title="{{ t('nav.more') }}">{{ t('nav.more') }}</button>
                        <nav popover id="nav-more">
                            <ul>
                                {% for entry in navMenu.more %}
                                <li>{{ _self.navLink(entry, _self.navActive(entry, url) ? 'active' : '') }}</li>
                                {% endfor %}
                            </ul>
                        </nav>
                    </li>
                    {% endif %}
                </ul>
            </nav>

            {% set licenseStatus = cms.license.getSidebarStatus() %}
            {% if licenseStatus.showIcon and cms.auth.isAdmin() %}
            <a href="utils/license-manager"
				class="license-status license-{{ licenseStatus.severity }}"
				title="{{ licenseStatus.tooltip }}">{{ t('nav.license_status') }}</a>
            {% endif %}

            <div class="user-profile" >
                {% if cms.auth.userLoggedIn %}
                <button popovertarget="user-actions">
                    {% set user = cms.auth.userData %}
                    <img src="{{ cms.media.imagePath(user.id, {w:96,h:96,fm:"jpg",fit:"crop-focalpoint"}, {collection: user.collection}) }}"
                        alt="Profile Image for {{ user.name }}" onerror="this.remove();"/>
                </button>
                <nav popover id="user-actions">
                    <ul>
                        <li class="theme-selector">
                            <label>{{ t('user.theme') }}</label>
                            <div class="theme-buttons" role="radiogroup" aria-label="{{ t('user.theme') }}">
                                <button type="button" data-theme="auto" aria-label="{{ t('user.theme_auto') }}" title="{{ t('user.theme_auto') }}">
                                    <span class="icon-auto"></span>
                                </button>
                                <button type="button" data-theme="light" aria-label="{{ t('user.theme_light') }}" title="{{ t('user.theme_light') }}">
                                    <span class="icon-sun"></span>
                                </button>
                                <button type="button" data-theme="dark" aria-label="{{ t('user.theme_dark') }}" title="{{ t('user.theme_dark') }}">
                                    <span class="icon-moon"></span>
                                </button>
                            </div>
                        </li>
                        <li class="profile"><a href="javascript:void(0)" style="cursor:default">{{ user.name }}</a></li>
                        <li class="edit"><a href="profile">{{ t('user.edit_profile') }}</a></li>
                        <li class="logout"><a href="{{cms.dashboard }}/logout">{{ t('user.logout') }}</a></li>
                    </ul>
                </nav>
                {% elseif cms.env == 'dev' %}
                {# Show default profile in dev mode for styling verification #}
                <button popovertarget="user-actions"></button>
                <nav popover id="user-actions">
                    <ul>
                        <li class="theme-selector">
                            <label>{{ t('user.theme') }}</label>
                            <div class="theme-buttons" role="radiogroup" aria-label="{{ t('user.theme') }}">
                                <button type="button" data-theme="auto" aria-label="{{ t('user.theme_auto') }}" title="{{ t('user.theme_auto') }}">
                                    <span class="icon-auto"></span>
                                </button>
                                <button type="button" data-theme="light" aria-label="{{ t('user.theme_light') }}" title="{{ t('user.theme_light') }}">
                                    <span class="icon-sun"></span>
                                </button>
                                <button type="button" data-theme="dark" aria-label="{{ t('user.theme_dark') }}" title="{{ t('user.theme_dark') }}">
                                    <span class="icon-moon"></span>
                                </button>
                            </div>
                        </li>
                        <li class="profile"><a href="javascript:void(0)" style="cursor:default">{{ t('user.dev_user') }}</a></li>
                        <li class="edit"><a href="profile">{{ t('user.edit_profile') }}</a></li>
                        <li class="logout"><a href="{{cms.dashboard }}/logout">{{ t('user.logout') }}</a></li>
                    </ul>
                </nav>
                {% endif %}
            </div>
        </aside>
        <section class="dash-content">

        	{% block dashcontent %}{% endblock %}

        </section>
    </div>

    {% endblock %}

	{% include 'admin/quick-nav-index.twig' %}
	<script>window.TCMS_TRANSLATIONS = {{ cms.locale.jsTranslations()|json_encode|raw }};</script>
	<script>window.TCMS_CONFIG = {
		confirmCountdown: {{ cms.config('dashboard', 'confirmCountdown')|json_encode|raw }}
	};</script>
	{{ cms.adminAssetsBody() }}

	{% block bodyBelow %}{% endblock %}
	{% if cms.edition.can('whitelabel_pro') %}
		{{ include('whitelabel/admin-body-below.twig', ignore_missing = true) }}
	{% endif %}
</body>
</html>
