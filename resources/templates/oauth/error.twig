{% extends "admin-layout.twig" %}

{% block title %}{{ t('oauth.error.title') }} - {{ cms.config('siteName') }}{% endblock %}

{% block content %}
<main class="login-layout admin-layout oauth-error">

	<section class="oauth-error__header">
		<h1>{{ t('oauth.error.title') }}</h1>
	</section>

	<div class="oauth-error__body">
		<p class="oauth-error__type"><code>{{ errorType }}</code></p>
		<p class="oauth-error__description">{{ errorDescription }}</p>
	</div>

	<div class="oauth-error__actions">
		<a href="{{ cms.dashboard }}" class="dash-button">
			{{ t('oauth.error.return', {site: cms.config('siteName')}) }}
		</a>
	</div>

</main>

<style>
.oauth-error {
	max-width: 480px;
	margin: 0 auto;
	text-align: center;
}

.oauth-error__header {
	margin-bottom: 1.5rem;
}

.oauth-error__header h1 {
	font-size: 1.5rem;
}

.oauth-error__body {
	padding: 1rem;
	background: oklch(var(--totalform-nearwhite));
	border: 1px solid oklch(var(--totalform-border-color));
	border-radius: var(--totalform-radius);
	margin-bottom: 1.5rem;
}

.oauth-error__type {
	margin: 0 0 0.5rem;
}

.oauth-error__type code {
	font-size: 0.9rem;
	color: oklch(var(--totalform-darkgray));
}

.oauth-error__description {
	margin: 0;
	font-size: 0.95rem;
}

.oauth-error__actions {
	display: flex;
	justify-content: center;
}
</style>
{% endblock %}
