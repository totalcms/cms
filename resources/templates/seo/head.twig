{#
	The `<head>` SEO block rendered by `cms.seo.*`.

	`parts` selects which slices are printed, so one template serves the whole
	block and the granular accessors (`cms.seo.title()`, `cms.seo.og()`, …).

	The Twig environment runs with autoescape OFF globally, so this template
	turns it on for its own body: every value below is a raw string from
	MetaPayload and MUST be escaped here. Two exceptions: `jsonld`, which
	JsonLdBuilder already encodes with JSON_HEX_TAG — escaping it would corrupt
	the JSON — and `meta.metaTags`, which is markup the operator wrote to be
	printed as is. Both go out with `|raw`.
#}
{% autoescape 'html' %}
{%- if 'title' in parts and meta.title != '' -%}
<title>{{ meta.title }}</title>
{% endif -%}
{%- if 'description' in parts and meta.description != '' -%}
<meta name="description" content="{{ meta.description }}">
{% endif -%}
{%- if 'robots' in parts and meta.robots != '' -%}
<meta name="robots" content="{{ meta.robots }}">
{% endif -%}
{#- A noindex page has no canonical to declare: pointing at itself while asking
    to be dropped from the index is a mixed signal. og:url below still prints —
    it is an identity, not an indexing instruction. -#}
{%- if 'canonical' in parts and meta.canonical != '' and not meta.noindex -%}
<link rel="canonical" href="{{ meta.canonical }}">
{% endif -%}
{#- The icon set, all off the Site SEO record. The SVG goes first so a browser
    that can use it does; the sizes let Android and Google pick theirs. -#}
{%- if 'icons' in parts and settings.hasIconSlice() -%}
{% if settings.iconSvg != '' -%}
<link rel="icon" href="{{ settings.iconSvg }}" type="image/svg+xml">
{% endif -%}
{% if settings.icon32 != '' -%}
<link rel="icon" href="{{ settings.icon32 }}" type="image/png" sizes="32x32">
<link rel="icon" href="{{ settings.icon192 }}" type="image/png" sizes="192x192">
<link rel="icon" href="{{ settings.icon512 }}" type="image/png" sizes="512x512">
{% endif -%}
{% if settings.touchIcon != '' -%}
<link rel="apple-touch-icon" href="{{ settings.touchIcon }}" sizes="180x180">
{% endif -%}
{#- Linked only when a Site Builder page owns /manifest.webmanifest. #}
{% if settings.manifest != '' -%}
<link rel="manifest" href="{{ settings.manifest }}">
{% endif -%}
{% if settings.themeColor != '' -%}
<meta name="theme-color" content="{{ settings.themeColor }}">
{% endif -%}
{% endif -%}
{%- if 'og' in parts and settings.emitSocial -%}
<meta property="og:type" content="{{ meta.ogType }}">
{% if meta.publishedTime != '' -%}
<meta property="article:published_time" content="{{ meta.publishedTime }}">
{% endif -%}
{% if meta.modifiedTime != '' -%}
<meta property="article:modified_time" content="{{ meta.modifiedTime }}">
{% endif -%}
<meta property="og:title" content="{{ meta.socialTitle }}">
{% if meta.description != '' -%}
<meta property="og:description" content="{{ meta.description }}">
{% endif -%}
{% if meta.canonical != '' -%}
<meta property="og:url" content="{{ meta.canonical }}">
{% endif -%}
{% if meta.siteName != '' -%}
<meta property="og:site_name" content="{{ meta.siteName }}">
{% endif -%}
{% if meta.ogImage != '' -%}
<meta property="og:image" content="{{ meta.ogImage }}">
{% endif -%}
{#- The alt describes whichever image won; an image with none simply omits it. #}
{% if meta.ogImageAlt != '' -%}
<meta property="og:image:alt" content="{{ meta.ogImageAlt }}">
{% endif -%}
{% endif -%}
{%- if 'twitter' in parts and settings.emitSocial -%}
<meta name="twitter:card" content="{{ meta.twitterCard }}">
{#- Twitter would fall back to the og: tags, but not every scraper does, so the
    title, description and image are declared explicitly as well. #}
<meta name="twitter:title" content="{{ meta.socialTitle }}">
{% if meta.description != '' -%}
<meta name="twitter:description" content="{{ meta.description }}">
{% endif -%}
{% if meta.ogImage != '' -%}
<meta name="twitter:image" content="{{ meta.ogImage }}">
{% endif -%}
{% if meta.twitterHandle != '' -%}
<meta name="twitter:site" content="{{ meta.twitterHandle }}">
{% endif -%}
{#- Twitter reads og:image, but not og:image:alt — the alt needs its own tag. #}
{% if meta.ogImageAlt != '' -%}
<meta name="twitter:image:alt" content="{{ meta.ogImageAlt }}">
{% endif -%}
{% endif -%}
{#- Meta Tags are the operator's own markup (a verification tag, a script),
    pasted to be printed as written — the one other value that is not escaped. #}
{%- if 'metaTags' in parts and meta.metaTags != '' -%}
{{ meta.metaTags|raw }}
{% endif -%}
{%- if 'jsonld' in parts -%}
{{ jsonld|raw }}
{% endif -%}
{% endautoescape %}
