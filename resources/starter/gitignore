# Regenerated by `composer install` and at runtime.
/vendor/
/cache/
/tmp/
/logs/
/frontend/node_modules/
composer.lock
.DS_Store

# tcms-data is tracked here, unlike the plain Total CMS skeleton: it holds
# this site's schemas, pages and content. What changes on every request, and
# the credentials each install creates for itself, stays out.
/tcms-data/.system/*
!/tcms-data/.system/settings.json
!/tcms-data/.system/extensions.json
!/tcms-data/.system/extension-settings/
!/tcms-data/.system/access-groups.json
!/tcms-data/.system/migrations.json
/tcms-data/**/.cache/

# Once a site built from this starter is live, the server owns its content.
# Add /tcms-data/ here if you deploy with `tcms push` rather than git.

# Agent skill is installed from the totalcms/cms package by `tcms skill:install`.
/.claude/skills/totalcms/
